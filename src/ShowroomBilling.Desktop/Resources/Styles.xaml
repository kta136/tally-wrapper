<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  Base text defaults — Inter with tabular nums  -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!--  ─── Buttons ───────────────────────────────────────────────  -->
    <Style x:Key="BtnBase" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="focusRing"
                                Margin="-3"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="5" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}" />

    <Style x:Key="BtnPrimary" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkInverseBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="focusRing"
                                Margin="-3"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="5" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusRing" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnGhost" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="BtnDanger" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ErrBrush}" />
    </Style>

    <Style x:Key="BtnSm" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
    </Style>

    <!--  Window chrome (titlebar) buttons: flat, no border, red hover on close  -->
    <Style x:Key="WinChromeBtn" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinChromeBtnClose" BasedOn="{StaticResource WinChromeBtn}" TargetType="{x:Type Button}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFE81123" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ─── Text + label ─────────────────────────────────────────────  -->
    <Style x:Key="TxtMuted" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    </Style>

    <Style x:Key="TxtSoft" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    </Style>

    <Style x:Key="TxtMono" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
    </Style>

    <Style x:Key="TxtLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <!--  Uppercase conversion is done in bindings/views where needed  -->
    </Style>

    <Style x:Key="TxtSectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    </Style>

    <Style x:Key="TxtPageTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!--  ─── Inputs ──────────────────────────────────────────────────  -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="ring"
                                Margin="-2"
                                BorderBrush="{StaticResource AccentRingBrush}"
                                BorderThickness="0"
                                CornerRadius="4" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="ring" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  PasswordBox mirrors TextBox look  -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid>
                        <Border x:Name="ring"
                                Margin="-2"
                                BorderBrush="{StaticResource AccentRingBrush}"
                                BorderThickness="0"
                                CornerRadius="4" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Background="Transparent" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="ring" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ─── ComboBox (default) ─────────────────────────────────────
          Match the TextBox chrome (28 px tall, 1 px BorderInputBrush,
          UI font, 8 px horizontal padding). The popup list and chevron
          stay Windows-default — the goal is to keep the field height
          and border identical to neighbouring TextBoxes so header rows
          read as a single consistent input row.  -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <!--  WPF's default ComboBox renders the selected item via a ContentPresenter
              whose TextBlock binds to SystemColors.WindowTextBrush rather than the
              control's Foreground. Push InkBrush down via TextElement.Foreground so
              the selected-item text matches surrounding TextBoxes (e.g. Payment "Cash"
              in the Invoice header reads in InkBrush, not the system grey).  -->
        <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ─── DatePicker (default) ───────────────────────────────────
          Same shape as ComboBox — fixed 28 px height + matching border.
          The trailing calendar button stays Windows-default but is
          constrained by the field height so it no longer towers above
          the surrounding TextBoxes.  -->
    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Height" Value="{StaticResource InputHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource InputHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ─── Keyboard hint (<kbd>) chip ─────────────────────────────  -->
    <Style x:Key="KbdHint" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ─── Keyboard hint (<kbd>) chip — translucent variant for primary buttons ─
          Used inside BtnPrimary / BtnDanger so the kbd badge integrates with the
          filled button background instead of sitting on it as a heavy light chip.
          Mirrors the design's `.btn.primary .kbd-inline` treatment (15% white bg,
          25% white border, white text).  -->
    <Style x:Key="KbdHintOnPrimary" TargetType="{x:Type Border}" BasedOn="{StaticResource KbdHint}">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
    </Style>

    <!--  ─── Status dots ─────────────────────────────────────────────  -->
    <Style x:Key="StatusDot" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{StaticResource InkDisabledBrush}" />
    </Style>

    <!--  ─── Chip (status badge) ─────────────────────────────────────  -->
    <Style x:Key="Chip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource NeutralChipBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ─── Panel / card ───────────────────────────────────────────  -->
    <Style x:Key="Panel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <!--  ─── Banner ─────────────────────────────────────────────────  -->
    <Style x:Key="BannerWarn" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="BannerErr" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!--  ─── Focus ring for any focus-visible control we can't template (attached via FocusVisual)  -->
    <Style x:Key="DefaultFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="4"
                               RadiusY="4"
                               SnapsToDevicePixels="True"
                               Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ─── Admin (shared by AdminUnlockDialog + Settings › Admin tab) ───  -->
    <Style x:Key="AdminFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="AdminSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="AdminBannerWarn" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="AdminBannerErr" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="AdminBannerInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="AdminSectionPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="StateChipLocked" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StateChipUnlocked" TargetType="Border" BasedOn="{StaticResource StateChipLocked}">
        <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
    </Style>

    <Style x:Key="AdminDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowBackground" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BgRowAltBrush}" />
        <Setter Property="RowHeight" Value="26" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUi}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="ColumnHeaderHeight" Value="26" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

</ResourceDictionary>
