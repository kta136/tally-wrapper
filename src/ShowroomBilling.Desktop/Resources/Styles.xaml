<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">

    <!--  Base text defaults: the Windows-native UI font (see UiFontFamily in DesignTokens.xaml).
          Tabular figures keep the decimals of a column of amounts in line.  -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeUi}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!--  ─── Keyboard hint (<kbd>) chip ───────────────────────────────
          On a button:      <Button Content="Retry Push" shell:Kbd.Hint="Ctrl+R" />
          Anywhere else:    <ContentControl Style="{StaticResource Kbd}" Content="F2" />
          KbdHint is the chip's box (18 px, bars and buttons); KbdLg is the 22 px one of the
          shortcut list; KbdOnPrimary is the translucent one for a filled button's own content.  -->
    <Style x:Key="KbdHint" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ResultTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KbdHintText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Kbd" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeXs}" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="Background" Value="{StaticResource ResultTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Style="{StaticResource KbdHint}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <TextBlock Style="{StaticResource KbdHintText}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The 22 px chip of the shortcut list.  -->
    <Style x:Key="KbdLg" BasedOn="{StaticResource Kbd}" TargetType="{x:Type ContentControl}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Style="{StaticResource KbdHint}"
                            Height="22"
                            MinWidth="22"
                            Padding="7,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <TextBlock Style="{StaticResource KbdHintText}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KbdOnPrimary" BasedOn="{StaticResource Kbd}" TargetType="{x:Type ContentControl}">
        <Setter Property="Foreground" Value="{StaticResource OnFilledInkBrush}" />
        <Setter Property="Background" Value="{StaticResource OnFilledChipBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OnFilledChipBorderBrush}" />
        <Style.Triggers>
            <!--  A disabled button loses its fill, so white on translucent white would vanish.  -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource BtnPrimaryDisabledInkBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ─── Buttons ───────────────────────────────────────────────
          One template for every button. A style changes how a button looks,
          including on hover, press and when disabled, by setting Background /
          BorderBrush / Foreground in its own triggers; the template only draws
          them and the focus ring. Do not set those three properties directly
          on a Button in a view: a local value beats the style's triggers.

          BtnBase is the secondary button (white, grey edge). BtnPrimary is the
          one filled action of a screen or dialog, BtnDanger the destructive one,
          BtnGhost the text-only one. Sizes: BtnSm 30 (toolbars), default 34,
          BtnLg 38 (bottom bar), BtnPrimaryLg 40 (Save bill).  -->
    <Style x:Key="BtnBase" TargetType="{x:Type Button}">
        <Style.Resources>
            <!--  Text inside a button takes the button's Foreground. Without this the
                  app-wide TextBlock style gives it InkBrush, so a primary button would
                  show dark text on the accent fill and a disabled one would not grey out.  -->
            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="{DynamicResource ButtonHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeUi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <!--  Focus: a white gap, then a 2 px indigo ring (box-shadow 0 0 0 2px #fff, 0 0 0 4px accent).  -->
                        <Border x:Name="focusOuter"
                                Margin="-4"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="10"
                                IsHitTestVisible="False" />
                        <Border x:Name="focusGap"
                                Margin="-2"
                                BorderBrush="{StaticResource BgPanelBrush}"
                                BorderThickness="0"
                                CornerRadius="8"
                                IsHitTestVisible="False" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusBtn}"
                                SnapsToDevicePixels="True">
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <!--  The same rule for the TextBlock made from a plain-text Content,
                                              which cannot see the style's resources.  -->
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <!--  shell:Kbd.Hint, shown after the label  -->
                                <Border x:Name="hint" Margin="8,0,0,0" Style="{StaticResource KbdHint}">
                                    <TextBlock x:Name="hintText"
                                               Style="{StaticResource KbdHintText}"
                                               Text="{Binding Path=(shell:Kbd.Hint), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusOuter" Property="BorderThickness" Value="2" />
                            <Setter TargetName="focusGap" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="shell:Kbd.Hint" Value="{x:Null}">
                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="shell:Kbd.Hint" Value="">
                            <Setter TargetName="hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!--  On a filled button the chip is translucent white.  -->
                        <Trigger Property="shell:Kbd.OnFilled" Value="True">
                            <Setter TargetName="hint" Property="Background" Value="{StaticResource OnFilledChipBrush}" />
                            <Setter TargetName="hint" Property="BorderBrush" Value="{StaticResource OnFilledChipBorderBrush}" />
                            <Setter TargetName="hintText" Property="Foreground" Value="{StaticResource OnFilledInkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="hint" Property="Background" Value="Transparent" />
                            <Setter TargetName="hint" Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                            <Setter TargetName="hintText" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                <Setter Property="Foreground" Value="{StaticResource BtnDisabledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}" />

    <Style x:Key="BtnPrimary" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkInverseBrush}" />
        <Setter Property="shell:Kbd.OnFilled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource NeutralChipBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NeutralChipBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BtnPrimaryDisabledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  The main action of a screen: Save bill.  -->
    <Style x:Key="BtnPrimaryLg" BasedOn="{StaticResource BtnPrimary}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--  Text only: no fill and no edge until the pointer is over it.  -->
    <Style x:Key="BtnGhost" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftPressedBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource BtnDisabledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  A white button with an indigo edge: the way into a mode, such as Edit.  -->
    <Style x:Key="BtnAccentOutline" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                <Setter Property="Foreground" Value="{StaticResource BtnDisabledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnDanger" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrTextBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ErrTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrTextBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource ErrPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrInkBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                <Setter Property="Foreground" Value="{StaticResource BtnDisabledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  A filled red button: the one that does the destructive thing, in a dialog that asks first.  -->
    <Style x:Key="BtnDangerFilled" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ErrTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrTextBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkInverseBrush}" />
        <Setter Property="shell:Kbd.OnFilled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ErrInkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ErrInkBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource NeutralChipBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NeutralChipBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BtnPrimaryDisabledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  30 px, for toolbars and table rows.  -->
    <Style x:Key="BtnSm" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!--  38 px, the bottom bar.  -->
    <Style x:Key="BtnLg" BasedOn="{StaticResource BtnBase}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!--  A square 28 px button that holds an icon glyph (the close of a dialog, the row delete).  -->
    <Style x:Key="BtnIcon" BasedOn="{StaticResource BtnGhost}" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Window chrome (titlebar) buttons: flat, no border, red hover on close  -->
    <Style x:Key="WinChromeBtn" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinChromeBtnClose" BasedOn="{StaticResource WinChromeBtn}" TargetType="{x:Type Button}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WindowCloseHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnFilledInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ─── Text ─────────────────────────────────────────────────────  -->
    <!--  Label above an input: sentence case, 12.5 px medium. Not upper case.  -->
    <Style x:Key="FieldLabel" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!--  Heading of a group of fields: semibold, one step above the labels under it.  -->
    <Style x:Key="TxtSectionTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
    </Style>

    <!--  Column heading of a table: 12.5 px semibold on the grey band.  -->
    <Style x:Key="TableHeaderText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  Hints, captions and the text of an empty state: 12.5 px, 5.4:1 on white.  -->
    <Style x:Key="TxtHint" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Section heading inside a screen: "Line items", 16 / 600.  -->
    <Style x:Key="TxtHeading" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!--  Cascadia Mono, for an identifier a person may have to read out or copy: a bill number,
          a path, a connection string.  -->
    <Style x:Key="TxtMono" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMono}" />
    </Style>

    <!--  ─── Inputs ──────────────────────────────────────────────────
          Rest: 1 px BorderInput. Hover: darker edge. Focus: 2 px indigo edge and a 3 px halo.
          Read-only is a grey well with no edge; disabled is greyer still.  -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource InputHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeUi}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.28" />
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="halo"
                                Margin="-3"
                                BorderBrush="{StaticResource AccentRingBrush}"
                                BorderThickness="0"
                                CornerRadius="7"
                                IsHitTestVisible="False" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Background="Transparent" />
                        </Border>
                        <!--  shell:FieldAdorn.Placeholder, shown while the box is empty  -->
                        <TextBlock x:Name="placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="2,0,2,0"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Path=(shell:FieldAdorn.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <!--  shell:FieldAdorn.Prefix, a mark at the left edge, such as the rupee sign  -->
                        <ContentPresenter Margin="10,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{Binding Path=(shell:FieldAdorn.Prefix), RelativeSource={RelativeSource TemplatedParent}}"
                                          IsHitTestVisible="False">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <!--  shell:FieldAdorn.Suffix, a unit at the right edge  -->
                        <ContentPresenter Margin="0,0,10,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Content="{Binding Path=(shell:FieldAdorn.Suffix), RelativeSource={RelativeSource TemplatedParent}}"
                                          IsHitTestVisible="False">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border x:Name="edge"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderInputHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="halo" Property="BorderThickness" Value="3" />
                            <Setter TargetName="edge" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  PasswordBox mirrors TextBox look  -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{DynamicResource InputHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeUi}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Grid>
                        <Border x:Name="halo"
                                Margin="-3"
                                BorderBrush="{StaticResource AccentRingBrush}"
                                BorderThickness="0"
                                CornerRadius="7"
                                IsHitTestVisible="False" />
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Background="Transparent" />
                        </Border>
                        <Border x:Name="edge"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Radius}"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderInputHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="halo" Property="BorderThickness" Value="3" />
                            <Setter TargetName="edge" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  An input that lives inside a table cell: no box until it has focus, and then a 2 px
          indigo edge drawn inside the cell so it never overlaps its neighbour. Align numbers
          to the right with TextAlignment on the box itself.  -->
    <Style x:Key="TableCellBox" TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="{DynamicResource CellPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeUi}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.28" />
        <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Background="Transparent" />
                        </Border>
                        <Border x:Name="edge"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BgPanelBrush}" />
                            <Setter TargetName="edge" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ─── Chip (status badge) ─────────────────────────────────────
          24 px, radius 4, 12.5 px semibold, sentence case. The bill-state chip with its icon is
          the StateChip control; this is the plain one for scope tags and counts.  -->
    <Style x:Key="Chip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource NeutralChipBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  A chip coloured by tone. Put the tone ("ok", "warn", "err", "info"; anything
          else is neutral) in Tag on the Border and on its TextBlock:
              <Border Style="{StaticResource ToneChip}" Tag="{Binding StateTone}">
                  <TextBlock Style="{StaticResource ToneChipText}" Tag="{Binding StateTone}" ... />
          The view model works the tone out, so no state names appear in XAML.  -->
    <Style x:Key="ToneChip" BasedOn="{StaticResource Chip}" TargetType="{x:Type Border}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="ok">
                <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="warn">
                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="err">
                <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="info">
                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="accent">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToneChipText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="ok">
                <Setter Property="Foreground" Value="{StaticResource OkInkBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="warn">
                <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="err">
                <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="info">
                <Setter Property="Foreground" Value="{StaticResource InfoInkBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="accent">
                <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ─── Panel / card ───────────────────────────────────────────  -->
    <Style x:Key="Panel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    </Style>

    <!--  ─── Overlay dialog panel ─────────────────────────────────────
          A dialog is a UserControl whose root Grid paints DialogScrimBrush and
          holds one Border with this style. See AdminUnlockDialog.  -->
    <Style x:Key="DialogPanel" BasedOn="{StaticResource Panel}" TargetType="{x:Type Border}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusDialog}" />
        <Setter Property="Effect" Value="{StaticResource DialogShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Dialog title: 17 / 600, with a 12.5 px context line under it.  -->
    <Style x:Key="TxtDialogTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDialogTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!--  ─── Banner (a full-width strip under the title bar) ──────────  -->
    <Style x:Key="BannerInfo" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <!--  ─── Inline banners (a bordered box inside a form or dialog) ───
          14 px side padding, 9 px above and below, radius 6, soft fill and its own edge colour;
          the text inside is the matching Ink brush, medium weight.  -->
    <Style x:Key="InlineBanner" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="AdminBannerWarn" BasedOn="{StaticResource InlineBanner}" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
    </Style>

    <Style x:Key="AdminBannerErr" BasedOn="{StaticResource InlineBanner}" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ErrBorderBrush}" />
    </Style>

    <Style x:Key="AdminBannerInfo" BasedOn="{StaticResource InlineBanner}" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
    </Style>

    <Style x:Key="AdminBannerOk" BasedOn="{StaticResource InlineBanner}" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OkBorderBrush}" />
    </Style>

</ResourceDictionary>
