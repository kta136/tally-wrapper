<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:ShowroomBilling.Desktop.Converters">

    <!--  Shared value converters. Kept in their own dictionary so the view
          smoke test can merge exactly what App.xaml merges.  -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:NavTabToBoolConverter x:Key="NavTabToBoolConverter" />
    <conv:DotToBrushConverter x:Key="DotToBrushConverter" />
    <conv:DialogVisibilityConverter x:Key="DialogVisConverter" />
    <conv:BillDateGroupHeaderConverter x:Key="BillDateGroupHeader" />
    <conv:GroupAmountSumConverter x:Key="GroupAmountSum" />
    <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    <conv:AddDoubleConverter x:Key="AddDouble" />
    <conv:StringEqualsToBoolConverter x:Key="StringEqualsBool" />
    <conv:MasterOptionLabelConverter x:Key="MasterLabel" />
    <conv:FreshnessToneConverter x:Key="FreshnessTone" />
    <conv:SentenceCaseConverter x:Key="SentenceCase" />
    <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsVis" />
    <conv:CountWordConverter x:Key="CountWord" />
    <conv:GroupedNumberConverter x:Key="GroupedNumber" />
    <conv:DotToStatusWordConverter x:Key="DotToStatusWord" />
    <conv:MasterTypeLabelConverter x:Key="MasterTypeLabel" />
    <conv:FreshnessLabelConverter x:Key="FreshnessLabel" />
    <conv:MastersOverallLabelConverter x:Key="MastersOverallLabel" />

</ResourceDictionary>
