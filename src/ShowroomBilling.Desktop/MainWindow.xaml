<Window x:Class="ShowroomBilling.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
        xmlns:views="clr-namespace:ShowroomBilling.Desktop.Views"
        xmlns:invoiceViews="clr-namespace:ShowroomBilling.Desktop.Views.Invoice"
        xmlns:billsViews="clr-namespace:ShowroomBilling.Desktop.Views.Bills"
        xmlns:printingViews="clr-namespace:ShowroomBilling.Desktop.Views.Printing"
        xmlns:settingsViews="clr-namespace:ShowroomBilling.Desktop.Views.Settings"
        xmlns:setupViews="clr-namespace:ShowroomBilling.Desktop.Views.Setup"
        xmlns:adminViews="clr-namespace:ShowroomBilling.Desktop.Views.Admin"
        xmlns:syntheticViews="clr-namespace:ShowroomBilling.Desktop.Views.SyntheticBatch"
        Title="Tally Wrapper"
        Height="720"
        Width="1280"
        MinHeight="600"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding SwitchTabCommand}">
            <KeyBinding.CommandParameter>
                <shell:NavTab>Invoice</shell:NavTab>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding SwitchTabCommand}">
            <KeyBinding.CommandParameter>
                <shell:NavTab>Bills</shell:NavTab>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding SwitchTabCommand}">
            <KeyBinding.CommandParameter>
                <shell:NavTab>Settings</shell:NavTab>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <!--
            Bare ` and ? are gated (OpenShortcutsKeyCommand / OpenAdminUnlockKeyCommand):
            they do nothing while a dialog is open or a text box has focus, so
            "?" and "`" can be typed and a pending prompt is never replaced.
        -->
        <KeyBinding Key="OemQuestion" Modifiers="Shift" Command="{Binding OpenShortcutsKeyCommand}" />
        <KeyBinding Key="OemTilde" Command="{Binding OpenAdminUnlockKeyCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddInvoiceRowCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewInvoiceBillCommand}" />
        <KeyBinding Key="Delete" Modifiers="Ctrl" Command="{Binding RemoveInvoiceRowCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveActiveCommand}" />
        <KeyBinding Key="F9" Command="{Binding PrintEstimateCommand}" />
    </Window.InputBindings>

    <!--
      MainWindow.xaml.cs supplies per-monitor maximize bounds through
      WM_GETMINMAXINFO so the custom chrome stays inside the current work area.
    -->
    <Grid>
        <Grid.Resources>
            <Style x:Key="DialogHost" TargetType="{x:Type shell:LazyViewHost}">
                <Setter Property="Grid.RowSpan" Value="4" />
                <Setter Property="Panel.ZIndex" Value="100" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0: top bar (brand, tabs, health, operator, window buttons)  -->
        <views:TopBarView Grid.Row="0" />

        <!--  Row 1: the one banner. Healthy shows none; a note can be dismissed, a problem cannot.  -->
        <views:BannerView Grid.Row="1" />

        <!--  Row 2: Screen region  -->
        <Grid Grid.Row="2">
            <shell:LazyViewHost ViewType="{x:Type views:LimitedModeView}"
                                Visibility="{Binding IsLimitedVisible, Converter={StaticResource BoolToVis}}" />
            <shell:LazyViewHost ViewType="{x:Type invoiceViews:InvoiceView}"
                                ContentDataContext="{Binding Invoice}"
                                Visibility="{Binding IsInvoiceVisible, Converter={StaticResource BoolToVis}}" />
            <shell:LazyViewHost ViewType="{x:Type billsViews:BillsView}"
                                ContentDataContext="{Binding Bills}"
                                Visibility="{Binding IsBillsVisible, Converter={StaticResource BoolToVis}}" />
            <shell:LazyViewHost ViewType="{x:Type settingsViews:SettingsView}"
                                ContentDataContext="{Binding Settings}"
                                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!--  Row 3: shortcuts of the open screen, company, fiscal year, workstation and time  -->
        <views:BottomBarView Grid.Row="3" />

        <!--  Dialog overlays: one is shown at a time, over every row  -->
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type views:ShortcutsDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.Shortcuts}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type views:SystemHealthDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.Health}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type billsViews:BillDetailsDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.BillDetails}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type printingViews:PrintPreviewDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.PrintPreview}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type adminViews:AdminUnlockDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.Admin}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type setupViews:SetupWizardDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.SetupWizard}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type syntheticViews:SyntheticBatchDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.SyntheticBatch}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type billsViews:ChangeNumberDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.ChangeNumber}}" />
        <shell:LazyViewHost Style="{StaticResource DialogHost}"
                            ViewType="{x:Type billsViews:ReasonPromptDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter={x:Static shell:ShellDialogs.ReasonPrompt}}" />
        <!--  Confirm sits above the other dialogs: a question asked from inside one must not replace it.  -->
        <shell:LazyViewHost Grid.RowSpan="4"
                            Panel.ZIndex="200"
                            ViewType="{x:Type views:ConfirmDialog}"
                            Visibility="{Binding ConfirmDialog.IsOpen, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
