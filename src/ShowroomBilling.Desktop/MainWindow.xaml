<Window x:Class="ShowroomBilling.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
        xmlns:views="clr-namespace:ShowroomBilling.Desktop.Views"
        xmlns:invoiceViews="clr-namespace:ShowroomBilling.Desktop.Views.Invoice"
        xmlns:billsViews="clr-namespace:ShowroomBilling.Desktop.Views.Bills"
        xmlns:printingViews="clr-namespace:ShowroomBilling.Desktop.Views.Printing"
        xmlns:settingsViews="clr-namespace:ShowroomBilling.Desktop.Views.Settings"
        xmlns:setupViews="clr-namespace:ShowroomBilling.Desktop.Views.Setup"
        xmlns:adminViews="clr-namespace:ShowroomBilling.Desktop.Views.Admin"
        xmlns:syntheticViews="clr-namespace:ShowroomBilling.Desktop.Views.SyntheticBatch"
        mc:Ignorable="d"
        Title="Tally Wrapper"
        Height="720"
        Width="1180"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding SwitchTabCommand}">
            <KeyBinding.CommandParameter>
                <shell:NavTab>Invoice</shell:NavTab>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding SwitchTabCommand}">
            <KeyBinding.CommandParameter>
                <shell:NavTab>Bills</shell:NavTab>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding SwitchTabCommand}">
            <KeyBinding.CommandParameter>
                <shell:NavTab>Settings</shell:NavTab>
            </KeyBinding.CommandParameter>
        </KeyBinding>
        <KeyBinding Key="OemQuestion" Modifiers="Shift" Command="{Binding OpenShortcutsCommand}" />
        <KeyBinding Key="OemTilde" Command="{Binding OpenAdminUnlockCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDialogCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding Invoice.AddRowCommand}" />
        <KeyBinding Key="Delete" Modifiers="Ctrl" Command="{Binding Invoice.RemoveFocusedRowCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Invoice.SaveDraftCommand}" />
        <KeyBinding Key="F9" Command="{Binding OpenInvoicePreviewCommand}" />
    </Window.InputBindings>

    <!--
      Root grid is wrapped in an outer Border so we can apply a maximize-state
      margin without disturbing the inner row layout. With WindowStyle=None +
      WindowChrome, Windows positions a maximized window so each edge sits
      ~SystemParameters.WindowResizeBorder px past the work-area, clipping the
      bottom status bar. MainWindow.xaml.cs flips RootChrome.Padding on
      WindowState changes to compensate.
    -->
    <Border x:Name="RootChrome">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0: Title bar  -->
        <views:TitleBarView Grid.Row="0" DataContext="{Binding TitleBar}" />

        <!--  Row 1: banners  -->
        <Border Grid.Row="1"
                Style="{StaticResource BannerWarn}"
                Visibility="{Binding IsDegradedBannerVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource WarnInkBrush}"
                           Text="{Binding BannerText}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1"
                Style="{StaticResource BannerErr}"
                Visibility="{Binding IsLimitedBannerVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{StaticResource ErrBrush}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ErrInkBrush}"
                           Text="{Binding BannerText}" />
            </StackPanel>
        </Border>

        <!--  Row 2: NavBar  -->
        <views:NavBarView Grid.Row="2" />

        <!--  Row 3: Screen region  -->
        <Grid Grid.Row="3">
            <shell:LazyViewHost ViewType="{x:Type views:LimitedModeView}"
                                Visibility="{Binding IsLimitedVisible, Converter={StaticResource BoolToVis}}" />
            <shell:LazyViewHost ViewType="{x:Type invoiceViews:InvoiceView}"
                                ContentDataContext="{Binding Invoice}"
                                Visibility="{Binding IsInvoiceVisible, Converter={StaticResource BoolToVis}}" />
            <shell:LazyViewHost ViewType="{x:Type billsViews:BillsView}"
                                ContentDataContext="{Binding Bills}"
                                Visibility="{Binding IsBillsVisible, Converter={StaticResource BoolToVis}}" />
            <shell:LazyViewHost ViewType="{x:Type settingsViews:SettingsView}"
                                ContentDataContext="{Binding Settings}"
                                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!--  Row 4: F-key strip  -->
        <views:FKeyStripView Grid.Row="4" DataContext="{Binding FKeys}" />

        <!--  Row 5: Status bar  -->
        <views:StatusBarView Grid.Row="5" DataContext="{Binding StatusBar}" />

        <!--  Dialog overlays (span all rows)  -->
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type views:ShortcutsDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=shortcuts}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type views:SystemHealthDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=health}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type billsViews:BillDetailsDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=billDetails}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type printingViews:PrintPreviewDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=printPreview}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type adminViews:AdminUnlockDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=admin}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type setupViews:SetupWizardDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=setupWizard}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type syntheticViews:SyntheticBatchDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=syntheticBatch}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type billsViews:ChangeNumberDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=changeNumber}" />
        <shell:LazyViewHost Grid.RowSpan="6"
                            Panel.ZIndex="100"
                            ViewType="{x:Type billsViews:ReasonPromptDialog}"
                            Visibility="{Binding ActiveDialog, Converter={StaticResource DialogVisConverter}, ConverterParameter=reasonPrompt}" />
    </Grid>
    </Border>
</Window>
