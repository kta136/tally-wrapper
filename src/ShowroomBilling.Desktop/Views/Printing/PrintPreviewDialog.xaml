<UserControl x:Class="ShowroomBilling.Desktop.Views.Printing.PrintPreviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Printing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrintPreviewViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <!--  A heading in the settings column.  -->
        <Style x:Key="PanelHeading" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <!--  The panel is as big as the operator last made it (DialogWidth, DialogHeight); the grip at the
          bottom right resizes it. The preview takes the room the settings column leaves.  -->
    <shell:DialogFrame BodyPadding="20,16"
                       BodyScroll="Disabled"
                       CloseCommand="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       DataContext="{Binding PrintPreview}"
                       PanelHeight="{Binding DialogHeight}"
                       PanelMinHeight="520"
                       PanelMinWidth="760"
                       PanelWidth="{Binding DialogWidth}"
                       Subtitle="{Binding SubtitleText}"
                       Title="Print preview">
        <shell:DialogFrame.HeaderChips>
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkMutedBrush}"
                       Text="{Binding InvoiceNumber, TargetNullValue='(pending)'}" />
        </shell:DialogFrame.HeaderChips>
        <shell:DialogFrame.FooterNote>
            <Button Command="{Binding SavePdfCommand}"
                    Content="Save as PDF"
                    shell:Kbd.Hint="Ctrl+Shift+S" />
        </shell:DialogFrame.FooterNote>
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkMutedBrush}"
                           Text="{Binding FooterText}"
                           TextTrimming="CharacterEllipsis" />
                <Button Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="Close"
                        shell:Kbd.Hint="Esc" />
                <Button x:Name="PrintButton"
                        Margin="10,0,0,0"
                        Command="{Binding PrintCommand}"
                        IsDefault="True"
                        shell:Kbd.Hint="Enter"
                        Style="{StaticResource BtnPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="14"
                                   Text="&#xE749;" />
                        <TextBlock VerticalAlignment="Center" Text="Print" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </shell:DialogFrame.Footer>
        <shell:DialogFrame.Overlay>
            <Thumb Width="16"
                   Height="16"
                   Margin="0,0,3,3"
                   Cursor="SizeNWSE"
                   DragDelta="OnResizeThumbDragDelta"
                   ToolTip="Resize preview">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="16" Height="16" Background="Transparent">
                            <Path Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"
                                  Stroke="{StaticResource InkSoftBrush}"
                                  StrokeThickness="1" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </shell:DialogFrame.Overlay>

        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="268" />
            </Grid.ColumnDefinitions>

            <!--  The preview: zoom controls and the page count above, the pages below  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Width="34"
                                Padding="0"
                                Command="{Binding ZoomOutCommand}"
                                ToolTip="Zoom out">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE738;" />
                        </Button>
                        <Button MinWidth="60"
                                Margin="8,0"
                                Command="{Binding ResetZoomCommand}"
                                Content="{Binding PreviewZoomDisplay}"
                                ToolTip="Reset zoom" />
                        <Button Width="34"
                                Padding="0"
                                Command="{Binding ZoomInCommand}"
                                ToolTip="Zoom in">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE710;" />
                        </Button>
                        <Button Margin="8,0,0,0"
                                Click="OnFitPageClick"
                                Content="Fit page"
                                ToolTip="Fit the whole page in the preview" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding PageCountText}" />
                </Grid>

                <Border x:Name="PreviewViewport"
                        Grid.Row="1"
                        Padding="12"
                        Background="{StaticResource BgHoverBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}">
                    <ListBox x:Name="PreviewList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding PreviewPages}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        Effect="{StaticResource PopupShadow}">
                                    <Border.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding DataContext.PreviewScale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        ScaleY="{Binding DataContext.PreviewScale, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </Border.LayoutTransform>
                                    <Image Source="{Binding}" Stretch="Uniform" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!--  Copies, printer and print settings  -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,2,0">
                    <TextBlock Style="{StaticResource PanelHeading}" Text="Copies" />
                    <StackPanel Margin="0,0,0,18">
                        <CheckBox Margin="0,0,0,10" Content="Original, for the customer" IsChecked="{Binding CopyOriginal}" />
                        <CheckBox Margin="0,0,0,10" Content="Duplicate, for the showroom" IsChecked="{Binding CopyDuplicate}" />
                        <CheckBox Content="Triplicate, for transport" IsChecked="{Binding CopyTriplicate}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="Printer" />
                    <ComboBox Margin="0,0,0,18"
                              ItemsSource="{Binding Printers}"
                              SelectedItem="{Binding SelectedPrinter}" />

                    <TextBlock Style="{StaticResource PanelHeading}" Text="Print settings" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Two-sided" />
                    <ComboBox Margin="0,0,0,12"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding HasSelectedPrinter}"
                              ItemsSource="{Binding DuplexOptions}"
                              SelectedValue="{Binding SelectedDuplexMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Value"
                              SelectionChanged="OnPrintSettingSelectionChanged"
                              Tag="Duplex" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Colour" />
                    <ComboBox Margin="0,0,0,12"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding HasSelectedPrinter}"
                              ItemsSource="{Binding ColorOptions}"
                              SelectedValue="{Binding SelectedColorMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Value"
                              SelectionChanged="OnPrintSettingSelectionChanged"
                              Tag="Color" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Collate" />
                    <ComboBox Margin="0,0,0,18"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding HasSelectedPrinter}"
                              ItemsSource="{Binding CollationOptions}"
                              SelectedValue="{Binding SelectedCollationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Value"
                              SelectionChanged="OnPrintSettingSelectionChanged"
                              Tag="Collation" />

                    <CheckBox Margin="0,0,0,16"
                              Content="Skip this preview after saving"
                              IsChecked="{Binding DirectPrintAfterSave}" />

                    <Border Padding="14,12"
                            Background="{StaticResource BgSunkenBrush}"
                            CornerRadius="{StaticResource RadiusLg}">
                        <TextBlock Foreground="{StaticResource InkMutedBrush}"
                                   shell:RichText.Markup="To send the bill to Tally, use **Push** in the Bills tab."
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </shell:DialogFrame>
</UserControl>
