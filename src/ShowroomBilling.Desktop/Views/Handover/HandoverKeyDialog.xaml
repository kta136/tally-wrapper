<UserControl x:Class="ShowroomBilling.Desktop.Views.Handover.HandoverKeyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <!--  Settings → Hand-over → Change…: paste this PC's hand-over key. It is drawn as dots and kept
          only once it is a key; anything else says so under the field.  -->
    <shell:DialogFrame CloseCommand="{Binding CancelKeyCommand}"
                       DataContext="{Binding Settings.Handover}"
                       HeaderGlyph="&#xE8D7;"
                       PanelWidth="520"
                       Subtitle="Kept on this PC only, for this Windows user."
                       Title="Hand-over key">
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding CancelKeyCommand}"
                        Content="Cancel"
                        shell:Kbd.Hint="Esc" />
                <Button Margin="10,0,0,0"
                        Command="{Binding SaveKeyCommand}"
                        Content="Save key"
                        shell:Kbd.Hint="Enter"
                        Style="{StaticResource BtnPrimary}" />
            </StackPanel>
        </shell:DialogFrame.Footer>

        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Key" />
            <PasswordBox shell:FocusOnShown.IsEnabled="True" shell:PasswordBinding.Password="{Binding NewKey}">
                <PasswordBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SaveKeyCommand}" />
                </PasswordBox.InputBindings>
            </PasswordBox>

            <Border Margin="0,12,0,0"
                    Style="{StaticResource AdminBannerErr}"
                    Visibility="{Binding HasKeyError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource ErrTextBrush}"
                               Text="&#xE783;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ErrInkBrush}"
                               Text="{Binding KeyError}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </shell:DialogFrame>
</UserControl>
