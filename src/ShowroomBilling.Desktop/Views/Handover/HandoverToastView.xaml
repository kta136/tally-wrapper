<UserControl x:Class="ShowroomBilling.Desktop.Views.Handover.HandoverToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             Width="440">
    <!--  The card a hand-over that went well leaves at the bottom right of the screen: the app, the
          title, a row per bill and Open Bills. ToastWindow shows it without taking the focus and
          fades it; a click anywhere on it opens Bills. Its data context is a HandoverToastViewModel.  -->
    <UserControl.Resources>
        <GridLength x:Key="ColInvoice">110</GridLength>
        <GridLength x:Key="ColTotal">96</GridLength>
        <GridLength x:Key="ColNote">132</GridLength>

        <Style x:Key="NoteChipText" BasedOn="{StaticResource ToneChipText}" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Tag" Value="muted">
                    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BgPanelBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusDialog}"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  The app, and the close button  -->
            <Grid Grid.Row="0" Margin="16,10,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="20"
                        Height="20"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeXs}"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkInverseBrush}"
                               Text="S" />
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSm}"
                           FontWeight="Medium"
                           Foreground="{StaticResource InkMutedBrush}"
                           Text="Tally Wrapper" />
                <Button Grid.Column="2"
                        AutomationProperties.Name="Close"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource BtnIcon}"
                        ToolTip="Close">
                    <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE711;" />
                </Button>
            </Grid>

            <!--  A tick and the title  -->
            <StackPanel Grid.Row="1"
                        Margin="16,2,16,10"
                        Orientation="Horizontal">
                <Border Width="28"
                        Height="28"
                        Background="{StaticResource OkSoftBrush}"
                        CornerRadius="14">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource OkInkBrush}"
                               Text="&#xE73E;" />
                </Border>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="SemiBold"
                           Text="{Binding Title}" />
            </StackPanel>

            <!--  A row per bill  -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0">
                <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="38"
                                    Padding="16,0"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColInvoice}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource ColTotal}" />
                                        <ColumnDefinition Width="{StaticResource ColNote}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding InvoiceNumber}"
                                               TextTrimming="CharacterEllipsis" />
                                    <shell:FillCell Grid.Column="1">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Party}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </shell:FillCell>
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding Amount}" />
                                    <Border Grid.Column="3"
                                            Height="22"
                                            Padding="8,0"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource ToneChip}"
                                            Tag="{Binding Tone}">
                                        <TextBlock Style="{StaticResource NoteChipText}"
                                                   Tag="{Binding Tone}"
                                                   Text="{Binding Note}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!--  The foot: where the bills are, and Open Bills  -->
            <Border Grid.Row="3"
                    Padding="16,10"
                    Background="{StaticResource BgSunkenBrush}"
                    CornerRadius="0,0,9,9">
                <Grid>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding FooterNote}" />
                    <Button HorizontalAlignment="Right"
                            Command="{Binding OpenBillsCommand}"
                            Content="Open Bills"
                            shell:Kbd.Hint="Ctrl+2"
                            Style="{StaticResource BtnSm}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
