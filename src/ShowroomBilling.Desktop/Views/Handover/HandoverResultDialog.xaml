<UserControl x:Class="ShowroomBilling.Desktop.Views.Handover.HandoverResultDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <!--  A hand-over that needs the operator: a row per bill with its result and, under it, why;
          Try again when the server could not be reached, Open Bills and Close. Everything it says is
          worked out in HandoverReports.  -->
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding Handover.Result.TryAgainCommand}" />
        <KeyBinding Key="D2"
                    Command="{Binding Handover.Result.OpenBillsCommand}"
                    Modifiers="Ctrl" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <GridLength x:Key="ColInvoice">110</GridLength>
        <GridLength x:Key="ColTotal">100</GridLength>
        <GridLength x:Key="ColResult">190</GridLength>

        <Style x:Key="HeadText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WhyText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WhyTone}" Value="err">
                    <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding WhyTone}" Value="warn">
                    <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InvoiceText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasInvoiceNumber}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <shell:DialogFrame CloseCommand="{Binding CloseCommand}"
                       DataContext="{Binding Handover.Result}"
                       HeaderGlyph="&#xE7BA;"
                       HeaderTone="warn"
                       PanelWidth="680"
                       Title="{Binding Title}">
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding TryAgainCommand}"
                        Content="Try again"
                        shell:FocusOnShown.IsEnabled="{Binding CanTryAgain}"
                        shell:Kbd.Hint="Enter"
                        Style="{StaticResource BtnPrimary}"
                        Visibility="{Binding CanTryAgain, Converter={StaticResource BoolToVis}}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding OpenBillsCommand}"
                        Content="Open Bills"
                        shell:Kbd.Hint="Ctrl+2"
                        Visibility="{Binding CanOpenBills, Converter={StaticResource BoolToVis}}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding CloseCommand}"
                        Content="Close"
                        shell:FocusOnShown.IsEnabled="{Binding FocusesClose}"
                        shell:Kbd.Hint="Esc" />
            </StackPanel>
        </shell:DialogFrame.Footer>

        <StackPanel>
            <!--  Why nothing in the hand-over was used, or that the server cannot be reached  -->
            <Border Margin="0"
                    Style="{StaticResource AdminBannerErr}"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource ErrTextBrush}"
                               Text="&#xE783;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{StaticResource ErrInkBrush}"
                               Text="{Binding Banner}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius}"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBanner}" Value="True">
                                <Setter Property="Margin" Value="0,14,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Height="30"
                            Padding="14,0"
                            Background="{StaticResource BgSunkenBrush}"
                            BorderBrush="{StaticResource BorderBrushTok}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ColInvoice}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource ColTotal}" />
                                <ColumnDefinition Width="{StaticResource ColResult}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource HeadText}" Text="Invoice" />
                            <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="Party" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource HeadText}"
                                       Text="Total" />
                            <TextBlock Grid.Column="3"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource HeadText}"
                                       Text="Result" />
                        </Grid>
                    </Border>

                    <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,0"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid Height="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ColInvoice}" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{StaticResource ColTotal}" />
                                                <ColumnDefinition Width="{StaticResource ColResult}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource InvoiceText}" Text="{Binding InvoiceNumber}" />
                                            <shell:FillCell Grid.Column="1">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding Party}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </shell:FillCell>
                                            <TextBlock Grid.Column="2"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Amount}" />
                                            <Border Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource ToneChip}"
                                                    Tag="{Binding Tone}">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Tone, Converter={StaticResource DotToBrushConverter}}" />
                                                    <TextBlock Style="{StaticResource ToneChipText}"
                                                               Tag="{Binding Tone}"
                                                               Text="{Binding Note}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Margin="110,-6,0,10"
                                                   Style="{StaticResource WhyText}"
                                                   Text="{Binding Why}"
                                                   Visibility="{Binding HasWhy, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </shell:DialogFrame>
</UserControl>
