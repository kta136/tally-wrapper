<UserControl x:Class="ShowroomBilling.Desktop.Views.SyntheticBatch.SyntheticBatchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Scrim  -->
    <Grid Background="{StaticResource DialogScrimBrush}" DataContext="{Binding SyntheticBatch}">
        <Border Style="{StaticResource DialogPanel}"
                Width="560"
                MaxHeight="700">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  dialog-head  -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Batch Data Scheduler"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       VerticalAlignment="Center"
                                       Text="V1-ported synthetic bill generator" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource BtnGhost}"
                                Width="28"
                                Height="24"
                                Padding="0"
                                ToolTip="Close (Esc)"
                                Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="✕" />
                    </Grid>
                </Border>

                <!--  dialog-body  -->
                <ScrollViewer Grid.Row="1" Padding="14,14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   FontSize="12"
                                   Text="Creates a cluster of pending bills whose content is realistic but whose audit timestamps are backfilled inside the selected time window. No Tally traffic. Requires admin unlock." />

                        <!--  Error banner  -->
                        <Border Style="{StaticResource AdminBannerErr}"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠"
                                           FontSize="13"
                                           Foreground="{StaticResource ErrBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrInkBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--  Generation bounds  -->
                        <Border Style="{StaticResource AdminSectionPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TxtSectionTitleSpaced}" Text="GENERATION BOUNDS" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="TOTAL TARGET AMOUNT (₹)" />
                                        <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFontFamily}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,3" Text="24KT RATE (₹/G)" />
                                        <TextBox Text="{Binding Rate24Kt, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFontFamily}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,3" Text="MIN ITEMS / BILL" />
                                        <TextBox Text="{Binding MinItemsPerBill, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFontFamily}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="MAX BILL AMOUNT (₹ ≤ 1,99,000)" />
                                        <TextBox Text="{Binding MaxBillAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFontFamily}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,3" Text="PAYMENT MODE" />
                                        <ComboBox ItemsSource="{Binding PaymentOptions}"
                                                  SelectedItem="{Binding PaymentMode}" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,3" Text="MAX ITEMS / BILL" />
                                        <TextBox Text="{Binding MaxItemsPerBill, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFontFamily}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Time window  -->
                        <Border Style="{StaticResource AdminSectionPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TxtSectionTitleSpaced}" Text="TIME WINDOW (LOCAL)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="START (YYYY-MM-DD HH:MM)" />
                                        <TextBox x:Name="StartAtBox"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 LostFocus="OnStartAtLostFocus" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="END (YYYY-MM-DD HH:MM)" />
                                        <TextBox x:Name="EndAtBox"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 LostFocus="OnEndAtLostFocus" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Karats  -->
                        <Border Style="{StaticResource AdminSectionPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource TxtSectionTitleSpaced}" Margin="0" Text="TALLY-MAPPED KARATS" />
                                    <StackPanel HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Visibility="{Binding HasKaratOptions, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource BtnSm}"
                                                Margin="0,0,6,0"
                                                Command="{Binding SelectAllKaratsCommand}"
                                                Content="Select all" />
                                        <Button Style="{StaticResource BtnSm}"
                                                Command="{Binding ClearAllKaratsCommand}"
                                                Content="Clear all" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding KaratOptions}" MaxHeight="140">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,2"
                                                      IsChecked="{Binding IsSelected}"
                                                      Content="{Binding Label}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  Validation banner  -->
                        <Border Style="{StaticResource AdminBannerWarn}"
                                Visibility="{Binding HasValidation, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource WarnBrush}" />
                                <TextBlock Text="{Binding ValidationMessage}"
                                           Foreground="{StaticResource WarnInkBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--  Runtime status  -->
                        <Border Style="{StaticResource AdminSectionPanel}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TxtSectionTitleSpaced}" Text="RUNTIME" />
                                <TextBlock FontSize="{DynamicResource FontSizeLabel}"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding StatusMessage, TargetNullValue='Ready.', FallbackValue='Ready.'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!--  dialog-foot  -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource BtnBase}"
                                Command="{Binding CancelCommand}"
                                Content="Cancel"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Content="Close" />
                            <Button Style="{StaticResource BtnPrimary}"
                                    MinWidth="140"
                                    Command="{Binding StartCommand}"
                                    Content="Start Schedule" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
