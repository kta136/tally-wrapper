<UserControl x:Class="ShowroomBilling.Desktop.Views.SyntheticBatch.SyntheticBatchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <UserControl.Resources>
        <Style x:Key="BatchCard" BasedOn="{StaticResource Panel}" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="20,16,20,18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="BatchCardTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!--  The 24K rate has no default, so an empty one is the field to look at: a red edge on a pink wash.  -->
        <Style x:Key="RateBox" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRateMissing}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrWashBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ErrTextBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Padding" Value="9,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--  Admin only. Everything the batch needs is on this page: how much, when, which karats, and how it is going.  -->
    <shell:DialogFrame BodyBackground="{StaticResource BgBrush}"
                       BodyPadding="20,16,20,6"
                       CloseCommand="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       DataContext="{Binding SyntheticBatch}"
                       HeaderChips="{StaticResource AdminOnlyChip}"
                       PanelWidth="780"
                       Subtitle="Synthetic bill generator, ported from V1"
                       Title="Batch data scheduler">
        <shell:DialogFrame.FooterNote>
            <Button Command="{Binding CancelCommand}"
                    Content="Cancel run"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
        </shell:DialogFrame.FooterNote>
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="Close"
                        shell:Kbd.Hint="Esc" />
                <Button MinWidth="130"
                        Margin="10,0,0,0"
                        Command="{Binding StartCommand}"
                        Content="Start schedule"
                        Style="{StaticResource BtnPrimary}" />
            </StackPanel>
        </shell:DialogFrame.Footer>

        <StackPanel>
            <TextBlock Margin="0,0,0,14"
                       Foreground="{StaticResource InkMutedBrush}"
                       shell:RichText.Markup="Creates a cluster of **pending** bills whose content is realistic and whose audit timestamps are backfilled inside the window below. Nothing is sent to Tally."
                       TextWrapping="Wrap" />

            <Border Margin="0,0,0,14"
                    Style="{StaticResource AdminBannerErr}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource ErrTextBrush}"
                               Text="&#xE783;" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource ErrInkBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  How much  -->
            <Border Style="{StaticResource BatchCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BatchCardTitle}" Text="How much to create" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Total target amount, ₹" />
                            <TextBox Margin="0,0,0,14" Text="{Binding TotalAmount, Converter={StaticResource GroupedNumber}}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="24K rate, ₹ per gram" />
                            <TextBox Margin="0,0,0,14"
                                     Style="{StaticResource RateBox}"
                                     Text="{Binding Rate24Kt, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fewest items per bill" />
                            <TextBox Text="{Binding MinItemsPerBill, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Largest single bill, ₹" />
                            <TextBox Margin="0,0,0,14"
                                     Padding="10,0,96,0"
                                     shell:FieldAdorn.Suffix="{Binding MaxBillLimitText}"
                                     Text="{Binding MaxBillAmount, Converter={StaticResource GroupedNumber}}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Payment" />
                            <ComboBox Margin="0,0,0,14"
                                      ItemsSource="{Binding PaymentOptions}"
                                      SelectedItem="{Binding PaymentMode}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Most items per bill" />
                            <TextBox Text="{Binding MaxItemsPerBill, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource TxtHint}"
                               Text="{Binding BillRangeNote, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  When  -->
            <Border Style="{StaticResource BatchCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BatchCardTitle}" Text="When the bills are dated" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Start, local time" />
                            <TextBox x:Name="StartAtBox"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="{DynamicResource FontSizeMono}"
                                     LostFocus="OnStartAtLostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="End, local time" />
                            <TextBox x:Name="EndAtBox"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="{DynamicResource FontSizeMono}"
                                     LostFocus="OnEndAtLostFocus" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Karats  -->
            <Border Style="{StaticResource BatchCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <TextBlock FontWeight="SemiBold" Text="Karats that can be used" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Visibility="{Binding HasKaratOptions, Converter={StaticResource BoolToVis}}">
                            <Button Command="{Binding SelectAllKaratsCommand}"
                                    Content="Select all"
                                    Style="{StaticResource BtnGhost}" />
                            <Button Command="{Binding ClearAllKaratsCommand}"
                                    Content="Clear all"
                                    Style="{StaticResource BtnGhost}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,0,0,12"
                               Style="{StaticResource TxtHint}"
                               Text="Only karats mapped to a Tally stock item." />
                    <ItemsControl ItemsSource="{Binding KaratOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected}"
                                              Style="{StaticResource ChipToggle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource TxtHint}"
                               Text="No karat has a Tally stock item yet. Map them in Settings, Masters."
                               Visibility="{Binding HasKaratOptions, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!--  What stops it from starting  -->
            <Border Margin="0,0,0,14"
                    Style="{StaticResource AdminBannerWarn}"
                    Visibility="{Binding HasValidation, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource WarnInkBrush}"
                               Text="&#xE7BA;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarnInkBrush}"
                               Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  How the run is going  -->
            <Border Style="{StaticResource BatchCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Progress" />
                        <Border Margin="10,0,0,0"
                                Style="{StaticResource ToneChip}"
                                Tag="{Binding RunTone}">
                            <TextBlock Style="{StaticResource ToneChipText}"
                                       Tag="{Binding RunTone}"
                                       Text="{Binding RunState}" />
                        </Border>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="{Binding IsRunning}"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource TxtHint}"
                               Text="{Binding StatusMessage, TargetNullValue='Ready.', FallbackValue='Ready.'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </shell:DialogFrame>
</UserControl>
