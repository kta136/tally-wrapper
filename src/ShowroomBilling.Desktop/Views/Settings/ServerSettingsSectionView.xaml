<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.ServerSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="760">
    <StackPanel>
        <TextBlock Margin="0,0,0,16"
                   Foreground="{StaticResource InkMutedBrush}"
                   Text="This workstation works against the Tally Wrapper server on the Tally PC. That server holds the database connection and talks to Tally; both are set from the tray on the server itself."
                   TextWrapping="Wrap" />

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Server address" />
                <TextBox FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="{DynamicResource FontSizeMono}"
                         Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="{StaticResource InkMutedBrush}"
                           Style="{StaticResource TxtHint}">
                    <Run Text="In use now:" />
                    <Run FontFamily="{StaticResource MonoFontFamily}"
                         Foreground="{StaticResource InkBrush}"
                         Text="{Binding CurrentServerAddress, Mode=OneWay}" />
                    <Run Text="· A change applies after Billing restarts." />
                </TextBlock>

                <WrapPanel>
                    <Button Margin="0,0,10,0" Command="{Binding TestCommand}" Content="Test server" />
                    <Button Margin="0,0,10,0" Command="{Binding FindCommand}" Content="Find server" />
                    <Button Command="{Binding SaveCommand}" Content="Save and restart Billing" Style="{StaticResource BtnPrimary}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AdminBannerInfo}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="16"
                           Foreground="{StaticResource InfoInkBrush}"
                           Text="&#xE73E;" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{StaticResource InfoInkBrush}"
                           Text="{Binding Status}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
