<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.InvoiceSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="820">
    <StackPanel>
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource CardTitle}" Text="Company on the invoice" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Company name" />
                        <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.PrintCompanyName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN" />
                        <TextBox Style="{StaticResource SettingsInput}"
                                 shell:FieldAdorn.Placeholder="22AAAAA0000A1Z5"
                                 Text="{Binding Draft.CompanyGstin, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Phone" />
                        <TextBox Margin="0"
                                 Style="{StaticResource SettingsInput}"
                                 shell:FieldAdorn.Placeholder="Shown under the address"
                                 Text="{Binding Draft.CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Address" />
                        <TextBox MinHeight="104"
                                 Style="{StaticResource SettingsInputMulti}"
                                 shell:FieldAdorn.Placeholder="Street, area, city and PIN code"
                                 Text="{Binding Draft.CompanyAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="State" />
                        <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.CompanyState, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Country" />
                        <TextBox Margin="0" Style="{StaticResource SettingsInput}" Text="{Binding Draft.CompanyCountry, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource CardTitle}" Text="Bank details" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Bank name" />
                        <TextBox Style="{StaticResource SettingsInput}"
                                 shell:FieldAdorn.Placeholder="Bank and branch"
                                 Text="{Binding Draft.BankName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Account number" />
                        <TextBox Margin="0"
                                 Style="{StaticResource SettingsInput}"
                                 shell:FieldAdorn.Placeholder="Account number"
                                 Text="{Binding Draft.BankAccount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="IFSC" />
                        <TextBox Style="{StaticResource SettingsInput}"
                                 shell:FieldAdorn.Placeholder="11 characters"
                                 Text="{Binding Draft.BankIfsc, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="UPI ID" />
                        <TextBox Margin="0"
                                 Style="{StaticResource SettingsInput}"
                                 shell:FieldAdorn.Placeholder="name@bank"
                                 Text="{Binding Draft.BankUpi, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Invoice numbering" />
                <TextBlock Margin="0,2,0,16" Style="{StaticResource CardHint}" Text="The server numbers each bill when it is saved: the prefix, the financial year, a running number, then the suffix." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Prefix" />
                        <TextBox Margin="0" Style="{StaticResource SettingsInput}" Text="{Binding Draft.InvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Suffix" />
                        <TextBox Margin="0" Style="{StaticResource SettingsInput}" Text="{Binding Draft.InvoiceSuffix, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Digits" ToolTip="Width of the zero-padded running number: 4 gives 0049, 5 gives 00049. From 1 to 10." />
                        <TextBox Margin="0"
                                 Style="{StaticResource SettingsInput}"
                                 ToolTip="Width of the zero-padded running number: 4 gives 0049, 5 gives 00049. From 1 to 10."
                                 Text="{Binding Draft.InvoicePadding, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,14" Style="{StaticResource CardTitle}" Text="Copies printed by default" />
                <CheckBox Content="Original, for the customer" IsChecked="{Binding Draft.CopyOriginalDefault}" Style="{StaticResource SettingsCheck}" />
                <CheckBox Content="Duplicate, for the showroom" IsChecked="{Binding Draft.CopyDuplicateDefault}" Style="{StaticResource SettingsCheck}" />
                <CheckBox Margin="0" Content="Triplicate, for transport" IsChecked="{Binding Draft.CopyTriplicateDefault}" Style="{StaticResource SettingsCheck}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource CardTitle}" Text="Type size and terms" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Print font size" />
                        <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.PrintFontSize, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Terms font size" />
                        <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.PrintTermsFontSize, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Terms and conditions" />
                <TextBox Margin="0" Style="{StaticResource SettingsInputMulti}" Text="{Binding Draft.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="2,0,0,0" Style="{StaticResource CardHint}" Text="The logo, watermark and signature, and where each sits on the page, are set under Print layout." />
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
