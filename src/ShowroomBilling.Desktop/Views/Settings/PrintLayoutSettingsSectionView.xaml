<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.PrintLayoutSettingsSectionView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrintLayoutViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LayoutField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>
            <Style x:Key="SectionRowContainer" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--  Move up, move down and pin: 28 px square buttons on a row of the sections list.  -->
            <Style x:Key="RowButton" BasedOn="{StaticResource BtnBase}" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="820">
    <StackPanel>

        <!--  Page  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="Page" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding ClearBottomPinCommand}" Content="Clear pin" />
                        <Button Margin="10,0,0,0" Command="{Binding ResetPageLayoutCommand}" Content="Reset defaults" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Margins, in cm" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource InkSoftBrush}" Text="Left" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding LeftMarginCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource InkSoftBrush}" Text="Right" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding RightMarginCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource InkSoftBrush}" Text="Top" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding TopMarginCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Foreground="{StaticResource InkSoftBrush}" Text="Bottom" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding BottomMarginCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Spacing density" />
                        <ComboBox ItemsSource="{Binding DensityOptions}" SelectedItem="{Binding PageDensity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Border thickness, pt" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding InvoiceBorderThicknessPt, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Invoice sections: order, spacing and whether each shows  -->
        <Border Margin="0,0,0,16" Style="{StaticResource Panel}">
            <StackPanel>
                <Grid Margin="20,18,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Invoice sections" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CardHint}" Text="Drag the handle, or use the arrows. Spacing is in mm." />
                </Grid>

                <Border Height="40" Padding="20,0" Background="{StaticResource BgSunkenBrush}" BorderBrush="{StaticResource BorderBrushTok}" BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TableHeaderText}" Text="Section" />
                        <TextBlock Grid.Column="2" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TableHeaderText}" Text="Before" />
                        <TextBlock Grid.Column="3" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TableHeaderText}" Text="After" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource TableHeaderText}" Text="Show" />
                    </Grid>
                </Border>

                <ListBox x:Name="SectionList"
                         AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         DragOver="SectionList_OnDragOver"
                         Drop="SectionList_OnDrop"
                         ItemContainerStyle="{StaticResource SectionRowContainer}"
                         ItemsSource="{Binding SectionLayouts}"
                         Padding="0"
                         PreviewMouseLeftButtonDown="SectionList_OnPreviewMouseLeftButtonDown"
                         PreviewMouseMove="SectionList_OnPreviewMouseMove">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PrintLayoutSectionRowViewModel}">
                            <Grid Height="46" Margin="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" MinWidth="110" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="{StaticResource InkDisabledBrush}"
                                           Text="⠿"
                                           ToolTip="Drag to move" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <Border Height="20"
                                            Margin="8,0,0,0"
                                            Padding="7,0"
                                            Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="4"
                                            Visibility="{Binding IsBottomPinned, Converter={StaticResource BoolToVis}}">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="{DynamicResource FontSizeXs}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentInkBrush}"
                                                   Text="Pinned" />
                                    </Border>
                                </StackPanel>
                                <TextBox Grid.Column="2"
                                         Margin="0,0,8,0"
                                         HorizontalContentAlignment="Right"
                                         TextAlignment="Right"
                                         Text="{Binding SpacingBeforeMm, UpdateSourceTrigger=LostFocus}" />
                                <TextBox Grid.Column="3"
                                         Margin="0,0,8,0"
                                         HorizontalContentAlignment="Right"
                                         TextAlignment="Right"
                                         Text="{Binding SpacingAfterMm, UpdateSourceTrigger=LostFocus}" />
                                <CheckBox Grid.Column="4"
                                          VerticalAlignment="Center"
                                          Content="Show"
                                          IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding CanHide, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding CanHide, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="13"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Text="&#xE72E;" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkSoftBrush}" Text="Required" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button AutomationProperties.Name="Move up"
                                            Command="{Binding DataContext.MoveSectionUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowButton}"
                                            ToolTip="Move up">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE74A;" />
                                    </Button>
                                    <Button AutomationProperties.Name="Move down"
                                            Command="{Binding DataContext.MoveSectionDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowButton}"
                                            ToolTip="Move down">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE74B;" />
                                    </Button>
                                    <Button AutomationProperties.Name="Pin from here"
                                            Command="{Binding DataContext.PinBottomFromHereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RowButton}"
                                            ToolTip="Pin this section and everything after it to the bottom of the page">
                                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE718;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!--  Logo  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="Logo" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding UploadLogoCommand}" Content="Browse…" />
                        <Button Margin="10,0,0,0" Command="{Binding DeleteLogoCommand}" Content="Delete" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Current file" />
                <Border Margin="0,0,0,16" Style="{StaticResource ReadOnlyBox}">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TxtMono}" Text="{Binding LogoFileName}" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Offset X, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding LogoOffsetXCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Offset Y, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding LogoOffsetYCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Width, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding LogoWidthCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Height, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding LogoHeightCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Watermark  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Watermark" />
                        <TextBlock Style="{StaticResource CardHint}" Text="Repeats behind the invoice on every page. Position and size use full-page A4 coordinates." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Command="{Binding UploadWatermarkCommand}" Content="Browse…" />
                        <Button Margin="10,0,0,0" Command="{Binding DeleteWatermarkCommand}" Content="Delete" Visibility="{Binding HasWatermark, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Current file" />
                <Border Margin="0,0,0,16" Style="{StaticResource ReadOnlyBox}">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TxtMono}" Text="{Binding WatermarkFileName}" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="X, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding WatermarkOffsetXCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Y, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding WatermarkOffsetYCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Width, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding WatermarkWidthCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Height, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding WatermarkHeightCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Opacity, %" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding WatermarkOpacityPercent, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Signature  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CardTitle}" Text="Signature" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding UploadSignatureCommand}" Content="Browse…" />
                        <Button Margin="10,0,0,0" Command="{Binding DeleteSignatureCommand}" Content="Delete" Visibility="{Binding HasSignature, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Current file" />
                <Border Margin="0,0,0,16" Style="{StaticResource ReadOnlyBox}">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TxtMono}" Text="{Binding SignatureFileName}" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Offset X, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding SignatureOffsetXCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Offset Y, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding SignatureOffsetYCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Width, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding SignatureWidthCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Height, cm" />
                        <TextBox Style="{StaticResource LayoutField}" Text="{Binding SignatureHeightCm, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Margin="2,0,0,0" Style="{StaticResource CardHint}" Text="{Binding StatusMessage}" />
        <TextBlock Margin="2,6,0,0" Style="{StaticResource CardHint}" Text="Images are capped at 2 MB. Uploading replaces the old file. Layout changes are shared across the showroom and apply to the live preview, printing and PDF export." />
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
