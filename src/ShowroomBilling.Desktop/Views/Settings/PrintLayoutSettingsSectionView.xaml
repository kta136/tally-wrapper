<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.PrintLayoutSettingsSectionView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrintLayoutViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,12,0">
                <TextBlock Text="Print Layout" Style="{StaticResource SectionHeader}" Margin="0" />
                <TextBlock Margin="12,10,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkMutedBrush}"
                           Text="Updated" />
                <TextBlock Margin="6,10,0,0"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkSoftBrush}"
                           Text="{Binding UpdatedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                        Command="{Binding LoadCommand}" Content="Refresh" />
                <Button Style="{StaticResource BtnPrimary}"
                        Command="{Binding SaveCommand}" Content="Save" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Margins (cm)" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="LEFT" />
                <TextBox Margin="0,0,0,8" Text="{Binding LeftMarginCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="RIGHT" />
                <TextBox Margin="0,0,0,8" Text="{Binding RightMarginCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="TOP" />
                <TextBox Margin="0,0,0,8" Text="{Binding TopMarginCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="BOTTOM" />
                <TextBox Margin="0,0,0,8" Text="{Binding BottomMarginCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="DENSITY" />
                <ComboBox ItemsSource="{Binding DensityOptions}"
                          SelectedItem="{Binding PageDensity, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="INVOICE BORDER (PT)" />
                <TextBox Text="{Binding InvoiceBorderThicknessPt, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                <Button Style="{StaticResource BtnSm}"
                        Margin="0,0,6,0"
                        Command="{Binding ClearBottomPinCommand}"
                        Content="Clear pin" />
                <Button Style="{StaticResource BtnSm}"
                        Command="{Binding ResetPageLayoutCommand}"
                        Content="Reset defaults" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Invoice sections"
                       Style="{StaticResource SectionHeader}"
                       Margin="0" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource InkMutedBrush}"
                       Text="Drag rows or use Move Up / Move Down" />
        </Grid>

        <ListBox x:Name="SectionList"
                 ItemsSource="{Binding SectionLayouts}"
                 AllowDrop="True"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 PreviewMouseLeftButtonDown="SectionList_OnPreviewMouseLeftButtonDown"
                 PreviewMouseMove="SectionList_OnPreviewMouseMove"
                 DragOver="SectionList_OnDragOver"
                 Drop="SectionList_OnDrop">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PrintLayoutSectionRowViewModel}">
                    <Border Style="{StaticResource ReadOnlyBox}" Padding="8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0"
                                       Grid.RowSpan="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       Text="↕" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <Border Height="18"
                                            Margin="7,0,0,0"
                                            Padding="5,0"
                                            CornerRadius="2"
                                            Background="{StaticResource AccentSoftBrush}"
                                            Visibility="{Binding IsBottomPinned, Converter={StaticResource BoolToVis}}">
                                        <TextBlock VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="PINNED" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Visibility="{Binding CanHide, Converter={StaticResource InverseBoolToVis}}"
                                           Text="MANDATORY" />
                                <CheckBox
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding CanHide}"
                                          IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                                          Content="Show" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="6,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabel}"
                                           Text="BEFORE" />
                                <TextBox Grid.Column="1"
                                         Margin="0,0,8,0"
                                         Text="{Binding SpacingBeforeMm, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabel}"
                                           Text="AFTER" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding SpacingAfterMm, UpdateSourceTrigger=LostFocus}" />
                                <Button Grid.Column="5"
                                        Style="{StaticResource BtnSm}"
                                        MinWidth="30"
                                        Margin="8,0,4,0"
                                        ToolTip="Move Up"
                                        AutomationProperties.Name="Move Up"
                                        Command="{Binding DataContext.MoveSectionUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="↑" />
                                <Button Grid.Column="6"
                                        Style="{StaticResource BtnSm}"
                                        MinWidth="30"
                                        Margin="0,0,4,0"
                                        ToolTip="Move Down"
                                        AutomationProperties.Name="Move Down"
                                        Command="{Binding DataContext.MoveSectionDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="↓" />
                                <Button Style="{StaticResource BtnSm}"
                                        Grid.Column="7"
                                        Command="{Binding DataContext.PinBottomFromHereCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="Pin from here" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Logo" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ReadOnlyBox}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT FILE" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Text="{Binding LogoFileName}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                        Command="{Binding UploadLogoCommand}" Content="Browse…" />
                <Button Style="{StaticResource BtnSm}"
                        Command="{Binding DeleteLogoCommand}"
                        Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"
                        Content="Delete" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET X (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding LogoOffsetXCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET Y (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding LogoOffsetYCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="WIDTH (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding LogoWidthCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="HEIGHT (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding LogoHeightCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Watermark" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ReadOnlyBox}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT FILE" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Text="{Binding WatermarkFileName}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                        Command="{Binding UploadWatermarkCommand}" Content="Browse…" />
                <Button Style="{StaticResource BtnSm}"
                        Command="{Binding DeleteWatermarkCommand}"
                        Visibility="{Binding HasWatermark, Converter={StaticResource BoolToVis}}"
                        Content="Delete" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="X (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding WatermarkOffsetXCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Y (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding WatermarkOffsetYCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="WIDTH (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding WatermarkWidthCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="HEIGHT (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding WatermarkHeightCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="8,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="OPACITY (%)" />
                <TextBox Margin="0,0,0,8" Text="{Binding WatermarkOpacityPercent, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>
        <TextBlock Margin="0,0,0,4"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource InkMutedBrush}"
                   Text="The watermark repeats behind invoice content on every physical page. Position and size use full-page A4 coordinates." />

        <TextBlock Text="Signature" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ReadOnlyBox}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT FILE" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Text="{Binding SignatureFileName}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                        Command="{Binding UploadSignatureCommand}" Content="Browse…" />
                <Button Style="{StaticResource BtnSm}"
                        Command="{Binding DeleteSignatureCommand}"
                        Visibility="{Binding HasSignature, Converter={StaticResource BoolToVis}}"
                        Content="Delete" />
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET X (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding SignatureOffsetXCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET Y (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding SignatureOffsetYCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="WIDTH (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding SignatureWidthCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="HEIGHT (CM)" />
                <TextBox Margin="0,0,0,8" Text="{Binding SignatureHeightCm, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
        </Grid>

        <TextBlock Margin="0,6,0,0"
                   FontSize="11"
                   Foreground="{StaticResource InkMutedBrush}"
                   Text="{Binding StatusMessage}" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource InkMutedBrush}"
                   Text="Images are capped at 2 MB. Uploading replaces the old asset reference. Layout changes are shared across the showroom and applied to live preview, printing, and PDF export." />
    </StackPanel>
</UserControl>
