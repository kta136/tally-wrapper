<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             Background="{DynamicResource BgBrush}"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,8" />
        </Style>
        <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsReadOnly" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsInputMulti" TargetType="TextBox" BasedOn="{StaticResource SettingsInput}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="SettingsCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="TextSearch.TextPath" Value="Name" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MasterRowInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Margin" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="IsReadOnly" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MasterRowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Margin" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="IsEnabled" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="IsEnabled" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReadOnlyBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTok}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,1" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row 0: meta strip  -->
        <Border Grid.Row="0"
                Padding="14,8"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrushTok}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Source" Foreground="{DynamicResource InkMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SettingsSource}" />
                    <Border Margin="12,0,0,0"
                            Padding="8,2"
                            Background="{DynamicResource BgSunkenBrush}"
                            BorderBrush="{DynamicResource BorderBrushTok}"
                            BorderThickness="1"
                            CornerRadius="2"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Summary, TargetNullValue=''}" />
                    </Border>
                    <TextBlock Margin="12,0,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource InkMutedBrush}"
                               VerticalAlignment="Center"
                               Text="Updated" />
                    <TextBlock Margin="6,0,0,0"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource InkSoftBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding UpdatedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                    <Border Margin="12,0,0,0"
                            Padding="6,2"
                            Background="{DynamicResource WarnBrush}"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarnInkBrush}"
                                   Text="UNSAVED CHANGES" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource InkMutedBrush}"
                               Text="{Binding StatusMessage}" />
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding BeginEditCommand}"
                            Content="Edit"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding DiscardChangesCommand}"
                            Content="Discard"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource BtnPrimary}"
                            Command="{Binding SaveAllCommand}"
                            Content="Save All"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row 1: nav + detail + (optional) live preview  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushTok}"
                    BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="20,16,20,20">
                    <!--  Connection  -->
                    <StackPanel Visibility="{Binding IsConnectionVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TALLY HOST" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.Host, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TIMEOUT (SECONDS)" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PORT" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.Port, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ACTIVE COMPANY" />
                                <Border Style="{StaticResource ReadOnlyBox}">
                                    <TextBlock Text="{Binding ActiveCompanyName, TargetNullValue='—', FallbackValue='—'}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Connection · Active Company" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding Companies}"
                                      SelectedItem="{Binding SelectedCompany}"
                                      DisplayMemberPath="Name" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnSm}"
                                        Margin="0,0,6,0"
                                        Command="{Binding RequestCompanyRefreshCommand}"
                                        Content="Refresh from Tally" />
                                <Button Style="{StaticResource BtnPrimary}"
                                        Command="{Binding SetActiveCompanyCommand}"
                                        Content="Set Active" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Text="Cached" />
                            <TextBlock Margin="6,0,0,0"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkSoftBrush}"
                                       Text="{Binding CompaniesCount, StringFormat='{}{0} companies'}" />
                            <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Text="Freshness" />
                            <TextBlock Margin="6,0,0,0"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkSoftBrush}"
                                       Text="{Binding CompaniesFreshness}" />
                            <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Text="Fetched" />
                            <TextBlock Margin="6,0,0,0"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkSoftBrush}"
                                       Text="{Binding CompaniesFetchedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="The dropdown auto-populates from the cached cloud snapshot. Refresh from Tally re-pulls the list and updates the dropdown in one step. Set Active changes the active company via the dedicated settings endpoint (no Save needed)." />
                    </StackPanel>

                    <!--  Invoice  -->
                    <StackPanel Visibility="{Binding IsInvoiceVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Invoice · Company on Invoice" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="COMPANY NAME" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.PrintCompanyName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="GSTIN" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.CompanyGstin, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PHONE" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ADDRESS" />
                                <TextBox Style="{StaticResource SettingsInputMulti}" Text="{Binding Draft.CompanyAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="60" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="STATE" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.CompanyState, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="COUNTRY" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.CompanyCountry, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Invoice · Bank Details" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="BANK NAME" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.BankName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ACCOUNT" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.BankAccount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="IFSC" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.BankIfsc, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="UPI" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.BankUpi, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Invoice · Numbering" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PREFIX" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.InvoicePrefix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SUFFIX" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.InvoiceSuffix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PADDING" ToolTip="Width of zero-padded core (e.g. 4 → 0049, 5 → 00049). Range 1-10." />
                                <TextBox Style="{StaticResource SettingsInput}" ToolTip="Width of zero-padded core (e.g. 4 → 0049, 5 → 00049). Range 1-10." Text="{Binding Draft.InvoicePadding, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Invoice · Print Copies (defaults)" Style="{StaticResource SectionHeader}" />
                        <StackPanel>
                            <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding Draft.CopyOriginalDefault}" Content="Original (for customer)" />
                            <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding Draft.CopyDuplicateDefault}" Content="Duplicate (for showroom)" />
                            <CheckBox Style="{StaticResource SettingsCheck}" IsChecked="{Binding Draft.CopyTriplicateDefault}" Content="Triplicate (for transport)" />
                        </StackPanel>

                        <TextBlock Text="Invoice · Layout" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PRINT FONT SIZE" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.PrintFontSize, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TERMS FONT SIZE" />
                                <TextBox Style="{StaticResource SettingsInput}" Text="{Binding Draft.PrintTermsFontSize, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Invoice · Terms &amp; Conditions" Style="{StaticResource SectionHeader}" />
                        <TextBox Style="{StaticResource SettingsInputMulti}" Text="{Binding Draft.TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="Logo / signature upload and margin / placement editor live under the Print Layout section." />
                    </StackPanel>

                    <!--  Print Layout  -->
                    <StackPanel Visibility="{Binding DataContext.IsPrintLayoutVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                DataContext="{Binding PrintLayout}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,12,0">
                                <TextBlock Text="Print Layout" Style="{StaticResource SectionHeader}" Margin="0" />
                                <TextBlock Margin="12,10,0,0"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Text="Updated" />
                                <TextBlock Margin="6,10,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding UpdatedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                                        Command="{Binding LoadCommand}" Content="Refresh" />
                                <Button Style="{StaticResource BtnPrimary}"
                                        Command="{Binding SaveCommand}" Content="Save" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Margins (cm)" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="LEFT" />
                                <TextBox Margin="0,0,0,8" Text="{Binding LeftMarginCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RIGHT" />
                                <TextBox Margin="0,0,0,8" Text="{Binding RightMarginCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TOP" />
                                <TextBox Margin="0,0,0,8" Text="{Binding TopMarginCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="BOTTOM" />
                                <TextBox Margin="0,0,0,8" Text="{Binding BottomMarginCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Logo" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ReadOnlyBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT FILE" />
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Text="{Binding LogoFileName}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                                        Command="{Binding UploadLogoCommand}" Content="Browse…" />
                                <Button Style="{StaticResource BtnSm}"
                                        Command="{Binding DeleteLogoCommand}"
                                        Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}"
                                        Content="Delete" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET X (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding LogoOffsetXCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET Y (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding LogoOffsetYCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="WIDTH (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding LogoWidthCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="HEIGHT (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding LogoHeightCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Signature" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ReadOnlyBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT FILE" />
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Text="{Binding SignatureFileName}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0"
                                        Command="{Binding UploadSignatureCommand}" Content="Browse…" />
                                <Button Style="{StaticResource BtnSm}"
                                        Command="{Binding DeleteSignatureCommand}"
                                        Visibility="{Binding HasSignature, Converter={StaticResource BoolToVis}}"
                                        Content="Delete" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET X (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding SignatureOffsetXCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="OFFSET Y (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding SignatureOffsetYCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="WIDTH (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding SignatureWidthCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="HEIGHT (CM)" />
                                <TextBox Margin="0,0,0,8" Text="{Binding SignatureHeightCm, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="{Binding StatusMessage}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="Images are capped at 2 MB. Uploading replaces the old asset reference. Margins and placement are stored per showroom and applied by the print renderer." />
                    </StackPanel>

                    <!--  Ledgers  -->
                    <StackPanel Visibility="{Binding IsLedgersVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ledgers · Mappings" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Ledgers" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding LedgersCount, StringFormat='{}{0}'}" />
                                <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Voucher types" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding VoucherTypesCount, StringFormat='{}{0}'}" />
                                <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Freshness" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding LedgersFreshness}" />
                                <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Fetched" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding LedgersFetchedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnSm}"
                                        Command="{Binding RequestLedgerRefreshCommand}"
                                        Content="Refresh from Tally" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SALES LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.SalesLedger, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CASH LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.CashLedger, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CARD / UPI / NON-CASH LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.CreditDebitLedger, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SALES VOUCHER TYPE" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding VoucherTypeOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.SalesVoucherType, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CGST LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.CgstLedger, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SGST LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.SgstLedger, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="ROUND-OFF LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.RoundOffLedger, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="DISCOUNT LEDGER" />
                                <ComboBox Style="{StaticResource SettingsCombo}"
                                          ItemsSource="{Binding LedgerOptions}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding Draft.DiscountLedger, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="Cached ledger and voucher-type snapshots auto-populate from the cloud on load. Refresh from Tally re-pulls and updates the dropdowns in one step. Free-text entry still works if the snapshot is empty or stale." />
                    </StackPanel>

                    <!--  Masters  -->
                    <StackPanel Visibility="{Binding IsMastersVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Masters · Bill Items" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Rows" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding Draft.ItemMasterRows.Count}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnSm}"
                                        Margin="0,0,6,0"
                                        Command="{Binding RequestStockItemRefreshCommand}"
                                        Content="↻ Tally Items"
                                        ToolTip="Re-pull Tally stock items. Populates the dropdowns without leaving this tab." />
                                <Button Style="{StaticResource BtnSm}"
                                        Command="{Binding AddItemMasterRowCommand}"
                                        Content="Add Item"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="3"
                                MaxHeight="320">
                            <ListBox ItemsSource="{Binding Draft.ItemMasterRows}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Style="{StaticResource MasterRowInput}"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Name" />
                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource MasterRowCombo}"
                                                          IsEditable="False"
                                                          ItemsSource="{Binding DataContext.ItemUnitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Unit}" />
                                                <ComboBox Grid.Column="2"
                                                          Style="{StaticResource MasterRowCombo}"
                                                          IsEditable="False"
                                                          ItemsSource="{Binding DataContext.ItemCategoryOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding ItemCategory}" />
                                                <ComboBox Grid.Column="3"
                                                          Style="{StaticResource MasterRowCombo}"
                                                          IsEditable="False"
                                                          ItemsSource="{Binding DataContext.PricingModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding PricingMode}" />
                                                <TextBox Grid.Column="4"
                                                         Style="{StaticResource MasterRowInput}"
                                                         Text="{Binding WastagePercent, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Wastage %" />
                                                <TextBox Grid.Column="5"
                                                         Style="{StaticResource MasterRowInput}"
                                                         Text="{Binding DefaultLabourPerGram, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Labour / gram" />
                                                <ComboBox Grid.Column="6"
                                                          Style="{StaticResource MasterRowCombo}"
                                                          IsEditable="True"
                                                          DisplayMemberPath="Name"
                                                          TextSearch.TextPath="Name"
                                                          ItemsSource="{Binding DataContext.StockItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Text="{Binding DefaultStockMappingLabel, UpdateSourceTrigger=LostFocus}" />
                                                <Button Grid.Column="7" Margin="2"
                                                        Style="{StaticResource BtnSm}"
                                                        Content="×"
                                                        ToolTip="Remove row"
                                                        Command="{Binding DataContext.RemoveItemMasterRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                        </Border>
                        <Grid Margin="10,4,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="NAME" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="UNIT" />
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="CATEGORY" />
                            <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="PRICING MODE" />
                            <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="WASTAGE %" />
                            <TextBlock Grid.Column="5" Style="{StaticResource FieldLabel}" Text="LAB/GM" />
                            <TextBlock Grid.Column="6" Style="{StaticResource FieldLabel}" Text="STOCK MAPPING LABEL" />
                        </Grid>

                        <TextBlock Text="Masters · Karats" Style="{StaticResource SectionHeader}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Rows" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding Draft.KaratRows.Count}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnSm}"
                                        Margin="0,0,6,0"
                                        Command="{Binding RequestStockItemRefreshCommand}"
                                        Content="↻ Tally Items"
                                        ToolTip="Re-pull Tally stock items. Populates the dropdowns without leaving this tab." />
                                <Button Style="{StaticResource BtnSm}"
                                        Command="{Binding AddKaratRowCommand}"
                                        Content="Add Karat"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="3"
                                MaxHeight="240">
                            <ListBox ItemsSource="{Binding Draft.KaratRows}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="32" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         Style="{StaticResource MasterRowInput}"
                                                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Karat label (e.g. 22kt)" />
                                                <TextBox Grid.Column="1"
                                                         Style="{StaticResource MasterRowInput}"
                                                         Text="{Binding PurityPercent, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Purity %" />
                                                <ComboBox Grid.Column="2"
                                                          Style="{StaticResource MasterRowCombo}"
                                                          IsEditable="True"
                                                          DisplayMemberPath="Name"
                                                          TextSearch.TextPath="Name"
                                                          ItemsSource="{Binding DataContext.StockItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Text="{Binding TallyItem, UpdateSourceTrigger=LostFocus}" />
                                                <Button Grid.Column="3" Margin="2"
                                                        Style="{StaticResource BtnSm}"
                                                        Content="×"
                                                        ToolTip="Remove row"
                                                        Command="{Binding DataContext.RemoveKaratRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                        </Border>
                        <Grid Margin="10,4,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="LABEL" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabel}" Text="PURITY %" />
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="TALLY STOCK ITEM" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="Bill Items describe what lines in the invoice look like (weight-based gold / diamond, pricing mode). Karats map a label + purity to a Tally stock item for posting. Karats draw from the cached Tally Stock Items list below." />

                        <TextBlock Text="Masters · Tally Stock Items" Style="{StaticResource SectionHeader}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,12,0">
                                <TextBlock FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Cached" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding StockItemsCount, StringFormat='{}{0} item(s)'}" />
                                <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Freshness" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding StockItemsFreshness}" />
                                <TextBlock Margin="12,0,0,0" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" Text="Fetched" />
                                <TextBlock Margin="6,0,0,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSoftBrush}"
                                           Text="{Binding StockItemsFetchedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnSm}"
                                        Command="{Binding RequestStockItemRefreshCommand}"
                                        Content="Refresh from Tally" />
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="3"
                                MaxHeight="280">
                            <ListBox ItemsSource="{Binding StockItems}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Text="{Binding Karat, TargetNullValue='—'}" />
                                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Text="{Binding BaseUnit, TargetNullValue='—'}" />
                                                <TextBlock Grid.Column="3" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource InkSoftBrush}" Text="{Binding HsnCode, TargetNullValue='—'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                        </Border>
                    </StackPanel>

                    <!--  Database  -->
                    <StackPanel Visibility="{Binding IsDatabaseVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel.Resources>
                            <!--  Chip variants for Yes/No state  -->
                            <Style x:Key="DbStateCard" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTok}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
                                <Setter Property="Padding" Value="12,10" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="Database" Style="{StaticResource SectionHeader}" Margin="0,0,0,16" />
                        <TextBlock FontSize="12"
                                   LineHeight="19"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Margin="0,0,0,22"
                                   Text="PostgreSQL connection used by the local API. Saving writes a local machine override; restart the API or desktop app to apply it." />

                        <Border Margin="0,0,0,16"
                                Padding="10,8"
                                Background="{DynamicResource WarnSoftBrush}"
                                BorderBrush="{DynamicResource WarnBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}"
                                Visibility="{Binding CanBootstrapDatabaseWithoutAdmin, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarnInkBrush}"
                                       Text="{Binding DatabaseSetupModeText}" />
                        </Border>

                        <!--  Connection string editor  -->
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="Connection String" Margin="0,0,0,8" />
                        <TextBox Text="{Binding DatabaseConnectionString, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="64"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 FontFamily="{DynamicResource MonoFontFamily}"
                                 FontSize="11.5" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource BtnSm}" Command="{Binding LoadDatabaseConfigCommand}" Content="Load" Margin="0,0,6,0" />
                            <Button Style="{StaticResource BtnSm}" Command="{Binding TestDatabaseConnectionCommand}" Content="Test connection" Margin="0,0,6,0" />
                            <Button Style="{StaticResource BtnSm}" Command="{Binding SaveDatabaseConfigCommand}" Content="{Binding SaveDatabaseConfigButtonText}" Margin="0,0,6,0" />
                            <Rectangle Width="1" Margin="4,0" Fill="{DynamicResource DividerBrush}" />
                            <Button Style="{StaticResource BtnSm}" Command="{Binding RestartApiCommand}" Content="Restart API" Margin="6,0,0,0" />
                        </StackPanel>

                        <!--  Inline status strip — only renders when there's a message  -->
                        <Border Margin="0,14,0,0"
                                Padding="10,7"
                                Background="{DynamicResource InfoSoftBrush}"
                                BorderBrush="{DynamicResource InfoBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DatabaseConfigStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DatabaseConfigStatus}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource InfoBrush}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource InfoInkBrush}"
                                           Text="{Binding DatabaseConfigStatus}" />
                            </StackPanel>
                        </Border>

                        <!--  Current State  -->
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="Current State" Margin="0,24,0,10" />

                        <!--  Masked current value card  -->
                        <Border Style="{StaticResource DbStateCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="MASKED CURRENT VALUE" />
                                <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkBrush}"
                                           Text="{Binding DatabaseMaskedConnectionString}" />
                            </StackPanel>
                        </Border>

                        <!--  Local override file card  -->
                        <Border Style="{StaticResource DbStateCard}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,3" Text="LOCAL OVERRIDE FILE" />
                                <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding DatabaseConfigPath}" />
                            </StackPanel>
                        </Border>

                        <!--  Override + Restart side-by-side  -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Override present  -->
                            <Border Grid.Column="0" Style="{StaticResource DbStateCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="LOCAL OVERRIDE" />
                                    <StackPanel Orientation="Horizontal">
                                        <!--  Active (override file present)  -->
                                        <Border Padding="7,0"
                                                Height="18"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                Visibility="{Binding IsLocalDatabaseOverridePresent, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="ACTIVE"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!--  Not present  -->
                                        <Border Padding="7,0"
                                                Height="18"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource NeutralChipBrush}"
                                                Visibility="{Binding IsLocalDatabaseOverridePresent, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource InkDisabledBrush}" />
                                                <TextBlock Text="NONE"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  Restart required  -->
                            <Border Grid.Column="2" Style="{StaticResource DbStateCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="RESTART REQUIRED" />
                                    <StackPanel Orientation="Horizontal">
                                        <!--  Yes, restart pending  -->
                                        <Border Padding="7,0"
                                                Height="18"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource WarnSoftBrush}"
                                                Visibility="{Binding DatabaseConfigRequiresRestart, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource WarnBrush}" />
                                                <TextBlock Text="PENDING"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarnInkBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!--  No  -->
                                        <Border Padding="7,0"
                                                Height="18"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource OkSoftBrush}"
                                                Visibility="{Binding DatabaseConfigRequiresRestart, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}" />
                                                <TextBlock Text="IN SYNC"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OkInkBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--  Advanced — pure diagnostics. Admin-only actions moved to the Admin tab.  -->
                    <StackPanel Visibility="{Binding IsAdvancedVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" Margin="0,0,0,16" />

                        <!--  Logs & Diagnostics  -->
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="Logs &amp; Diagnostics" Margin="0,0,0,10" />

                        <Border Margin="0,0,0,8"
                                Padding="10,7"
                                Background="{DynamicResource BgSunkenBrush}"
                                BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="LOG FOLDER" />
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding LogFolderPath}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BtnSm}"
                                        Command="{Binding OpenLogFolderCommand}"
                                        Content="Open" />
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,8"
                                Padding="10,7"
                                Background="{DynamicResource BgSunkenBrush}"
                                BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="APP DATA FOLDER" />
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding AppDataFolderPath}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BtnSm}"
                                        Command="{Binding OpenAppDataFolderCommand}"
                                        Content="Open" />
                            </Grid>
                        </Border>

                        <Border Margin="0,0,0,6"
                                Padding="10,7"
                                Background="{DynamicResource BgSunkenBrush}"
                                BorderBrush="{DynamicResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="INSTALL FOLDER" />
                                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding InstallFolderPath}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BtnSm}"
                                        Command="{Binding OpenInstallFolderCommand}"
                                        Content="Open" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,4,0,22"
                                   FontSize="11"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   Text="Logs are best-effort local files. If the folder is empty, the current session may not have emitted file logs yet — use the Install folder for console-redirected output." />

                        <!--  Storage Scopes  -->
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="Storage Scopes" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Cloud-owned (accent)  -->
                            <Border Grid.Column="0"
                                    Padding="12,10"
                                    Background="{DynamicResource BgSunkenBrush}"
                                    BorderBrush="{DynamicResource BorderBrushTok}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="CLOUD-OWNED CATEGORIES" />
                                    <ItemsControl ItemsSource="{Binding CloudOwnedCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0"
                                                             Width="6"
                                                             Height="6"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource AccentBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!--  Local-only (neutral)  -->
                            <Border Grid.Column="2"
                                    Padding="12,10"
                                    Background="{DynamicResource BgSunkenBrush}"
                                    BorderBrush="{DynamicResource BorderBrushTok}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Text="LOCAL-ONLY CATEGORIES" />
                                    <ItemsControl ItemsSource="{Binding LocalOnlyCategories}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0"
                                                             Width="6"
                                                             Height="6"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource BorderStrongBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--
                        Admin section.
                        Visibility must bind against SettingsViewModel (the outer
                        DataContext) — the inner DataContext="{Binding AdminVm}"
                        on the same element would otherwise redirect the
                        IsAdminVisible lookup onto AdminUnlockViewModel, where
                        it doesn't exist, silently defaulting to Visible and
                        rendering on every tab.
                    -->
                    <StackPanel Visibility="{Binding DataContext.IsAdminVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                DataContext="{Binding AdminVm}">
                        <TextBlock Text="Admin" Style="{StaticResource SectionHeader}" Margin="0,0,0,16" />

                        <!--  Not-wired fallback (tests / design-time contexts)  -->
                        <Border Style="{StaticResource AdminBannerWarn}"
                                Visibility="{Binding DataContext.IsAdminVmWired, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource WarnInkBrush}"
                                       Text="Admin view-model is not wired — open Admin dialog via ~ (backtick) to unlock first." />
                        </Border>

                        <!--  Unlocked / locked status strip  -->
                        <Border Style="{StaticResource AdminBannerInfo}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource OkBrush}" />
                                    <TextBlock Text="{Binding SessionSummary}"
                                               Foreground="{DynamicResource OkInkBrush}"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource BtnBase}"
                                        Content="Lock session"
                                        Command="{Binding LockCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource AdminBannerErr}"
                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource ErrInkBrush}"
                                       TextWrapping="Wrap">
                                <Run Text="Admin is locked. Press " /><Run FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource ErrBrush}" Text="~" /><Run Text=" (backtick) to open the unlock dialog. Draft-lock force-release is disabled until unlocked." />
                            </TextBlock>
                        </Border>

                        <!--  Error / status inline (bound to AdminVm)  -->
                        <Border Style="{StaticResource AdminBannerErr}"
                                Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource ErrInkBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ErrorMessage}" />
                        </Border>
                        <Border Style="{StaticResource AdminBannerInfo}"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource InfoInkBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding StatusMessage}" />
                        </Border>

                        <!--  Set / change passcode  -->
                        <Border Style="{StaticResource AdminSectionPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource AdminSectionTitle}"
                                               Margin="0"
                                               Text="CHANGE PASSCODE"
                                               Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource AdminSectionTitle}"
                                               Margin="0"
                                               Text="SET PASSCODE"
                                               Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource InkSoftBrush}"
                                               Text="Min. 6 characters"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource AdminFieldLabel}" Text="CURRENT PASSCODE" />
                                    <PasswordBox x:Name="AdminCurrentPasscodeBox" PasswordChanged="AdminCurrentPasscodeBox_PasswordChanged" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource AdminFieldLabel}" Margin="0,8,0,3" Text="NEW PASSCODE" />
                                <PasswordBox x:Name="AdminNewPasscodeBox" PasswordChanged="AdminNewPasscodeBox_PasswordChanged" />
                                <TextBlock Style="{StaticResource AdminFieldLabel}" Margin="0,8,0,3" Text="CONFIRM NEW PASSCODE" />
                                <PasswordBox x:Name="AdminConfirmNewPasscodeBox" PasswordChanged="AdminConfirmNewPasscodeBox_PasswordChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource BtnPrimary}"
                                            MinWidth="120"
                                            Content="Save passcode"
                                            Command="{Binding SetOrChangePasscodeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Active draft locks (visible when unlocked)  -->
                        <Border Style="{StaticResource AdminSectionPanel}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource AdminSectionTitle}"
                                               Margin="0"
                                               Text="ACTIVE DRAFT LOCKS" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource BtnSm}"
                                            Content="Refresh"
                                            Command="{Binding RefreshLeasesCommand}" />
                                </Grid>

                                <DataGrid Style="{StaticResource AdminDataGrid}"
                                          ItemsSource="{Binding ActiveLeases}"
                                          SelectedItem="{Binding SelectedLease}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MaxHeight="220">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTok}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="Padding" Value="10,4" />
                                            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Bill" Binding="{Binding BillId}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Owner" Binding="{Binding OwnerActorId}" Width="130" />
                                        <DataGridTextColumn Header="Counter" Binding="{Binding OwnerCounterName}" Width="110" />
                                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAtUtc, StringFormat=\{0:HH:mm:ss\}}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Style="{StaticResource AdminFieldLabel}" Margin="0,10,0,3" Text="FORCE-RELEASE REASON (REQUIRED)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ForceReleaseReason, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource BtnDanger}"
                                            Content="Force release"
                                            Command="{Binding ForceReleaseSelectedLeaseCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            Batch Data Scheduler — admin-only; lives here now
                            (previously in Advanced). The inner DataContext is
                            AdminVm, so walk to Window to reach
                            MainWindowViewModel.OpenSyntheticBatchCommand.
                        -->
                        <Border Style="{StaticResource AdminSectionPanel}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AdminSectionTitle}" Margin="0,0,0,8" Text="BATCH DATA SCHEDULER" />
                                <TextBlock FontSize="12"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Margin="0,0,0,10">
                                    <Run Text="Generates a cluster of realistic " /><Run FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="pending" /><Run Text=" bills by partitioning a total target amount into bills of ₹25,000–₹1,99,000, scattered across a chosen time window. No Tally traffic; audit timestamps are backfilled." />
                                </TextBlock>
                                <Button HorizontalAlignment="Left"
                                        Style="{StaticResource BtnBase}"
                                        Command="{Binding DataContext.OpenSyntheticBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Content="Open Batch Data Scheduler…" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Thumb Grid.Column="2"
                   Width="6"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="OnPreviewResizeThumbDragDelta"
                   Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource DividerBrush}" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <!--  Live print preview (Invoice + Print Layout sections)  -->
            <Border Grid.Column="3"
                    Width="{Binding Preview.PaneWidth}"
                    MinWidth="320"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushTok}"
                    BorderThickness="1,0,0,0"
                    DataContext="{Binding Preview}"
                    Visibility="{Binding DataContext.IsPreviewVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,10,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Live preview" />
                            <TextBlock FontSize="10.5"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding PreviewSummary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource BtnGhost}"
                                    Width="28"
                                    Height="24"
                                    Padding="0"
                                    Command="{Binding ZoomOutCommand}"
                                    Content="-"
                                    ToolTip="Zoom out" />
                            <Button Style="{StaticResource BtnGhost}"
                                    MinWidth="48"
                                    Height="24"
                                    Margin="4,0"
                                    Padding="8,0"
                                    Command="{Binding ResetZoomCommand}"
                                    Content="{Binding PreviewZoomDisplay}"
                                    ToolTip="Reset zoom" />
                            <Button Style="{StaticResource BtnGhost}"
                                    Width="28"
                                    Height="24"
                                    Padding="0"
                                    Command="{Binding ZoomInCommand}"
                                    Content="+"
                                    ToolTip="Zoom in" />
                            <Button Style="{StaticResource BtnGhost}"
                                    MinWidth="36"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    Padding="8,0"
                                    Command="{Binding FitWidthCommand}"
                                    Content="Fit"
                                    ToolTip="Fit preview to pane width" />
                            <Button Style="{StaticResource BtnGhost}"
                                    Width="28"
                                    Height="24"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Command="{Binding RefreshCommand}"
                                    Content="R"
                                    ToolTip="Refresh preview" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="14,0,14,8"
                            Background="{DynamicResource BgSunkenBrush}"
                            BorderBrush="{DynamicResource BorderBrushTok}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PreviewPages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Background="White"
                                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16"
                                                                      Opacity="0.12"
                                                                      ShadowDepth="2"
                                                                      Color="#0F172A" />
                                                </Border.Effect>
                                                <Border.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding DataContext.PreviewScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    ScaleY="{Binding DataContext.PreviewScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                </Border.LayoutTransform>
                                                <Image Source="{Binding}"
                                                       Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Padding="14,12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BgPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushTok}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           Text="Preview will appear here" />
                            </Border>

                            <Border Padding="14,12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BgPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushTok}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ProgressBar Width="150"
                                                 Height="3"
                                                 IsIndeterminate="True" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Text="Rendering preview" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="14,0,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   Text="{Binding PreviewZoomDisplay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
