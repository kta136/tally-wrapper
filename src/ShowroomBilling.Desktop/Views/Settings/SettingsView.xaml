<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.SettingsView"
             x:Name="SettingsRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingsViews="clr-namespace:ShowroomBilling.Desktop.Views.Settings"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             Background="{StaticResource BgBrush}"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Row 0: meta strip  -->
        <Border Grid.Row="0"
                Padding="14,8"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Source" Foreground="{StaticResource InkMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SettingsSource}" />
                    <Border Margin="12,0,0,0"
                            Padding="8,2"
                            Background="{StaticResource BgSunkenBrush}"
                            BorderBrush="{StaticResource BorderBrushTok}"
                            BorderThickness="1"
                            CornerRadius="2"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Summary, TargetNullValue=''}" />
                    </Border>
                    <TextBlock Margin="12,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource InkMutedBrush}"
                               VerticalAlignment="Center"
                               Text="Updated" />
                    <TextBlock Margin="6,0,0,0"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource InkSoftBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding UpdatedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                    <Border Margin="12,0,0,0"
                            Padding="6,2"
                            Background="{StaticResource WarnBrush}"
                            CornerRadius="2"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarnInkBrush}"
                                   Text="UNSAVED CHANGES" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding StatusMessage}" />
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding BeginEditCommand}"
                            Content="Edit"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding DiscardChangesCommand}"
                            Content="Discard"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource BtnPrimary}"
                            Command="{Binding SaveAllCommand}"
                            Content="Save All"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row 1: nav + detail + (optional) live preview  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12.5" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="20,16,20,20">
                    <settingsViews:ConnectionSettingsSectionView Visibility="{Binding IsConnectionVisible, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:InvoiceSettingsSectionView Visibility="{Binding IsInvoiceVisible, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:PrintLayoutSettingsSectionView DataContext="{Binding PrintLayout}"
                                                                   Visibility="{Binding DataContext.IsPrintLayoutVisible, ElementName=SettingsRoot, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:LedgersSettingsSectionView Visibility="{Binding IsLedgersVisible, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:MastersSettingsSectionView Visibility="{Binding IsMastersVisible, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:DatabaseSettingsSectionView DataContext="{Binding Database}"
                                                               Visibility="{Binding DataContext.IsDatabaseVisible, ElementName=SettingsRoot, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:AdvancedSettingsSectionView Visibility="{Binding IsAdvancedVisible, Converter={StaticResource BoolToVis}}" />
                    <settingsViews:AdminSettingsSectionView Visibility="{Binding IsAdminVisible, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </ScrollViewer>

            <!--  Live print preview (Invoice + Print Layout sections)  -->
            <settingsViews:SettingsPreviewPaneView Grid.Column="2"
                                                   Grid.ColumnSpan="2"
                                                   DataContext="{Binding Preview}"
                                                   HostWidth="{Binding ActualWidth, ElementName=SettingsRoot}"
                                                   Visibility="{Binding DataContext.IsPreviewVisible, ElementName=SettingsRoot, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
