<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.AdminSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="760">
    <StackPanel DataContext="{Binding AdminVm}">

        <!--  Unlocked, or locked  -->
        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerOk}" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{StaticResource OkBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{StaticResource OkInkBrush}"
                               Text="{Binding SessionSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LockCommand}" Content="Lock session" />
            </Grid>
        </Border>

        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerErr}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource ErrInkBrush}" TextWrapping="Wrap">
                <Run Text="Admin is locked. Press " /><Run FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Text="~" /><Run Text=" (backtick) to open the unlock dialog." />
            </TextBlock>
        </Border>

        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerErr}" Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource ErrInkBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerInfo}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource InfoInkBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!--  Set or change the passcode  -->
        <Border Margin="0,0,0,16" Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Change passcode" Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Set passcode" Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkSoftBrush}"
                               Style="{StaticResource TxtHint}"
                               Text="At least 6 characters" />
                </Grid>
                <StackPanel HorizontalAlignment="Left" Width="420">
                    <StackPanel Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Current passcode" />
                        <PasswordBox Margin="0,0,0,14" shell:PasswordBinding.Password="{Binding CurrentPasscode}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="New passcode" />
                    <PasswordBox Margin="0,0,0,14" shell:PasswordBinding.Password="{Binding NewPasscode}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Confirm new passcode" />
                    <PasswordBox Margin="0,0,0,18" shell:PasswordBinding.Password="{Binding ConfirmNewPasscode}" />
                    <Button HorizontalAlignment="Left"
                            MinWidth="140"
                            Command="{Binding SetOrChangePasscodeCommand}"
                            Content="Save passcode"
                            Style="{StaticResource BtnPrimary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Batch data scheduler: admin-only. The inner DataContext is AdminVm, so the
            button reaches MainWindowViewModel.OpenSyntheticBatchCommand through the Window.
        -->
        <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Style="{StaticResource CardTitle}" Text="Batch data scheduler" />
                <TextBlock Margin="0,0,0,16" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap">
                    <Run Text="Makes " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="pending" /><Run Text=" bills that add up to a total you choose, each ₹50,000 to ₹1,99,000, dated between two times. Nothing is sent to Tally." />
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding DataContext.OpenSyntheticBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Open Batch data scheduler…" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="14"
                                   Foreground="{StaticResource WarnInkBrush}"
                                   Text="&#xE7BA;" />
                        <TextBlock Margin="8,0,0,0" FontWeight="Medium" Foreground="{StaticResource WarnInkBrush}" Text="Creates bills in the live database" />
                    </StackPanel>
                </StackPanel>

                <!--
                    Shop hours for a batch: shared settings with a Save of their own, edited by
                    SyntheticBatchViewModel.HoursEditor, which is reached through the Window like the button above.
                -->
                <Border Height="1" Margin="0,20,0,16" Background="{StaticResource DividerBrush}" />
                <StackPanel DataContext="{Binding DataContext.SyntheticBatch.HoursEditor, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Shop hours for a batch" />
                    <TextBlock Margin="0,0,0,14"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="A batch dates bills only inside these hours, and never on the closed day."
                               TextWrapping="Wrap" />
                    <StackPanel shell:InputLock.IsLocked="{Binding IsBusy}" Orientation="Horizontal">
                        <StackPanel Width="110" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Opens" />
                            <TextBox shell:FieldAdorn.Placeholder="hh:mm" Text="{Binding OpensText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Closes" />
                            <TextBox shell:FieldAdorn.Placeholder="hh:mm" Text="{Binding ClosesText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="210" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Closed on" />
                            <ComboBox DisplayMemberPath="Label"
                                      ItemsSource="{Binding ClosedDayOptions}"
                                      SelectedItem="{Binding ClosedDay}" />
                        </StackPanel>
                        <StackPanel Width="190">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Bills at least" />
                            <TextBox shell:FieldAdorn.Suffix="minutes apart" Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,16"
                               Style="{StaticResource TxtHint}"
                               Text="When the two times of a batch leave too little room, its bills are put closer together than this. Leave Opens and Closes empty to date bills at any time of day."
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button MinWidth="120"
                                Command="{Binding SaveCommand}"
                                Content="Save hours"
                                Style="{StaticResource BtnPrimary}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding ReadAgainCommand}"
                                Content="Read again"
                                Visibility="{Binding NeedsReading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock MaxWidth="520"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   Text="{Binding Notice}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource OkInkBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeTone}" Value="err">
                                            <Setter Property="Foreground" Value="{StaticResource ErrTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
