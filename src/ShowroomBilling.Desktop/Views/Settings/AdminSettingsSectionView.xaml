<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.AdminSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="760">
    <StackPanel DataContext="{Binding AdminVm}">

        <!--  Unlocked, or locked  -->
        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerOk}" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{StaticResource OkBrush}" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{StaticResource OkInkBrush}"
                               Text="{Binding SessionSummary}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LockCommand}" Content="Lock session" />
            </Grid>
        </Border>

        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerErr}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource ErrInkBrush}" TextWrapping="Wrap">
                <Run Text="Admin is locked. Press " /><Run FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" Text="~" /><Run Text=" (backtick) to open the unlock dialog." />
            </TextBlock>
        </Border>

        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerErr}" Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource ErrInkBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <Border Margin="0,0,0,16" Style="{StaticResource AdminBannerInfo}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="{StaticResource InfoInkBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!--  Set or change the passcode  -->
        <Border Margin="0,0,0,16" Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Change passcode" Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Set passcode" Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkSoftBrush}"
                               Style="{StaticResource TxtHint}"
                               Text="At least 6 characters" />
                </Grid>
                <StackPanel HorizontalAlignment="Left" Width="420">
                    <StackPanel Visibility="{Binding IsPasscodeConfigured, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Current passcode" />
                        <PasswordBox Margin="0,0,0,14" shell:PasswordBinding.Password="{Binding CurrentPasscode}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="New passcode" />
                    <PasswordBox Margin="0,0,0,14" shell:PasswordBinding.Password="{Binding NewPasscode}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Confirm new passcode" />
                    <PasswordBox Margin="0,0,0,18" shell:PasswordBinding.Password="{Binding ConfirmNewPasscode}" />
                    <Button HorizontalAlignment="Left"
                            MinWidth="140"
                            Command="{Binding SetOrChangePasscodeCommand}"
                            Content="Save passcode"
                            Style="{StaticResource BtnPrimary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!--
            Batch data scheduler: admin-only. The inner DataContext is AdminVm, so the
            button reaches MainWindowViewModel.OpenSyntheticBatchCommand through the Window.
        -->
        <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Style="{StaticResource CardTitle}" Text="Batch data scheduler" />
                <TextBlock Margin="0,0,0,16" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap">
                    <Run Text="Generates a cluster of realistic " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="pending" /><Run Text=" bills by splitting a total target amount into bills of ₹25,000 to ₹1,99,000, spread across a time window you choose. Nothing is sent to Tally, and the audit timestamps are backfilled." />
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding DataContext.OpenSyntheticBatchCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Open Batch data scheduler…" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="14"
                                   Foreground="{StaticResource WarnInkBrush}"
                                   Text="&#xE7BA;" />
                        <TextBlock Margin="8,0,0,0" FontWeight="Medium" Foreground="{StaticResource WarnInkBrush}" Text="Creates bills in the live database" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
