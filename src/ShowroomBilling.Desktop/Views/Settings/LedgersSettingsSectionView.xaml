<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.LedgersSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingsViews="clr-namespace:ShowroomBilling.Desktop.Views.Settings"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MasterDataSettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="820">
    <StackPanel>
        <!--  How much Tally told us, and when  -->
        <Border Padding="20,0" Style="{StaticResource Panel}" Margin="0,0,0,16" MinHeight="58">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding LedgersCount, Mode=OneWay}" /><Run Text=" ledgers" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding VoucherTypesCount, Mode=OneWay}" /><Run Text=" voucher types" />
                    </TextBlock>
                    <Border Margin="16,0,0,0" Style="{StaticResource ToneChip}" Tag="{Binding LedgersFreshness, Converter={StaticResource FreshnessTone}}">
                        <TextBlock Style="{StaticResource ToneChipText}"
                                   Tag="{Binding LedgersFreshness, Converter={StaticResource FreshnessTone}}"
                                   Text="{Binding LedgersFreshness, Converter={StaticResource SentenceCase}}" />
                    </Border>
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding LedgersFetchedAtUtc, Converter={StaticResource UtcToLocal}, StringFormat='Fetched {0:d MMM yyyy, HH:mm}', TargetNullValue='Not fetched yet'}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RequestLedgerRefreshCommand}" Content="Refresh from Tally" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource CardTitle}" Text="Sales" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <settingsViews:LedgerField Grid.Column="0" Label="Sales ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.SalesLedger, UpdateSourceTrigger=LostFocus}" />
                    <settingsViews:LedgerField Grid.Column="2"
                                               Label="Sales voucher type"
                                               MissingHint="Not in the Tally voucher-type list. Refresh from Tally, or check the spelling."
                                               Options="{Binding VoucherTypeOptions}"
                                               Text="{Binding Draft.SalesVoucherType, UpdateSourceTrigger=LostFocus}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource CardTitle}" Text="How the customer pays" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <settingsViews:LedgerField Grid.Column="0" Label="Cash ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.CashLedger, UpdateSourceTrigger=LostFocus}" />
                    <settingsViews:LedgerField Grid.Column="2" Label="Card, UPI and other non-cash ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.CreditDebitLedger, UpdateSourceTrigger=LostFocus}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource CardTitle}" Text="Tax and adjustments" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <settingsViews:LedgerField Grid.Row="0" Grid.Column="0" Label="CGST ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.CgstLedger, UpdateSourceTrigger=LostFocus}" />
                    <settingsViews:LedgerField Grid.Row="0" Grid.Column="2" Label="SGST ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.SgstLedger, UpdateSourceTrigger=LostFocus}" />
                    <settingsViews:LedgerField Grid.Row="1" Grid.Column="0" Label="Round-off ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.RoundOffLedger, UpdateSourceTrigger=LostFocus}" />
                    <settingsViews:LedgerField Grid.Row="1" Grid.Column="2" Label="Discount ledger" Options="{Binding LedgerOptions}" Text="{Binding Draft.DiscountLedger, UpdateSourceTrigger=LostFocus}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Margin="2,0,0,0" Style="{StaticResource CardHint}" Text="The lists come from the cached snapshot. Refresh from Tally pulls them again. Typing a name that is not in the list still works if the snapshot is empty or old." />
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
