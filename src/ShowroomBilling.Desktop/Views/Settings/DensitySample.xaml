<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.DensitySample"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Three rows of the line table at one density, so the choice shows what it does.  -->
    <UserControl.Resources>
        <Style x:Key="SampleRow" TargetType="Border">
            <Setter Property="Height" Value="{Binding SampleRowHeight, ElementName=Root}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="SampleText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{Binding SampleFontSize, ElementName=Root}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Border Style="{StaticResource SampleRow}">
            <Grid>
                <TextBlock FontWeight="Medium" Style="{StaticResource SampleText}" Text="22kt Gold Chain" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource SampleText}" Text="1,00,457.56" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SampleRow}">
            <Grid>
                <TextBlock FontWeight="Medium" Style="{StaticResource SampleText}" Text="22kt Lakshmi Pendant" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource SampleText}" Text="30,486.78" />
            </Grid>
        </Border>
        <Border BorderThickness="0" Height="{Binding SampleRowHeight, ElementName=Root}" Padding="14,0">
            <Grid>
                <TextBlock FontWeight="Medium" Style="{StaticResource SampleText}" Text="22kt Mangalsutra" />
                <TextBlock HorizontalAlignment="Right" Style="{StaticResource SampleText}" Text="1,25,261.34" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
