<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
                    xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings">
    <!--  The settings pages: a card per topic, a label above every field, and fields that read as plain
          grey wells until Edit is pressed. See docs/design/redesign/Settings-*.png.  -->

    <!--  A card: white, 8 px corners, 20 px padding, with a gap before the next one.  -->
    <Style x:Key="SettingsCard" BasedOn="{StaticResource Panel}" TargetType="Border">
        <Setter Property="Padding" Value="20,18,20,20" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="CardTitle" BasedOn="{StaticResource TxtHeading}" TargetType="TextBlock" />

    <Style x:Key="CardHint" BasedOn="{StaticResource TxtHint}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--  A value that is shown, not edited: a grey well with no edge, as a read-only text box draws it.  -->
    <Style x:Key="ReadOnlyBox" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!--  A text box of a settings form: a grey well until the form is in edit mode.  -->
    <Style x:Key="SettingsInput" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="IsReadOnly" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsInputMulti" BasedOn="{StaticResource SettingsInput}" TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="80" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!--  A list of a settings form. Out of edit mode it cannot be opened and reads as a grey well.  -->
    <Style x:Key="SettingsCombo" BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="IsTextSearchEnabled" Value="True" />
        <Setter Property="TextSearch.TextPath" Value="Name" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="shell:ComboExtras.ShowChevron" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}" />
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="shell:ComboExtras.ShowChevron" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  A box inside a row of a table on a settings page: plain text until the form is edited, and
          then a cell with the grey wash and the indigo edge.  -->
    <Style x:Key="MasterRowInput" BasedOn="{StaticResource TableCellBox}" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="Focusable" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MasterRowNumber" BasedOn="{StaticResource MasterRowInput}" TargetType="TextBox">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="MasterRowCombo" BasedOn="{StaticResource TableCellCombo}" TargetType="ComboBox">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Focusable" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsCheck" BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Focusable" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Sidebar: a heading over each group, and items 40 px high with an icon and a pale indigo
          rounded highlight on the open one. The admin item is amber, as the admin pill is green.  -->
    <Style x:Key="NavGroupHeading" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="Margin" Value="22,18,12,6" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="focusEdge"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                CornerRadius="6"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!--  The admin item is amber, as the admin pill in the top bar is green.  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Tag" Value="admin" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarnSoftBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="focusEdge" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Static vm:SettingsSectionKey.Admin}">
                <Setter Property="Tag" Value="admin" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
