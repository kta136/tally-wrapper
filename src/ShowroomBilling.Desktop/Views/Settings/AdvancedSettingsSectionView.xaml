<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.AdvancedSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" Margin="0,0,0,16" />

        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="Display" Margin="0,0,0,10" />
        <Border Margin="0,0,0,18"
                Padding="10,7"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="UI DENSITY" />
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource InkMutedBrush}"
                               TextWrapping="Wrap"
                               Text="Compact fits more billing rows; Comfortable increases touch targets and row height on this workstation." />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DensityOptions}"
                          SelectedItem="{Binding UiDensity, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!--  Logs & Diagnostics  -->
        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="Logs &amp; Diagnostics" Margin="0,0,0,10" />

        <Border Margin="0,0,0,8"
                Padding="10,7"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="LOG FOLDER" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding LogFolderPath}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BtnSm}"
                        Command="{Binding OpenLogFolderCommand}"
                        Content="Open" />
            </Grid>
        </Border>

        <Border Margin="0,0,0,8"
                Padding="10,7"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="APP DATA FOLDER" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding AppDataFolderPath}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BtnSm}"
                        Command="{Binding OpenAppDataFolderCommand}"
                        Content="Open" />
            </Grid>
        </Border>

        <Border Margin="0,0,0,6"
                Padding="10,7"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="INSTALL FOLDER" />
                    <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding InstallFolderPath}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BtnSm}"
                        Command="{Binding OpenInstallFolderCommand}"
                        Content="Open" />
            </Grid>
        </Border>

        <TextBlock Margin="0,4,0,22"
                   FontSize="11"
                   LineHeight="18"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource InkSoftBrush}"
                   Text="Logs are best-effort local files. If the folder is empty, the current session may not have emitted file logs yet — use the Install folder for console-redirected output." />

        <!--  Storage Scopes  -->
        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="Storage Scopes" Margin="0,0,0,10" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Cloud-owned (accent)  -->
            <Border Grid.Column="0"
                    Padding="12,10"
                    Background="{StaticResource BgSunkenBrush}"
                    BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="CLOUD-OWNED CATEGORIES" />
                    <ItemsControl ItemsSource="{Binding CloudOwnedCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Width="6"
                                             Height="6"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource AccentBrush}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Local-only (neutral)  -->
            <Border Grid.Column="2"
                    Padding="12,10"
                    Background="{StaticResource BgSunkenBrush}"
                    BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="LOCAL-ONLY CATEGORIES" />
                    <ItemsControl ItemsSource="{Binding LocalOnlyCategories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Width="6"
                                             Height="6"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource BorderStrongBrush}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
