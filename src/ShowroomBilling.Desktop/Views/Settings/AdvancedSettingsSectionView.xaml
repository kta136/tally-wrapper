<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.AdvancedSettingsSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingsViews="clr-namespace:ShowroomBilling.Desktop.Views.Settings"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  One of the three densities as a card: a radio, its name and what it means, and three sample rows.  -->
            <Style x:Key="DensityCard" TargetType="RadioButton">
                <Setter Property="GroupName" Value="UiDensity" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="halo"
                                        Margin="-3"
                                        BorderBrush="{StaticResource AccentRingBrush}"
                                        BorderThickness="0"
                                        CornerRadius="11"
                                        IsHitTestVisible="False" />
                                <Border x:Name="card"
                                        Background="{StaticResource BgPanelBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <DockPanel>
                                        <Border x:Name="head"
                                                Padding="16,14"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="0,0,0,1"
                                                DockPanel.Dock="Top"
                                                CornerRadius="7,7,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="radio"
                                                        Width="20"
                                                        Height="20"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource BgPanelBrush}"
                                                        BorderBrush="{StaticResource BorderInputBrush}"
                                                        BorderThickness="1.5"
                                                        CornerRadius="10" />
                                                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ContentPresenter Content="{TemplateBinding Tag}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="head" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="radio" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="radio" Property="BorderThickness" Value="6" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="halo" Property="BorderThickness" Value="3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FolderLabel" BasedOn="{StaticResource FieldLabel}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>
            <Style x:Key="FolderPath" BasedOn="{StaticResource TxtMono}" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <shell:ReadingColumn MaxContentWidth="860">
    <StackPanel>

        <!--  Display density  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Display density" />
                <TextBlock Margin="0,2,0,16" Style="{StaticResource CardHint}" Text="How much fits on screen. Applies to every table and form on this PC straight away." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0"
                                 IsChecked="{Binding UiDensity, Converter={StaticResource StringEqualsBool}, ConverterParameter=Compact}"
                                 Style="{StaticResource DensityCard}">
                        <RadioButton.Tag>
                            <settingsViews:DensitySample SampleFontSize="12.5" SampleRowHeight="32" />
                        </RadioButton.Tag>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Compact" />
                            <TextBlock Style="{StaticResource CardHint}" Text="32 px rows, 12.5 px text" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Column="2"
                                 IsChecked="{Binding UiDensity, Converter={StaticResource StringEqualsBool}, ConverterParameter=Standard}"
                                 Style="{StaticResource DensityCard}">
                        <RadioButton.Tag>
                            <settingsViews:DensitySample SampleFontSize="13.5" SampleRowHeight="38" />
                        </RadioButton.Tag>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Standard" />
                                <Border Height="18"
                                        Margin="8,0,0,0"
                                        Padding="7,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="4">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="{DynamicResource FontSizeXs}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OnFilledInkBrush}"
                                               Text="Default" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardHint}" Text="38 px rows, 13.5 px text" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Grid.Column="4"
                                 IsChecked="{Binding UiDensity, Converter={StaticResource StringEqualsBool}, ConverterParameter=Comfortable}"
                                 Style="{StaticResource DensityCard}">
                        <RadioButton.Tag>
                            <settingsViews:DensitySample SampleFontSize="14.5" SampleRowHeight="44" />
                        </RadioButton.Tag>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Comfortable" />
                            <TextBlock Style="{StaticResource CardHint}" Text="44 px rows, 14.5 px text, for touch" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Logs and folders  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource CardTitle}" Text="Logs and folders" />

                <Grid Margin="0,6,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FolderLabel}" Text="Log folder" />
                        <TextBlock Style="{StaticResource FolderPath}" Text="{Binding LogFolderPath}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenLogFolderCommand}" Content="Open" />
                </Grid>
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FolderLabel}" Text="App data folder" />
                        <TextBlock Style="{StaticResource FolderPath}" Text="{Binding AppDataFolderPath}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenAppDataFolderCommand}" Content="Open" />
                </Grid>
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />

                <Grid Margin="0,12,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FolderLabel}" Text="Install folder" />
                        <TextBlock Style="{StaticResource FolderPath}" Text="{Binding InstallFolderPath}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenInstallFolderCommand}" Content="Open" />
                </Grid>

                <TextBlock Style="{StaticResource CardHint}" Text="Logs are best-effort local files. If the folder is empty, this session may not have written any yet. The install folder holds console output." />
            </StackPanel>
        </Border>

        <!--  Where each kind of setting is stored  -->
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Where settings are stored" />
                <TextBlock Margin="0,2,0,16" Style="{StaticResource CardHint}" Text="Shared settings live on the server and are the same at every counter. This PC's settings stay here." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="16,14" Background="{StaticResource InfoSoftBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{StaticResource InfoInkBrush}" Text="Shared by every counter" />
                            <ItemsControl ItemsSource="{Binding CloudOwnedCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource InfoBrush}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InfoInkBrush}" Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16,14" Background="{StaticResource BgSunkenBrush}" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Foreground="{StaticResource InkMutedBrush}" Text="This PC only" />
                            <ItemsControl ItemsSource="{Binding LocalOnlyCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{StaticResource NeutralDotBrush}" />
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}" Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
    </shell:ReadingColumn>
</UserControl>
