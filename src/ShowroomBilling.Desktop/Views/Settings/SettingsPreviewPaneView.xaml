<UserControl x:Class="ShowroomBilling.Desktop.Views.Settings.SettingsPreviewPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsPreviewViewModel, IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Drag this edge to make the preview wider or narrower  -->
        <Thumb Grid.Column="0"
               Width="6"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Cursor="SizeWE"
               DragDelta="OnPreviewResizeThumbDragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrushTok}" BorderThickness="1,0,0,0" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Border Grid.Column="1"
                Width="{Binding PaneWidth}"
                MinWidth="360"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,16,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Live preview" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Style="{StaticResource TxtHint}"
                                   Text="{Binding PreviewSummary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Width="30"
                                Command="{Binding ZoomOutCommand}"
                                Padding="0"
                                Style="{StaticResource BtnSm}"
                                ToolTip="Zoom out">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE738;" />
                        </Button>
                        <Button MinWidth="52"
                                Margin="6,0"
                                Command="{Binding ResetZoomCommand}"
                                Content="{Binding PreviewZoomDisplay}"
                                Padding="8,0"
                                Style="{StaticResource BtnSm}"
                                ToolTip="Reset zoom" />
                        <Button Width="30"
                                Command="{Binding ZoomInCommand}"
                                Padding="0"
                                Style="{StaticResource BtnSm}"
                                ToolTip="Zoom in">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE710;" />
                        </Button>
                        <Button MinWidth="40"
                                Margin="6,0,0,0"
                                Command="{Binding FitWidthCommand}"
                                Content="Fit"
                                Padding="8,0"
                                Style="{StaticResource BtnSm}"
                                ToolTip="Fit the page to the width of the pane" />
                        <Button Width="30"
                                Margin="6,0,0,0"
                                Command="{Binding RefreshCommand}"
                                Padding="0"
                                Style="{StaticResource BtnSm}"
                                ToolTip="Refresh the preview">
                            <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE72C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  The pages, on a grey desk  -->
                <Border Grid.Row="1"
                        Margin="16,0,16,10"
                        Padding="8"
                        Background="{StaticResource BgHoverBrush}"
                        BorderBrush="{StaticResource BorderBrushTok}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PreviewPages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Background="{StaticResource BgPanelBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16"
                                                                  Opacity="0.14"
                                                                  ShadowDepth="2"
                                                                  Color="{StaticResource ShadowColor}" />
                                            </Border.Effect>
                                            <Border.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding DataContext.PreviewScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                ScaleY="{Binding DataContext.PreviewScale, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </Border.LayoutTransform>
                                            <Image Source="{Binding}" Stretch="Uniform" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Padding="18,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="{StaticResource InkMutedBrush}" Text="The preview appears here" />
                        </Border>

                        <Border Padding="18,14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderBrushTok}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <ProgressBar Width="150" IsIndeterminate="True" />
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Text="Drawing the preview" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="16,0,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource OkBrush}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Text="{Binding StatusMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource InkSoftBrush}"
                               Text="{Binding PreviewZoomDisplay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
