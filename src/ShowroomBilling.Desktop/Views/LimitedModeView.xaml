<UserControl x:Class="ShowroomBilling.Desktop.Views.LimitedModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="BulletRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
        <StackPanel MaxWidth="820" HorizontalAlignment="Center">

            <Border Style="{StaticResource Panel}"
                    Background="{DynamicResource BgPanelBrush}"
                    Padding="0"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <Grid Grid.Row="0" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource ErrBrush}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Working without cloud &amp; Tally"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="Last successful sync: —"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource BtnBase}"
                                Command="{Binding RefreshHealthCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Retry Now" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Rectangle Grid.Row="0"
                               VerticalAlignment="Bottom"
                               Height="1"
                               Fill="{DynamicResource DividerBrush}" />

                    <!--  Body: 2-column split  -->
                    <Grid Grid.Row="1" Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="✓ STILL WORKS"
                                       Style="{StaticResource TxtSectionTitle}"
                                       Foreground="{DynamicResource OkBrush}"
                                       Margin="0,0,0,6" />
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Creating new bills &amp; estimates (in memory)" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Printing estimates from unsaved work" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Quick-add picker using last synced masters" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Viewing bills loaded before disconnect" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="✕ BLOCKED UNTIL RECOVERY"
                                       Style="{StaticResource TxtSectionTitle}"
                                       Foreground="{DynamicResource ErrBrush}"
                                       Margin="0,0,0,6" />
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ErrBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Posting to Tally" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ErrBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Final tax invoice numbers (cloud-allocated)" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ErrBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Master-data changes (ledgers, items, karat)" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource ErrBrush}" />
                                <TextBlock Margin="8,0,0,0" Text="Voiding, reposting, deletion of older bills" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!--  Footer  -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource BgSunkenBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnBase}"
                                    Content="Open Database Settings"
                                    Command="{Binding OpenDatabaseSettingsCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="Retry Both"
                                    Command="{Binding RefreshHealthCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="RECOVERY CHECKLIST"
                       Style="{StaticResource TxtSectionTitle}"
                       Margin="2,0,0,6" />
            <Border Style="{StaticResource Panel}" Padding="14">
                <StackPanel>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{DynamicResource ErrBrush}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Cloud API unreachable" FontWeight="SemiBold" />
                            <TextBlock Text="DNS resolves · TCP connect fails · verify firewall / VPN"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="11.5" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="—"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0" Fill="{DynamicResource ErrBrush}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Tally — no response" FontWeight="SemiBold" />
                            <TextBlock Text="Check that TallyPrime is running and the XML endpoint is reachable"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="11.5" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Text="—"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2" Fill="{DynamicResource BgPanelBrush}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Unsaved bills held in memory" FontWeight="SemiBold" />
                            <TextBlock Text="Retry Save once the cloud is back to persist them"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="11.5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
