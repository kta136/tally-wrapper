<UserControl x:Class="ShowroomBilling.Desktop.Views.LimitedModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <Style x:Key="BulletRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style x:Key="BulletDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="16,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="840" HorizontalAlignment="Center">

            <!--  What still works and what waits for the server  -->
            <Border Margin="0,0,0,28" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36"
                                Height="36"
                                VerticalAlignment="Center"
                                Background="{StaticResource ErrSoftBrush}"
                                CornerRadius="18">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="16"
                                       Foreground="{StaticResource ErrInkBrush}"
                                       Text="&#xE711;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="{StaticResource FontSizeDialogTitle}" FontWeight="SemiBold" Text="Working without the server" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource TxtHint}" Foreground="{StaticResource InkMutedBrush}" Text="Last successful sync: —" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshHealthCommand}"
                                Content="Retry now" />
                    </Grid>
                    <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource DividerBrush}" />

                    <Grid Grid.Row="1" Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Foreground="{StaticResource OkInkBrush}"
                                           Text="&#xE930;" />
                                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource OkInkBrush}" Text="Available now" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource OkBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Retrying the server and Tally health checks" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource OkBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Opening Server settings to check the server address" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource OkBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Viewing the recovery checklist and the reason it failed" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="15"
                                           Foreground="{StaticResource ErrInkBrush}"
                                           Text="&#xEA39;" />
                                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource ErrInkBrush}" Text="Blocked until the server is back" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource ErrBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Creating, saving or printing bills" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource ErrBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Final tax invoice numbers" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource ErrBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Master-data changes and Tally refresh" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource BulletRow}">
                                <Ellipse Fill="{StaticResource ErrBrush}" Style="{StaticResource BulletDot}" />
                                <TextBlock Margin="10,0,0,0" Text="Voiding, reposting or deleting older bills" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="20,14"
                            Background="{StaticResource BgSunkenBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Margin="0,0,10,0" Command="{Binding OpenServerSettingsCommand}" Content="Server settings" />
                            <Button Command="{Binding RefreshHealthCommand}" Content="Retry both" Style="{StaticResource BtnPrimary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  What to check, in order  -->
            <TextBlock Margin="0,0,0,10" FontSize="15" FontWeight="SemiBold" Text="Recovery checklist" />
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Margin="20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                VerticalAlignment="Top"
                                Background="{StaticResource ErrBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource OnFilledInkBrush}"
                                       Text="&#xE711;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Cloud API unreachable" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource TxtHint}" Foreground="{StaticResource InkMutedBrush}" Text="DNS resolves · TCP connect fails · verify firewall / VPN" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{StaticResource InkSoftBrush}" Text="—" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                    <Grid Margin="20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                VerticalAlignment="Top"
                                Background="{StaticResource ErrBrush}"
                                CornerRadius="12">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource OnFilledInkBrush}"
                                       Text="&#xE711;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Tally — no response" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource TxtHint}" Foreground="{StaticResource InkMutedBrush}" Text="Check that TallyPrime is running and the XML endpoint is reachable" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{StaticResource InkSoftBrush}" Text="—" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource DividerBrush}" />
                    <Grid Margin="20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="24"
                                 Height="24"
                                 VerticalAlignment="Top"
                                 Fill="{StaticResource BgPanelBrush}"
                                 Stroke="{StaticResource InkSoftBrush}"
                                 StrokeThickness="2" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="Unsaved bills held in memory" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource TxtHint}" Foreground="{StaticResource InkMutedBrush}" Text="Retry Save once the cloud is back to persist them" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
