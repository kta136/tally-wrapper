<UserControl x:Class="ShowroomBilling.Desktop.Views.NavBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             mc:Ignorable="d"
             Height="36">
    <UserControl.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="accent"
                                    VerticalAlignment="Bottom"
                                    Height="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HealthBtn" BasedOn="{StaticResource BtnGhost}" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgPanelBrush}"
            BorderBrush="{DynamicResource BorderBrushTok}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Tabs  -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Style="{StaticResource NavItem}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource NavTabToBoolConverter}, ConverterParameter={x:Static shell:NavTab.Invoice}}"
                             Command="{Binding SwitchTabCommand}">
                    <RadioButton.CommandParameter>
                        <shell:NavTab>Invoice</shell:NavTab>
                    </RadioButton.CommandParameter>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.25"
                              Data="M 1.5,1 L 11.5,1 L 11.5,12 L 1.5,12 Z M 3.5,4 L 9.5,4 M 3.5,6.5 L 9.5,6.5 M 3.5,9 L 7,9" />
                        <TextBlock Margin="6,0,0,0" Text="Invoice" />
                        <Border Style="{StaticResource KbdHint}" Margin="8,0,0,0">
                            <TextBlock Text="Ctrl+1" FontSize="9.5" FontFamily="{DynamicResource MonoFontFamily}" />
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource NavTabToBoolConverter}, ConverterParameter={x:Static shell:NavTab.Bills}}"
                             Command="{Binding SwitchTabCommand}">
                    <RadioButton.CommandParameter>
                        <shell:NavTab>Bills</shell:NavTab>
                    </RadioButton.CommandParameter>
                    <StackPanel Orientation="Horizontal">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1.25"
                              Data="M 2,4 L 11,4 L 11,11.5 L 2,11.5 Z M 4,4 L 4,2.5 L 9,2.5 L 9,4 M 4.5,6.5 L 8.5,6.5 M 4.5,8.5 L 7,8.5" />
                        <TextBlock Margin="6,0,0,0" Text="Bills" />
                        <Border Style="{StaticResource KbdHint}" Margin="8,0,0,0">
                            <TextBlock Text="Ctrl+2" FontSize="9.5" FontFamily="{DynamicResource MonoFontFamily}" />
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}"
                             IsChecked="{Binding ActiveTab, Converter={StaticResource NavTabToBoolConverter}, ConverterParameter={x:Static shell:NavTab.Settings}}"
                             Command="{Binding SwitchTabCommand}">
                    <RadioButton.CommandParameter>
                        <shell:NavTab>Settings</shell:NavTab>
                    </RadioButton.CommandParameter>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="4" Height="4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.25" />
                        <TextBlock Margin="6,0,0,0" Text="Settings" />
                        <Border Style="{StaticResource KbdHint}" Margin="8,0,0,0">
                            <TextBlock Text="Ctrl+3" FontSize="9.5" FontFamily="{DynamicResource MonoFontFamily}" />
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!--  Health cluster + shortcuts  -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,10,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource HealthBtn}"
                        Command="{Binding OpenHealthCommand}"
                        ToolTip="{Binding Health.CloudTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Health.CloudDot, Converter={StaticResource DotToBrushConverter}}" />
                        <TextBlock Margin="6,0,0,0"
                                   Text="CLOUD"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HealthBtn}"
                        Command="{Binding OpenHealthCommand}"
                        ToolTip="{Binding Health.DatabaseTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Health.DatabaseDot, Converter={StaticResource DotToBrushConverter}}" />
                        <TextBlock Margin="6,0,0,0"
                                   Text="{Binding Health.DatabaseLabel}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HealthBtn}"
                        Command="{Binding OpenHealthCommand}"
                        ToolTip="{Binding Health.TallyTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{Binding Health.TallyDot, Converter={StaticResource DotToBrushConverter}}" />
                        <TextBlock Margin="6,0,0,0"
                                   Text="TALLY"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5" />
                    </StackPanel>
                </Button>

                <!--  Admin indicator — only visible while unlocked.
                      Clicking locks the session (delegates to AdminUnlockViewModel.LockCommand).  -->
                <Button Style="{StaticResource HealthBtn}"
                        Command="{Binding Admin.LockCommand}"
                        Visibility="{Binding Admin.IsUnlocked, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding Admin.SessionSummary}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource OkBrush}" />
                        <TextBlock Margin="6,0,0,0"
                                   Text="ADMIN"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1"
                           Height="18"
                           Margin="4,0"
                           Fill="{DynamicResource DividerBrush}" />
                <Button Style="{StaticResource HealthBtn}"
                        Command="{Binding OpenShortcutsCommand}"
                        ToolTip="Keyboard shortcuts (?)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Shortcuts" VerticalAlignment="Center" />
                        <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                            <TextBlock Text="?" FontSize="9.5" FontFamily="{DynamicResource MonoFontFamily}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
