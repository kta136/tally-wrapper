<UserControl x:Class="ShowroomBilling.Desktop.Views.Admin.AdminUnlockDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!--  Scrim — matches design: rgba(15,23,42,0.38)  -->
    <Grid Background="#61152238">
        <Border Style="{StaticResource Panel}"
                Width="520"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                DataContext="{Binding Admin}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.22" ShadowDepth="6" Color="#0F172A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  dialog-head  -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Shield icon  -->
                        <Border Grid.Column="0"
                                Width="22"
                                Height="22"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Path Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M 6,0.5 L 11,2.5 L 11,6.5 C 11,9.2 8.8,11.2 6,11.5 C 3.2,11.2 1,9.2 1,6.5 L 1,2.5 Z M 4,6 L 5.5,7.5 L 8.5,4.5" />
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Administrator Unlock"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Margin="10,0,0,0"
                                    Style="{StaticResource StateChipLocked}"
                                    Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{StaticResource ErrBrush}" />
                                    <TextBlock Text="LOCKED"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ErrInkBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Margin="10,0,0,0"
                                    Style="{StaticResource StateChipUnlocked}"
                                    Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{StaticResource OkBrush}" />
                                    <TextBlock Text="UNLOCKED"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource OkInkBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource BtnGhost}"
                                Width="28"
                                Height="24"
                                Padding="0"
                                ToolTip="Close (Esc)"
                                Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="✕" />
                    </Grid>
                </Border>

                <!--  dialog-body  -->
                <ScrollViewer Grid.Row="1" Padding="14,14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  Error banner  -->
                        <Border Style="{StaticResource AdminBannerErr}"
                                Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠"
                                           FontSize="13"
                                           Foreground="{StaticResource ErrBrush}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrInkBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--  Status banner (info)  -->
                        <Border Style="{StaticResource AdminBannerInfo}"
                                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         Fill="{StaticResource InfoBrush}" />
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{StaticResource InfoInkBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--  Unlock section (visible when locked + passcode already configured)  -->
                        <Border Style="{StaticResource AdminSectionPanel}"
                                Visibility="{Binding ShowUnlockForm, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AdminSectionTitle}" Text="UNLOCK" />
                                <TextBlock Style="{StaticResource AdminFieldLabel}" Text="PASSCODE" />
                                <PasswordBox x:Name="UnlockPasswordBox"
                                             PasswordChanged="UnlockPasswordBox_PasswordChanged"
                                             KeyDown="UnlockPasswordBox_KeyDown" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource BtnPrimary}"
                                            MinWidth="92"
                                            Content="Unlock"
                                            Command="{Binding UnlockCommand}" />
                                    <TextBlock Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Text="Unlock is valid for 30 minutes on this counter only." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Initial passcode setup (visible when locked + no passcode configured yet)  -->
                        <Border Style="{StaticResource AdminSectionPanel}"
                                Visibility="{Binding ShowInitialSetupForm, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource AdminSectionTitle}"
                                               Margin="0"
                                               Text="SET PASSCODE" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="10.5"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Text="Min. 6 characters"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="0,0,0,10"
                                           FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           TextWrapping="Wrap"
                                           Text="No admin passcode is configured yet. Set one now to enable admin unlock on this counter — saving will also start an admin session." />
                                <TextBlock Style="{StaticResource AdminFieldLabel}" Text="NEW PASSCODE" />
                                <PasswordBox x:Name="InitialNewPasscodeBox"
                                             PasswordChanged="InitialNewPasscodeBox_PasswordChanged" />
                                <TextBlock Style="{StaticResource AdminFieldLabel}" Margin="0,8,0,3" Text="CONFIRM NEW PASSCODE" />
                                <PasswordBox x:Name="InitialConfirmPasscodeBox"
                                             PasswordChanged="InitialConfirmPasscodeBox_PasswordChanged"
                                             KeyDown="InitialConfirmPasscodeBox_KeyDown" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource BtnPrimary}"
                                            MinWidth="120"
                                            Content="Set passcode"
                                            Command="{Binding SetOrChangePasscodeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Session summary (visible when unlocked)  -->
                        <Border Style="{StaticResource AdminBannerInfo}"
                                Background="{StaticResource OkSoftBrush}"
                                BorderBrush="{StaticResource OkBrush}"
                                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"
                                         Fill="{StaticResource OkBrush}" />
                                <TextBlock Text="{Binding SessionSummary}"
                                           Foreground="{StaticResource OkInkBrush}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!--
                            Passcode management and active draft-lock administration
                            moved to Settings › Admin tab so this dialog stays focused
                            on its one job: unlock + status. Those VM commands
                            (SetOrChangePasscodeCommand, RefreshLeasesCommand,
                            ForceReleaseSelectedLeaseCommand, LockCommand) are now
                            bound from there against the same AdminUnlockViewModel.
                        -->

                    </StackPanel>
                </ScrollViewer>

                <!--  dialog-foot  -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnBase}"
                                Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="Close" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
