<UserControl x:Class="ShowroomBilling.Desktop.Views.Admin.AdminUnlockDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <!--  One of three bodies, by the state of the counter: unlock (a passcode exists), set the first
          passcode (none yet), or the summary of a session that is already open. Closing is the shell's
          CloseDialogCommand, found on the UserControl's own DataContext because the frame's is Admin.  -->
    <shell:DialogFrame CloseCommand="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       DataContext="{Binding Admin}"
                       HeaderGlyph="&#xEA18;"
                       PanelWidth="560"
                       Title="{Binding DialogTitle}">
        <shell:DialogFrame.HeaderChips>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource ToneChip}"
                        Tag="err"
                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource ErrBrush}" />
                        <TextBlock Style="{StaticResource ToneChipText}" Tag="err" Text="Locked" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ToneChip}"
                        Tag="ok"
                        Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource OkBrush}" />
                        <TextBlock Style="{StaticResource ToneChipText}" Tag="ok" Text="Unlocked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </shell:DialogFrame.HeaderChips>
        <shell:DialogFrame.Footer>
            <Button Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{Binding CloseButtonText}"
                    shell:Kbd.Hint="Esc" />
        </shell:DialogFrame.Footer>

        <StackPanel>
            <!--  A hand-over asks to update a bill already in Tally: which bill, and why the passcode  -->
            <Border Style="{StaticResource AdminBannerInfo}" Visibility="{Binding HasHandoverContext, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource InfoBrush}"
                               Text="&#xE946;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InfoInkBrush}"
                               Text="{Binding HandoverContext}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  A wrong passcode, or a failed call  -->
            <Border Style="{StaticResource AdminBannerErr}" Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource ErrTextBrush}"
                               Text="&#xE783;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ErrInkBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AdminBannerInfo}" Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource InfoBrush}"
                               Text="&#xE946;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InfoInkBrush}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Locked, and a passcode exists  -->
            <StackPanel Visibility="{Binding ShowUnlockForm, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Passcode" />
                <PasswordBox shell:FocusOnShown.IsEnabled="True" shell:PasswordBinding.Password="{Binding Passcode}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding UnlockCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <Button MinWidth="92"
                            Command="{Binding UnlockCommand}"
                            Content="{Binding UnlockButtonText}"
                            shell:Kbd.Hint="Enter"
                            Style="{StaticResource BtnPrimary}" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource TxtHint}"
                               Text="Stays unlocked for 30 minutes, on this counter only." />
                </StackPanel>
            </StackPanel>

            <!--  Locked, and no passcode has been set yet  -->
            <StackPanel Visibility="{Binding ShowInitialSetupForm, Converter={StaticResource BoolToVis}}">
                <TextBlock Margin="0,0,0,12"
                           Foreground="{StaticResource InkMutedBrush}"
                           Text="No admin passcode has been set yet. Set one to turn on admin unlock for every counter. Saving also starts an admin session."
                           TextWrapping="Wrap" />
                <Border Style="{StaticResource AdminBannerInfo}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="14"
                                   Foreground="{StaticResource InfoBrush}"
                                   Text="&#xE946;" />
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InfoInkBrush}"
                                   Text="The first passcode can only be set on the server PC." />
                    </StackPanel>
                </Border>
                <Grid Margin="0,4,0,5">
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="New passcode" />
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource TxtHint}"
                               Text="{Binding PasscodeLengthHint, Mode=OneWay}" />
                </Grid>
                <PasswordBox shell:FocusOnShown.IsEnabled="True" shell:PasswordBinding.Password="{Binding NewPasscode}" />
                <TextBlock Margin="0,14,0,5"
                           Style="{StaticResource FieldLabel}"
                           Text="Confirm new passcode" />
                <PasswordBox shell:PasswordBinding.Password="{Binding ConfirmNewPasscode}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SetOrChangePasscodeCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <Button Margin="0,14,0,0"
                        MinWidth="120"
                        HorizontalAlignment="Left"
                        Command="{Binding SetOrChangePasscodeCommand}"
                        Content="Set passcode"
                        Style="{StaticResource BtnPrimary}" />
            </StackPanel>

            <!--  Unlocked: the session that is open  -->
            <Border Margin="0"
                    Style="{StaticResource AdminBannerOk}"
                    Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource OkInkBrush}"
                               Text="&#xE73E;" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource OkInkBrush}"
                               Text="{Binding SessionSummary}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </shell:DialogFrame>
</UserControl>
