<UserControl x:Class="ShowroomBilling.Desktop.Views.FKeyStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="22">
    <Border Background="{DynamicResource BgSunkenBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0">
        <ItemsControl ItemsSource="{Binding Items}" Padding="8,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BgPanelBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1,1,1,2"
                                CornerRadius="2"
                                Padding="5,0"
                                MinWidth="20"
                                Height="15"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Key}"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource InkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="4,0,0,0"
                                   Text="{Binding Label}"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Rectangle Width="1"
                                   Height="12"
                                   Margin="8,0"
                                   Fill="{DynamicResource DividerBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
