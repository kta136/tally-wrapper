<UserControl x:Class="ShowroomBilling.Desktop.Views.FKeyStripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="22">
    <Border Background="{StaticResource BgSunkenBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
        <ItemsControl ItemsSource="{Binding Items}" Padding="8,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgPanelBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1,1,1,2"
                                CornerRadius="2"
                                Padding="5,0"
                                MinWidth="20"
                                Height="15"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Key}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="9.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="4,0,0,0"
                                   Text="{Binding Label}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="{DynamicResource FontSizeXs}"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Rectangle Width="1"
                                   Height="12"
                                   Margin="8,0"
                                   Fill="{StaticResource DividerBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
