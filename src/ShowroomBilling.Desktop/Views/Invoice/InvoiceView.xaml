<UserControl x:Class="ShowroomBilling.Desktop.Views.Invoice.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Invoice"
             xmlns:vmSettings="clr-namespace:ShowroomBilling.Desktop.ViewModels.Settings"
             xmlns:conv="clr-namespace:ShowroomBilling.Desktop.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BgPanelBrush}"
             d:DataContext="{d:DesignInstance Type=vm:InvoiceViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <conv:DecimalIsPositiveConverter x:Key="DecimalIsPositive" />

        <!--  The 13 columns of the line table, in four zones: the item, the weights, the pricing
              inputs and the two results. Header, rows, totals and the tinted backdrop all use these
              widths; the item column takes the rest. See docs/design/redesign/Estimate-Table.png.  -->
        <GridLength x:Key="ColNumber">36</GridLength>
        <GridLength x:Key="ColGross">76</GridLength>
        <GridLength x:Key="ColLess">66</GridLength>
        <GridLength x:Key="ColNet">76</GridLength>
        <GridLength x:Key="ColUnit">48</GridLength>
        <GridLength x:Key="ColKarat">60</GridLength>
        <GridLength x:Key="ColWastage">84</GridLength>
        <GridLength x:Key="ColLabour">86</GridLength>
        <GridLength x:Key="ColExtra">68</GridLength>
        <GridLength x:Key="ColRate">92</GridLength>
        <GridLength x:Key="ColTotal">116</GridLength>
        <GridLength x:Key="ColRemove">32</GridLength>

        <!--  Column heading text: 12.5 px semibold on the grey band.  -->
        <Style x:Key="HeadText" BasedOn="{StaticResource TableHeaderText}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style x:Key="HeadTextRight" BasedOn="{StaticResource HeadText}" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="4,0,10,0" />
        </Style>
        <Style x:Key="HeadUnit" TargetType="Run">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        </Style>

        <!--  Numbers in a cell: right-aligned so decimals line up down the column.  -->
        <Style x:Key="CellNumBox" BasedOn="{StaticResource TableCellBox}" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <EventSetter Event="PreviewMouseDoubleClick" Handler="OnNumericBoxDoubleClick" />
        </Style>

        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="10,0" />
            <Style.Triggers>
                <!--  A blank row has no rate or total yet.  -->
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  A result cell is tinted; on the row that holds focus the tint is a shade deeper.  -->
        <Style x:Key="ResultCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ResultTintBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=LineEntryGrid}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ResultTintActiveBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The row: a hairline under it, and a pale indigo wash while focus is inside it.  -->
        <Style x:Key="LineRowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="{DynamicResource RowHeight}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <ContentPresenter />
                                <Border x:Name="focusEdge"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSunkenBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusEdge" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LineRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The item cell's drop-down lists each item with its unit, wastage and labour under the name.  -->
        <DataTemplate x:Key="ItemPickerRow" DataType="{x:Type vmSettings:ItemMasterRowVm}">
            <StackPanel Margin="6,5">
                <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                <TextBlock Margin="0,1,0,0" Style="{StaticResource TxtHint}" Text="{Binding PickerSummary}" />
            </StackPanel>
        </DataTemplate>

        <Border x:Key="ItemPickerFooter"
                x:Shared="False"
                Padding="12,7"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal">
                <ContentControl Content="↑" Style="{StaticResource Kbd}" />
                <ContentControl Margin="3,0,0,0" Content="↓" Style="{StaticResource Kbd}" />
                <TextBlock Margin="8,0,16,0" VerticalAlignment="Center" Style="{StaticResource TxtHint}" Text="Move" />
                <ContentControl Content="Enter" Style="{StaticResource Kbd}" />
                <TextBlock Margin="8,0,16,0" VerticalAlignment="Center" Style="{StaticResource TxtHint}" Text="Pick" />
                <ContentControl Content="Esc" Style="{StaticResource Kbd}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TxtHint}" Text="Close" />
            </StackPanel>
        </Border>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0: editing a posted bill  -->
        <Border Grid.Row="0"
                Padding="16,9"
                Background="{StaticResource EditBannerSoftBrush}"
                BorderBrush="{StaticResource EditBannerBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsEditingPosted, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="16"
                           Foreground="{StaticResource EditBannerInkBrush}"
                           Text="&#xE70F;" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{StaticResource EditBannerInkBrush}"
                           Text="Editing a previously-posted bill. Saving moves it back to pending and re-queues the new revision to Tally."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Row 1: bill details, five fields  -->
        <Border Grid.Row="1"
                Padding="16,12,16,14"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="196" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock Margin="0" Style="{StaticResource FieldLabel}" Text="Invoice no." />
                        <ContentControl Margin="6,0,0,0" Content="auto" Style="{StaticResource Kbd}" />
                    </StackPanel>
                    <TextBox IsReadOnly="True" Text="{Binding InvoiceNumber, Mode=OneWay}">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvoiceNumberAssigned}" Value="False">
                                        <Setter Property="FontStyle" Value="Italic" />
                                        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInvoiceNumberAssigned}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Date" />
                    <DatePicker SelectedDate="{Binding BillDateLocal, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Payment" />
                    <ComboBox ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding Payment}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock Margin="0" Style="{StaticResource FieldLabel}" Text="24K rate (₹/g)" />
                        <ContentControl Margin="6,0,0,0" Content="F2" Style="{StaticResource Kbd}" />
                    </StackPanel>
                    <TextBox x:Name="Rate24KtBox"
                             FontWeight="SemiBold"
                             Padding="26,0,10,0"
                             PreviewKeyDown="OnRate24KtPreviewKeyDown"
                             PreviewMouseDoubleClick="OnNumericBoxDoubleClick"
                             shell:FieldAdorn.Prefix="₹"
                             Text="{Binding Rate24Kt, StringFormat=N0, TargetNullValue='', UpdateSourceTrigger=LostFocus}">
                        <TextBox.Style>
                            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                <Style.Triggers>
                                    <!--  Saving without a gold rate turns the box red; typing a rate clears it.  -->
                                    <DataTrigger Binding="{Binding RateMissing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ErrTextBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Background" Value="{StaticResource ErrWashBrush}" />
                                        <Setter Property="Padding" Value="25,0,9,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <StackPanel Margin="0,6,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding RateMissing, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="14"
                                   Foreground="{StaticResource ErrTextBrush}"
                                   Text="&#xE783;" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource ErrTextBrush}"
                                   Text="Enter today's rate" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock Margin="0" Style="{StaticResource FieldLabel}" Text="Party" />
                        <TextBlock Margin="3,0,0,0" Style="{StaticResource FieldLabel}" Foreground="{StaticResource ErrTextBrush}" Text="*" />
                        <ContentControl Margin="6,0,0,0" Content="F4" Style="{StaticResource Kbd}" />
                    </StackPanel>
                    <TextBox x:Name="PartyBox"
                             PreviewKeyDown="OnPartyBoxPreviewKeyDown"
                             shell:FieldAdorn.Placeholder="Search or type a party name"
                             Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row 2: line items, and the Quick add panel beside them  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource BgPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Toolbar: title, count, today's rates, row buttons  -->
                <Grid Grid.Row="0" Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Line items" />
                        <Border Margin="10,0,0,0"
                                Height="20"
                                MinWidth="20"
                                Padding="7,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource NeutralChipBrush}"
                                CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Text="{Binding ItemCount}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeLabel}"
                               Foreground="{StaticResource InkMutedBrush}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rates, Converter={x:Static conv:NullToBoolConverter.Instance}}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="Rates today" />
                        <Run Foreground="{StaticResource InkDisabledBrush}" Text=" · " />
                        <Run Text="24K " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding Rates.Rate24Kt, Mode=OneWay}" />
                        <Run Foreground="{StaticResource InkDisabledBrush}" Text=" · " />
                        <Run Text="22K " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding Rates.Rate22Kt, Mode=OneWay}" />
                        <Run Foreground="{StaticResource InkDisabledBrush}" Text=" · " />
                        <Run Text="18K " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding Rates.Rate18Kt, Mode=OneWay}" />
                        <Run Text=" per gram" />
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeLabel}"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="Rates today appear once the 24K rate is entered"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rates, Converter={x:Static conv:NullToBoolConverter.Instance}}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding AddRowCommand}" Style="{StaticResource BtnSm}" shell:Kbd.Hint="Ctrl+N">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="12"
                                           Text="&#xE710;" />
                                <TextBlock Margin="8,0,0,0" Text="Add row" />
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0"
                                Command="{Binding RemoveFocusedRowCommand}"
                                Content="Remove row"
                                Style="{StaticResource BtnSm}"
                                Visibility="{Binding HasMultipleRows, Converter={StaticResource BoolToVis}}"
                                shell:Kbd.Hint="Ctrl+Del" />
                    </StackPanel>
                </Grid>

                <!--  Table: scrolls sideways below 1,014 px; the rows scroll up and down inside it.  -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="1018">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Column headings  -->
                        <Border Grid.Row="0"
                                Height="34"
                                Background="{StaticResource BgSunkenBrush}"
                                BorderBrush="{StaticResource BorderBrushTok}"
                                BorderThickness="0,1,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColNumber}" />
                                    <ColumnDefinition Width="*" MinWidth="178" />
                                    <ColumnDefinition Width="{StaticResource ColKarat}" />
                                    <ColumnDefinition Width="{StaticResource ColGross}" />
                                    <ColumnDefinition Width="{StaticResource ColLess}" />
                                    <ColumnDefinition Width="{StaticResource ColNet}" />
                                    <ColumnDefinition Width="{StaticResource ColUnit}" />
                                    <ColumnDefinition Width="{StaticResource ColWastage}" />
                                    <ColumnDefinition Width="{StaticResource ColLabour}" />
                                    <ColumnDefinition Width="{StaticResource ColExtra}" />
                                    <ColumnDefinition Width="{StaticResource ColRate}" />
                                    <ColumnDefinition Width="{StaticResource ColTotal}" />
                                    <ColumnDefinition Width="{StaticResource ColRemove}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource HeadTextRight}" Text="#" />
                                <TextBlock Grid.Column="1" Style="{StaticResource HeadText}" Text="Item / stock name" />
                                <Border Grid.Column="3" BorderBrush="{StaticResource BorderBrushTok}" BorderThickness="1,0,0,0">
                                    <TextBlock Style="{StaticResource HeadTextRight}" Text="Gross" ToolTip="Gross weight" />
                                </Border>
                                <TextBlock Grid.Column="4" Style="{StaticResource HeadTextRight}" Text="Less" ToolTip="Deduction. Net = Gross − Less; editing Net recalculates this value." />
                                <TextBlock Grid.Column="5" Style="{StaticResource HeadTextRight}" Text="Net" ToolTip="Billed weight. Editing it recalculates Less as Gross − Net." />
                                <TextBlock Grid.Column="6" Style="{StaticResource HeadText}" Text="Unit" />
                                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushTok}" BorderThickness="1,0,0,0">
                                    <TextBlock Style="{StaticResource HeadText}" Text="Karat" />
                                </Border>
                                <Border Grid.Column="7" BorderBrush="{StaticResource BorderBrushTok}" BorderThickness="1,0,0,0">
                                    <TextBlock Style="{StaticResource HeadTextRight}"><Run Text="Wastage" /><Run Style="{StaticResource HeadUnit}" Text=" %" /></TextBlock>
                                </Border>
                                <TextBlock Grid.Column="8" Style="{StaticResource HeadTextRight}"><Run Text="Labour" /><Run Style="{StaticResource HeadUnit}" Text=" ₹/g" /></TextBlock>
                                <TextBlock Grid.Column="9" Style="{StaticResource HeadTextRight}"><Run Text="Extra" /><Run Style="{StaticResource HeadUnit}" Text=" ₹" /></TextBlock>
                                <Border Grid.Column="10" BorderBrush="{StaticResource BorderBrushTok}" BorderThickness="1,0,0,0">
                                    <TextBlock Style="{StaticResource HeadTextRight}" Foreground="{StaticResource InkBrush}" ToolTip="Rate per unit, GST included. Calculated."><Run Text="Rate" /><Run Style="{StaticResource HeadUnit}" Text=" ₹" /></TextBlock>
                                </Border>
                                <TextBlock Grid.Column="11" Style="{StaticResource HeadTextRight}" Foreground="{StaticResource InkBrush}" ToolTip="Line total, GST included. Calculated."><Run Text="Line total" /><Run Style="{StaticResource HeadUnit}" Text=" ₹" /></TextBlock>
                            </Grid>
                        </Border>

                        <!--  The tinted result columns and zone lines run to the foot of the table, under the rows.  -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ColNumber}" />
                                <ColumnDefinition Width="*" MinWidth="178" />
                                <ColumnDefinition Width="{StaticResource ColKarat}" />
                                <ColumnDefinition Width="{StaticResource ColGross}" />
                                <ColumnDefinition Width="{StaticResource ColLess}" />
                                <ColumnDefinition Width="{StaticResource ColNet}" />
                                <ColumnDefinition Width="{StaticResource ColUnit}" />
                                <ColumnDefinition Width="{StaticResource ColWastage}" />
                                <ColumnDefinition Width="{StaticResource ColLabour}" />
                                <ColumnDefinition Width="{StaticResource ColExtra}" />
                                <ColumnDefinition Width="{StaticResource ColRate}" />
                                <ColumnDefinition Width="{StaticResource ColTotal}" />
                                <ColumnDefinition Width="{StaticResource ColRemove}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" />
                            <Border Grid.Column="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" />
                            <Border Grid.Column="7" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0" />
                            <Border Grid.Column="10"
                                    Grid.ColumnSpan="2"
                                    Background="{StaticResource ResultTintBrush}"
                                    BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1,0,0,0" />
                        </Grid>

                        <!--  Rows. The grid always ends in one blank row; Tab from its last cell moves into it.  -->
                        <ListBox x:Name="LinesItems"
                                 Grid.Row="1"
                                 Style="{StaticResource OverlayListBox}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 ItemContainerStyle="{StaticResource LineRowItem}"
                                 ItemsSource="{Binding Lines}"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.CacheLength="2"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LineRowBorder}">
                                        <Grid x:Name="LineEntryGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource ColNumber}" />
                                                <ColumnDefinition Width="*" MinWidth="178" />
                                                <ColumnDefinition Width="{StaticResource ColKarat}" />
                                                <ColumnDefinition Width="{StaticResource ColGross}" />
                                                <ColumnDefinition Width="{StaticResource ColLess}" />
                                                <ColumnDefinition Width="{StaticResource ColNet}" />
                                                <ColumnDefinition Width="{StaticResource ColUnit}" />
                                                <ColumnDefinition Width="{StaticResource ColWastage}" />
                                                <ColumnDefinition Width="{StaticResource ColLabour}" />
                                                <ColumnDefinition Width="{StaticResource ColExtra}" />
                                                <ColumnDefinition Width="{StaticResource ColRate}" />
                                                <ColumnDefinition Width="{StaticResource ColTotal}" />
                                                <ColumnDefinition Width="{StaticResource ColRemove}" />
                                            </Grid.ColumnDefinitions>

                                            <!--  0 · row number  -->
                                            <Border Grid.Column="0">
                                                <TextBlock Margin="0,0,8,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding RowNumber}">
                                                    <TextBlock.Style>
                                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=LineEntryGrid}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!--  1 · item. Type to search the item master; the list shows unit, wastage and labour.  -->
                                            <Border Grid.Column="1">
                                                <shell:FillCell>
                                                <Grid>
                                                    <ComboBox x:Name="ItemCombo"
                                                              FontWeight="Medium"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="False"
                                                              ItemTemplate="{StaticResource ItemPickerRow}"
                                                              ItemsSource="{Binding DataContext.ItemMasters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding ItemMaster, Mode=TwoWay}"
                                                              StaysOpenOnEdit="True"
                                                              Text="{Binding ItemName, UpdateSourceTrigger=LostFocus}"
                                                              TextSearch.TextPath="Name"
                                                              shell:ComboExtras.DropDownFooter="{StaticResource ItemPickerFooter}"
                                                              shell:ComboExtras.DropDownMinWidth="420"
                                                              shell:TypeAhead.Footer="{StaticResource ItemPickerFooter}"
                                                              shell:TypeAhead.IsEnabled="True"
                                                              shell:TypeAhead.MinWidth="420"
                                                              shell:TypeAhead.Path="Name">
                                                        <ComboBox.Style>
                                                            <Style BasedOn="{StaticResource TableCellCombo}" TargetType="ComboBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                        <Setter Property="Padding" Value="10,0,78,0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ComboBox.Style>
                                                    </ComboBox>
                                                    <TextBlock Margin="10,0,0,0"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               FontStyle="Italic"
                                                               Foreground="{StaticResource InkSoftBrush}"
                                                               IsHitTestVisible="False"
                                                               Text="Type an item name, or press F3…"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsEmpty}" Value="True" />
                                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ItemCombo}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!--  A diamond item wears a small tag, because its row is priced differently.  -->
                                                    <Border Margin="0,0,10,0"
                                                            Height="20"
                                                            Padding="7,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="4"
                                                            IsHitTestVisible="False">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsDiamond}" Value="True" />
                                                                            <Condition Binding="{Binding IsEmpty}" Value="False" />
                                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ItemCombo}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource FontSizeXs}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentInkBrush}"
                                                                   Text="Diamond" />
                                                    </Border>
                                                </Grid>
                                                </shell:FillCell>
                                            </Border>

                                            <!--  3 · gross  -->
                                            <Border Grid.Column="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                                                <TextBox Style="{StaticResource CellNumBox}"
                                                         ToolTip="Gross weight"
                                                         Text="{Binding GrossWeight, TargetNullValue='', StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <!--  4 · less. A deduction above zero reads amber; a diamond has none.  -->
                                            <Border Grid.Column="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LessWeight, Converter={StaticResource DecimalIsPositive}}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BgSunkenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBox ToolTip="Deduction. Net updates automatically; editing Net recalculates Less."
                                                             Text="{Binding LessWeight, TargetNullValue='', StringFormat=N3, UpdateSourceTrigger=LostFocus}">
                                                        <TextBox.Style>
                                                            <Style BasedOn="{StaticResource CellNumBox}" TargetType="TextBox">
                                                                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                        <Setter Property="shell:FieldAdorn.Placeholder" Value="0.000" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LessWeight, Converter={StaticResource DecimalIsPositive}}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource InkDisabledBrush}"
                                                               IsHitTestVisible="False"
                                                               Text="—"
                                                               ToolTip="Not used for diamond lines">
                                                        <TextBlock.Style>
                                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!--  5 · net  -->
                                            <Border Grid.Column="5">
                                                <TextBox ToolTip="Billed weight. Editing it recalculates Less as Gross − Net."
                                                         Text="{Binding NetWeight, Mode=TwoWay, StringFormat=N3, UpdateSourceTrigger=LostFocus}">
                                                    <TextBox.Style>
                                                        <Style BasedOn="{StaticResource CellNumBox}" TargetType="TextBox">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <!--  A blank row has no weight yet; the 0.000 would only be noise.  -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsEmpty}" Value="True" />
                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=LineEntryGrid}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="Transparent" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>

                                            <!--  6 · unit  -->
                                            <Border Grid.Column="6">
                                                <ComboBox ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Unit}"
                                                          Style="{StaticResource TableCellCombo}" />
                                            </Border>

                                            <!--  2 · karat, a gold line, next to the item. The cell turns red when the weights are in and the karat is not.  -->
                                            <Border Grid.Column="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <ComboBox x:Name="KaratCombo"
                                                              DisplayMemberPath="Label"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="False"
                                                              ItemsSource="{Binding DataContext.KaratMasters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding KaratMaster, Mode=TwoWay}"
                                                              Style="{StaticResource TableCellCombo}"
                                                              Text="{Binding Karat, UpdateSourceTrigger=LostFocus}"
                                                              TextSearch.TextPath="Label"
                                                              shell:TypeAhead.IsEnabled="True"
                                                              shell:TypeAhead.Path="Label" />
                                                    <Border Background="{StaticResource ErrWashBrush}"
                                                            BorderBrush="{StaticResource ErrTextBrush}"
                                                            BorderThickness="2"
                                                            IsHitTestVisible="False">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <!--  It marks the empty cell; while the cell is being typed in, the typing must show.  -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding NeedsKarat}" Value="True" />
                                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=KaratCombo}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource InkSoftBrush}"
                                                                   Text="Karat" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!--  7 · wastage and 8 · labour, gold lines  -->
                                            <Border Grid.Column="7">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBox Style="{StaticResource CellNumBox}"
                                                         Text="{Binding WastagePercent, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                            </Border>
                                            <Border Grid.Column="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBox Style="{StaticResource CellNumBox}"
                                                         Text="{Binding LabourPerUnit, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                            </Border>

                                            <!--  7 and 8 · a diamond line has one flat rate here instead of two blank cells  -->
                                            <Border Grid.Column="7"
                                                    Grid.ColumnSpan="2"
                                                    BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="1,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDiamond}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="{DynamicResource FontSizeLabel}"
                                                               Foreground="{StaticResource InkMutedBrush}"
                                                               Text="{Binding Unit, StringFormat='Flat rate / {0}', Mode=OneWay}"
                                                               ToolTip="Flat rate for a diamond item, GST included."
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBox Grid.Column="1"
                                                             FontWeight="SemiBold"
                                                             Foreground="{StaticResource AccentInkBrush}"
                                                             Style="{StaticResource CellNumBox}"
                                                             ToolTip="Flat rate for a diamond item, GST included."
                                                             Text="{Binding DiamondRate, TargetNullValue='', StringFormat=N0, UpdateSourceTrigger=LostFocus}" />
                                                </Grid>
                                            </Border>

                                            <!--  9 · extra  -->
                                            <Border Grid.Column="9">
                                                <TextBox Text="{Binding Extra, TargetNullValue='', UpdateSourceTrigger=LostFocus}">
                                                    <TextBox.Style>
                                                        <Style BasedOn="{StaticResource CellNumBox}" TargetType="TextBox">
                                                            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                    <Setter Property="shell:FieldAdorn.Placeholder" Value="0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Extra, Converter={StaticResource DecimalIsPositive}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>

                                            <!--  10 · rate and 11 · line total: calculated, never a tab stop  -->
                                            <Border Grid.Column="10"
                                                    BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="1,0,0,0"
                                                    Style="{StaticResource ResultCell}">
                                                <TextBlock Foreground="{StaticResource InkMutedBrush}"
                                                           Style="{StaticResource ResultText}"
                                                           Text="{Binding EffectiveRate, StringFormat=N2, TargetNullValue=''}" />
                                            </Border>
                                            <Border Grid.Column="11" Style="{StaticResource ResultCell}">
                                                <TextBlock FontSize="{StaticResource FontSizeLineTotal}"
                                                           FontWeight="SemiBold"
                                                           Style="{StaticResource ResultText}"
                                                           Text="{Binding LineTotal, StringFormat=N2, TargetNullValue=''}" />
                                            </Border>

                                            <!--  12 · remove, on the row that has focus or the pointer  -->
                                            <Border Grid.Column="12">
                                                <Button Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove row">
                                                    <Button.Style>
                                                        <Style BasedOn="{StaticResource BtnIcon}" TargetType="Button">
                                                            <Setter Property="Width" Value="24" />
                                                            <Setter Property="Height" Value="24" />
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=LineEntryGrid}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=LineEntryGrid}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE711;" />
                                                </Button>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  How the focused line was priced  -->
                        <Border Grid.Row="2"
                                MinHeight="46"
                                Padding="16,8"
                                Background="{StaticResource FocusStripBrush}"
                                BorderBrush="{StaticResource BorderBrushTok}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource InkSoftBrush}"
                                           Text="Fill in a line to see how its rate and total are worked out.">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FocusExplanation, Converter={x:Static conv:NullToBoolConverter.Instance}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <WrapPanel VerticalAlignment="Center">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FocusExplanation, Converter={x:Static conv:NullToBoolConverter.Instance}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>
                                    <TextBlock Margin="0,2,22,2" FontWeight="SemiBold">
                                        <Run Foreground="{StaticResource AccentInkBrush}" Text="{Binding FocusExplanation.RowLabel, Mode=OneWay}" />
                                        <Run Text="  " /><Run Text="{Binding FocusExplanation.ItemName, Mode=OneWay}" />
                                    </TextBlock>
                                    <Rectangle Width="1" Height="20" Margin="0,0,22,0" Fill="{StaticResource BorderBrushTok}" />
                                    <TextBlock Margin="0,2,22,2" Foreground="{StaticResource ErrTextBrush}" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FocusExplanation.Problem, Converter={x:Static conv:NullToBoolConverter.Instance}}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding FocusExplanation.Problem, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,22,2" Foreground="{StaticResource InkMutedBrush}">
                                        <Run Foreground="{StaticResource InkSoftBrush}" Text="Net " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding FocusExplanation.NetValue, Mode=OneWay}" /><Run Text="{Binding FocusExplanation.NetFormula, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,22,2" Foreground="{StaticResource InkMutedBrush}">
                                        <Run Foreground="{StaticResource InkSoftBrush}" Text="Rate " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding FocusExplanation.RateValue, Mode=OneWay}" /><Run Text="{Binding FocusExplanation.RateFormula, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,2" Foreground="{StaticResource InkMutedBrush}">
                                        <Run Foreground="{StaticResource InkSoftBrush}" Text="Line " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding FocusExplanation.LineValue, Mode=OneWay}" /><Run Text="{Binding FocusExplanation.LineFormula, Mode=OneWay}" />
                                    </TextBlock>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!--  Column totals: grams and carats kept apart  -->
                        <Border Grid.Row="3"
                                Height="48"
                                Background="{StaticResource BgSunkenBrush}"
                                BorderBrush="{StaticResource BorderBrushTok}"
                                BorderThickness="0,1,0,1">
                            <Grid TextElement.FontWeight="SemiBold">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColNumber}" />
                                    <ColumnDefinition Width="*" MinWidth="178" />
                                    <ColumnDefinition Width="{StaticResource ColKarat}" />
                                    <ColumnDefinition Width="{StaticResource ColGross}" />
                                    <ColumnDefinition Width="{StaticResource ColLess}" />
                                    <ColumnDefinition Width="{StaticResource ColNet}" />
                                    <ColumnDefinition Width="{StaticResource ColUnit}" />
                                    <ColumnDefinition Width="{StaticResource ColWastage}" />
                                    <ColumnDefinition Width="{StaticResource ColLabour}" />
                                    <ColumnDefinition Width="{StaticResource ColExtra}" />
                                    <ColumnDefinition Width="{StaticResource ColRate}" />
                                    <ColumnDefinition Width="{StaticResource ColTotal}" />
                                    <ColumnDefinition Width="{StaticResource ColRemove}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource InkMutedBrush}">
                                    <Run Text="Total" /><Run FontWeight="Medium" Foreground="{StaticResource InkSoftBrush}" Text=" · " /><Run FontWeight="Medium" Foreground="{StaticResource InkSoftBrush}" Text="{Binding ItemCount, Mode=OneWay}" /><Run FontWeight="Medium" Foreground="{StaticResource InkSoftBrush}" Text=" lines" />
                                </TextBlock>
                                <StackPanel Grid.Column="3" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding WeightTotals.GramGross}" Visibility="{Binding WeightTotals.ShowGramLine, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentInkBrush}" Text="{Binding WeightTotals.CaratGross}" Visibility="{Binding WeightTotals.ShowCaratLine, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource WarnInkBrush}" Text="{Binding WeightTotals.GramLess}" Visibility="{Binding WeightTotals.ShowGramLine, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource InkDisabledBrush}" Text="—" Visibility="{Binding WeightTotals.ShowCaratLine, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding WeightTotals.GramNet}" Visibility="{Binding WeightTotals.ShowGramLine, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentInkBrush}" Text="{Binding WeightTotals.CaratNet}" Visibility="{Binding WeightTotals.ShowCaratLine, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Medium" Foreground="{StaticResource InkSoftBrush}" Text="g" Visibility="{Binding WeightTotals.ShowGramLine, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock FontWeight="Medium" Foreground="{StaticResource AccentInkBrush}" Text="ct" Visibility="{Binding WeightTotals.ShowCaratLine, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="11"
                                           Margin="10,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="14.5"
                                           Text="{Binding InclusiveTotal, StringFormat=N2}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!--  Quick add: folded to a rail, or open as a panel beside the table  -->
            <Border x:Name="QuickAddRail"
                    Grid.Column="1"
                    Width="38"
                    Background="{StaticResource BgSunkenBrush}"
                    BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuickAddOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Button Width="26"
                            Height="26"
                            Padding="0"
                            Command="{Binding OpenQuickAddCommand}"
                            Style="{StaticResource BtnBase}"
                            ToolTip="Open Quick add (F3)">
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE76B;" />
                    </Button>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{DynamicResource FontSizeLabel}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="Quick add">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="270" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <ContentControl Margin="0,12,0,0" HorizontalAlignment="Center" Content="F3" Style="{StaticResource Kbd}" />
                </StackPanel>
            </Border>

            <Border x:Name="QuickAddPanel"
                    Grid.Column="1"
                    Width="260"
                    Background="{StaticResource BgPanelBrush}"
                    BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding IsQuickAddOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="14,12,14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Quick add" />
                                <ContentControl Margin="8,0,0,0" Content="F3" Style="{StaticResource Kbd}" />
                            </StackPanel>
                            <Button Width="26"
                                    Height="26"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseQuickAddCommand}"
                                    Style="{StaticResource BtnBase}"
                                    ToolTip="Fold Quick add">
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="12" Text="&#xE76C;" />
                            </Button>
                        </Grid>
                        <TextBox x:Name="QuickAddBox"
                                 Margin="0,10,0,0"
                                 Padding="30,0,10,0"
                                 PreviewKeyDown="OnQuickAddBoxPreviewKeyDown"
                                 shell:FieldAdorn.Placeholder="Search items"
                                 Text="{Binding QuickAddQuery, UpdateSourceTrigger=PropertyChanged}">
                            <shell:FieldAdorn.Prefix>
                                <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="13" Text="&#xE721;" />
                            </shell:FieldAdorn.Prefix>
                        </TextBox>
                        <TextBlock Margin="2,8,0,0" Style="{StaticResource TxtHint}" Text="{Binding QuickAddCountText}" />
                    </StackPanel>
                    <ListBox x:Name="QuickAddList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderBrush="{StaticResource BorderBrushTok}"
                             BorderThickness="0,1,0,0"
                             ItemContainerStyle="{StaticResource PickerListBoxItem}"
                             ItemsSource="{Binding QuickAddResults}"
                             PreviewKeyDown="OnQuickAddListPreviewKeyDown"
                             PreviewMouseLeftButtonUp="OnQuickAddListClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedItem="{Binding QuickAddSelection, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,1,0,0" Style="{StaticResource TxtHint}" Text="{Binding QuickSummary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Width="24"
                                            Height="24"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource OnFilledInkBrush}"
                                                   Text="&#xE710;" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2"
                            Padding="14,10"
                            Background="{StaticResource BgSunkenBrush}"
                            BorderBrush="{StaticResource BorderBrushTok}"
                            BorderThickness="0,1,0,0">
                        <TextBlock Style="{StaticResource TxtHint}" Text="Click an item to add it to the next empty row." />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  Row 3: the bill's arithmetic on one line, ending in the grand total  -->
        <Border Grid.Row="3"
                Padding="16,12,16,14"
                Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="SumLabel" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
                            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                        </Style>
                        <Style x:Key="SumValue" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,3,0,0" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Style>
                        <Style x:Key="SumOperator" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Setter Property="Margin" Value="14,0" />
                            <Setter Property="VerticalAlignment" Value="Bottom" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                        </Style>
                    </StackPanel.Resources>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource SumLabel}" Text="Subtotal, before GST" />
                        <TextBlock Style="{StaticResource SumValue}" Text="{Binding Subtotal, StringFormat=N2, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SumOperator}" Text="+" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource SumLabel}" Text="CGST 1.5%" />
                        <TextBlock Style="{StaticResource SumValue}" Text="{Binding Cgst, StringFormat=N2, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SumOperator}" Text="+" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource SumLabel}" Text="SGST 1.5%" />
                        <TextBlock Style="{StaticResource SumValue}" Text="{Binding Sgst, StringFormat=N2, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SumOperator}" Text="−" />

                    <!--  Discount and the final amount drive each other: type either one.  -->
                    <StackPanel VerticalAlignment="Bottom">
                        <Grid Margin="0,0,0,5">
                            <CheckBox VerticalAlignment="Center"
                                      FontSize="{DynamicResource FontSizeLabel}"
                                      Foreground="{StaticResource InkMutedBrush}"
                                      IsChecked="{Binding DiscountEnabled}">
                                <TextBlock FontSize="{DynamicResource FontSizeLabel}" Foreground="{StaticResource InkMutedBrush}" Text="Discount" />
                            </CheckBox>
                            <TextBlock Margin="70,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SumLabel}"
                                       Text="Final amount" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="112"
                                     FontWeight="SemiBold"
                                     IsEnabled="{Binding DiscountEnabled}"
                                     Padding="32,0,10,0"
                                     TextAlignment="Right"
                                     Text="{Binding Discount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}">
                                <shell:FieldAdorn.Prefix>
                                    <TextBlock Foreground="{StaticResource ErrTextBrush}" Text="−₹" />
                                </shell:FieldAdorn.Prefix>
                            </TextBox>
                            <TextBlock Width="40"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeLabel}"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Text="{Binding DiscountPercentHint}" />
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="14"
                                       Foreground="{StaticResource InkSoftBrush}"
                                       Text="&#xE8AB;" />
                            <TextBox Width="128"
                                     FontWeight="SemiBold"
                                     Padding="26,0,10,0"
                                     TextAlignment="Right"
                                     shell:FieldAdorn.Prefix="₹"
                                     Text="{Binding FinalAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                                        <Style.Triggers>
                                            <!--  With no line on the bill there is nothing to agree a final amount on.  -->
                                            <DataTrigger Binding="{Binding ItemCount}" Value="0">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SumOperator}" Text="+" />
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource SumLabel}" Text="Round off" />
                        <TextBlock Foreground="{StaticResource InkMutedBrush}" Style="{StaticResource SumValue}" Text="{Binding RoundOff, StringFormat=N2, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SumOperator}" Text="=" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="{DynamicResource FontSizeLabel}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="Grand total" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="{StaticResource FontSizeTotal}"
                               FontWeight="Bold"
                               Text="{Binding GrandTotal, StringFormat=₹{0:N0}, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemCount}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource InkDisabledBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Row 4: actions, notes, status and Save  -->
        <Border Grid.Row="4"
                Padding="16,10"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding DataContext.PrintEstimateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource BtnLg}"
                        shell:Kbd.Hint="F9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="15"
                                   Text="&#xE749;" />
                        <TextBlock Margin="9,0,0,0" Text="Print estimate" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Command="{Binding NewBillCommand}"
                        Content="{Binding NewBillLabel}"
                        Style="{StaticResource BtnLg}"
                        shell:Kbd.Hint="Ctrl+Shift+N" />
                <TextBox Grid.Column="2"
                         Height="38"
                         Margin="10,0,14,0"
                         Padding="12,0"
                         shell:FieldAdorn.Placeholder="Narration or notes for this bill (optional)"
                         Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="3"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{Binding StatusTone, Converter={StaticResource DotToBrushConverter}}" />
                    <TextBlock MaxWidth="260"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeLabel}"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}" />
                </StackPanel>
                <Button x:Name="SaveButton"
                        Grid.Column="4"
                        MinWidth="176"
                        Command="{Binding SaveDraftCommand}"
                        Content="Save bill"
                        Style="{StaticResource BtnPrimaryLg}"
                        shell:Kbd.Hint="Ctrl+S" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
