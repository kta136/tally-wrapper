<UserControl x:Class="ShowroomBilling.Desktop.Views.Invoice.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Invoice"
             xmlns:conv="clr-namespace:ShowroomBilling.Desktop.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BgPanelBrush}"
             d:DataContext="{d:DesignInstance Type=vm:InvoiceViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <conv:OneBasedIndexConverter x:Key="OneBasedIndex" />
        <conv:DecimalIsPositiveConverter x:Key="DecimalIsPositive" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="FieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <!--  Row-cell text input: flat, fills cell  -->
        <Style x:Key="CellTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="{DynamicResource RowHeight}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CellNumBox" TargetType="TextBox" BasedOn="{StaticResource CellTextBox}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <EventSetter Event="PreviewMouseDoubleClick" Handler="OnNumericBoxDoubleClick" />
        </Style>
        <Style x:Key="CellCombo" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="{DynamicResource RowHeight}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeUi}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTok}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        </Style>
        <Style x:Key="BodyCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="{DynamicResource RowHeight}" />
        </Style>
        <Style x:Key="EntryRowGrid" TargetType="Grid">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PickerListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DefaultFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Padding="14,8"
                Background="{DynamicResource EditBannerSoftBrush}"
                BorderBrush="{DynamicResource EditBannerBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsEditingPosted, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource EditBannerInkBrush}"
                       TextWrapping="Wrap"
                       Text="Editing a previously-posted bill. Saving moves it back to pending and re-queues the new revision to Tally." />
        </Border>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!--  Main pane  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header fields  -->
            <Border Grid.Row="0"
                    Padding="14,10"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushTok}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" MinWidth="170" />
                        <ColumnDefinition Width="0.9*" MinWidth="120" />
                        <ColumnDefinition Width="0.9*" MinWidth="130" />
                        <ColumnDefinition Width="1*" MinWidth="120" />
                        <ColumnDefinition Width="1.4*" MinWidth="210" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Style="{StaticResource FieldPanel}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="INVOICE #" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="auto" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                        <TextBox IsReadOnly="True"
                                 FontFamily="{DynamicResource MonoFontFamily}"
                                 Text="{Binding InvoiceNumber}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Style="{StaticResource FieldPanel}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="DATE" />
                        <DatePicker SelectedDate="{Binding BillDateLocal, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Style="{StaticResource FieldPanel}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="PAYMENT" />
                        <ComboBox ItemsSource="{Binding PaymentOptions}"
                                  SelectedItem="{Binding Payment}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Style="{StaticResource FieldPanel}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="24KT RATE (₹/G)" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="F2" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="Rate24KtBox"
                                 FontFamily="{DynamicResource MonoFontFamily}"
                                 PreviewMouseDoubleClick="OnNumericBoxDoubleClick"
                                 PreviewKeyDown="OnRate24KtPreviewKeyDown"
                                 Text="{Binding Rate24Kt, StringFormat=N0, TargetNullValue='', UpdateSourceTrigger=LostFocus}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RateMissing}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ErrBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="Background" Value="#1FE53935" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0">
                                <Run Text="PARTY " /><Run Text="*" Foreground="{DynamicResource ErrBrush}" />
                            </TextBlock>
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="F4" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="PartyBox"
                                 PreviewKeyDown="OnPartyBoxPreviewKeyDown"
                                 Text="{Binding PartyName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Toolbar  -->
            <Border Grid.Row="1"
                    Padding="14,6"
                    Background="{DynamicResource BgSunkenBrush}"
                    BorderBrush="{DynamicResource BorderBrushTok}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LINE ITEMS" Style="{StaticResource TxtSectionTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnSm}" Command="{Binding AddRowCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+ Add Row" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                    <TextBlock Text="Ctrl+N" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnSm}"
                                Margin="6,0,0,0"
                                Command="{Binding RemoveFocusedRowCommand}"
                                Visibility="{Binding HasMultipleRows, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="− Remove" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                    <TextBlock Text="Ctrl+Del" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1"
                                   Height="18"
                                   Margin="10,0"
                                   Fill="{DynamicResource DividerBrush}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeXs}"
                                   Foreground="{DynamicResource InkSoftBrush}"
                                   Text="Tab next field · Enter next row · ↑↓ move" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Line-item table  -->
            <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header row  -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="115" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="#" /></Border>
                            <Border Grid.Column="1" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="ITEM / STOCK NAME" /></Border>
                            <Border Grid.Column="2" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="GROSS WT" TextAlignment="Right" ToolTip="Gross weight" /></Border>
                            <Border Grid.Column="3" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="LESS WT" TextAlignment="Right" ToolTip="Deduction (stones, etc). Net = Gross − Less." /></Border>
                            <Border Grid.Column="4" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="UNIT" /></Border>
                            <Border Grid.Column="5" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="KARAT" /></Border>
                            <Border Grid.Column="6" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="WASTAGE %" TextAlignment="Right" /></Border>
                            <Border Grid.Column="7" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="LABOUR" TextAlignment="Right" /></Border>
                            <Border Grid.Column="8" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="DIAMOND RATE" TextAlignment="Right" ToolTip="Flat rate for diamond-category items (GST-inclusive). Ignored for gold lines." /></Border>
                            <Border Grid.Column="9" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="EXTRA" TextAlignment="Right" /></Border>
                            <Border Grid.Column="10" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="EFF. RATE" TextAlignment="Right" ToolTip="GST-inclusive effective rate per V1 formula" /></Border>
                            <Border Grid.Column="11" Style="{StaticResource HeaderCell}"><TextBlock Style="{StaticResource HeaderText}" Text="LINE TOTAL" TextAlignment="Right" ToolTip="GST-inclusive line total" /></Border>
                            <Border Grid.Column="12" Style="{StaticResource HeaderCell}" />
                        </Grid>

                        <!--  Body  -->
                        <ItemsControl Grid.Row="1"
                                      x:Name="LinesItems"
                                      ItemsSource="{Binding Lines}"
                                      AlternationCount="1000"
                                      Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource EntryRowGrid}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" MinWidth="200" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource BodyCell}">
                                            <TextBlock Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                       Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndex}}" />
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource BodyCell}">
                                            <ComboBox Style="{StaticResource CellCombo}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      StaysOpenOnEdit="True"
                                                      DisplayMemberPath="Name"
                                                      TextSearch.TextPath="Name"
                                                      ItemsSource="{Binding DataContext.ItemMasters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding ItemMaster, Mode=TwoWay}"
                                                      Text="{Binding ItemName, UpdateSourceTrigger=LostFocus}" />
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource BodyCell}">
                                            <TextBox Style="{StaticResource CellNumBox}"
                                                     ToolTip="Gross weight"
                                                     Text="{Binding GrossWeight, TargetNullValue='', StringFormat=N3, UpdateSourceTrigger=LostFocus}" />
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource BodyCell}">
                                            <TextBox IsEnabled="{Binding IsGoldLine}"
                                                     ToolTip="Deduction (stones, etc). Net weight = Gross − Less."
                                                     Text="{Binding LessWeight, TargetNullValue='', StringFormat=N3, UpdateSourceTrigger=LostFocus}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CellNumBox}">
                                                        <Style.Triggers>
                                                            <!--  Active deduction renders in amber (design's warn-colour cue).  -->
                                                            <DataTrigger Binding="{Binding LessWeight, Converter={StaticResource DecimalIsPositive}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource BodyCell}">
                                            <ComboBox Style="{StaticResource CellCombo}"
                                                      ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Unit}" />
                                        </Border>
                                        <Border Grid.Column="5" Style="{StaticResource BodyCell}">
                                            <ComboBox Style="{StaticResource CellCombo}"
                                                      IsEnabled="{Binding IsGoldLine}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      DisplayMemberPath="Label"
                                                      TextSearch.TextPath="Label"
                                                      ItemsSource="{Binding DataContext.KaratMasters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding KaratMaster, Mode=TwoWay}"
                                                      Text="{Binding Karat, UpdateSourceTrigger=LostFocus}" />
                                        </Border>
                                        <Border Grid.Column="6" Style="{StaticResource BodyCell}">
                                            <TextBox Style="{StaticResource CellNumBox}"
                                                     IsEnabled="{Binding IsGoldLine}"
                                                     Text="{Binding WastagePercent, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                        </Border>
                                        <Border Grid.Column="7" Style="{StaticResource BodyCell}">
                                            <TextBox Style="{StaticResource CellNumBox}"
                                                     IsEnabled="{Binding IsGoldLine}"
                                                     Text="{Binding LabourPerUnit, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                        </Border>
                                        <Border Grid.Column="8" Style="{StaticResource BodyCell}">
                                            <TextBox IsEnabled="{Binding IsDiamond}"
                                                     ToolTip="Flat diamond rate (GST-inclusive). Only used when item category is diamond."
                                                     Text="{Binding DiamondRate, TargetNullValue='', StringFormat=N0, UpdateSourceTrigger=LostFocus}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CellNumBox}">
                                                        <Style.Triggers>
                                                            <!--  Active diamond rate renders in indigo (design's accent-colour cue).  -->
                                                            <DataTrigger Binding="{Binding DiamondRate, Converter={StaticResource DecimalIsPositive}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Border>
                                        <Border Grid.Column="9" Style="{StaticResource BodyCell}">
                                            <TextBox Style="{StaticResource CellNumBox}"
                                                     Text="{Binding Extra, TargetNullValue='', UpdateSourceTrigger=LostFocus}" />
                                        </Border>
                                        <Border Grid.Column="10" Style="{StaticResource BodyCell}">
                                            <StackPanel Margin="10,0"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock TextAlignment="Right"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           Text="{Binding EffectiveRate, StringFormat=N0, TargetNullValue=''}" />
                                                <!--  Net-weight subtitle (only shown when net wt > 0); matches design's two-line eff-rate cell.  -->
                                                <TextBlock TextAlignment="Right"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource InkSoftBrush}"
                                                           Visibility="{Binding NetWeight, Converter={StaticResource DecimalIsPositive}}">
                                                    <Run Text="{Binding NetWeight, StringFormat=N3, Mode=OneWay}" /><Run Text="g" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="11" Style="{StaticResource BodyCell}">
                                            <TextBlock Margin="10,0"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       TextAlignment="Right"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding LineTotal, StringFormat=N2, TargetNullValue=''}" />
                                        </Border>
                                        <Border Grid.Column="12" Style="{StaticResource BodyCell}">
                                            <!--  Per-row remove (only on rows with content). Mirrors design's `×` ghost button.  -->
                                            <Button Style="{StaticResource BtnGhost}"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    FontSize="14"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Remove row"
                                                    Content="×"
                                                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!--  Footer: narration + totals  -->
            <Border Grid.Row="3"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushTok}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrushTok}"
                            BorderThickness="0,0,1,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="NARRATION / NOTES" />
                            <TextBox Height="62"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6"
                                     Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Foreground="{DynamicResource InkMutedBrush}" FontSize="14" FontWeight="Medium">
                                    <Run Text="Items: " /><Run FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding ItemCount}" />
                                </TextBlock>
                                <TextBlock Margin="20,0,0,0" Foreground="{DynamicResource InkMutedBrush}" FontSize="14" FontWeight="Medium">
                                    <Run Text="Total Wt: " /><Run FontFamily="{DynamicResource MonoFontFamily}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Text="{Binding TotalWeight, StringFormat=N3}" /><Run Text="g" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,0,0,0" FontFamily="{DynamicResource MonoFontFamily}" TextAlignment="Right">
                            <Run Text="₹" /><Run Text="{Binding Subtotal, StringFormat=N2, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,0,0" Text="CGST @ 1.5%" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,4,0,0" FontFamily="{DynamicResource MonoFontFamily}" TextAlignment="Right">
                            <Run Text="₹" /><Run Text="{Binding Cgst, StringFormat=N2, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,0,0" Text="SGST @ 1.5%" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="16,4,0,0" FontFamily="{DynamicResource MonoFontFamily}" TextAlignment="Right">
                            <Run Text="₹" /><Run Text="{Binding Sgst, StringFormat=N2, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,0,0" Text="Round Off" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="16,4,0,0" Foreground="{DynamicResource InkMutedBrush}" FontFamily="{DynamicResource MonoFontFamily}" TextAlignment="Right"
                                   Text="{Binding RoundOff, StringFormat=N2, Mode=OneWay}" />
                        <Rectangle Grid.Row="4" Grid.ColumnSpan="2" Height="1" Margin="0,8,0,8" Fill="{DynamicResource DividerBrush}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Grand Total" FontSize="18" FontWeight="Bold" TextAlignment="Right" />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Margin="16,0,0,0"
                                   FontFamily="{DynamicResource MonoFontFamily}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextAlignment="Right">
                            <Run Text="₹" /><Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!--  Actions  -->
            <Border Grid.Row="4"
                    Padding="14,8"
                    Background="{DynamicResource BgSunkenBrush}"
                    BorderBrush="{DynamicResource BorderBrushTok}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnBase}" Command="{Binding PrintPreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Print Estimate" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                    <TextBlock Text="F9" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnBase}" Margin="6,0,0,0" Command="{Binding ClearCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Clear / Cancel" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                    <TextBlock Text="Esc Esc" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Border Margin="14,0,0,0" Width="1" Background="{DynamicResource DividerBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <CheckBox VerticalAlignment="Center"
                                      IsChecked="{Binding DiscountEnabled}">
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="6,0,0,0" Text="DISC" />
                            </CheckBox>
                            <TextBlock Margin="8,0,6,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource MonoFontFamily}"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       Text="=" />
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,2,0"
                                       Foreground="{DynamicResource ErrBrush}"
                                       Text="− ₹" />
                            <TextBox Width="80"
                                     Padding="4,0"
                                     Height="22"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     FontFamily="{DynamicResource MonoFontFamily}"
                                     Foreground="{DynamicResource ErrBrush}"
                                     IsEnabled="{Binding DiscountEnabled}"
                                     Text="{Binding Discount, StringFormat=N0, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       Text="{Binding DiscountPercentHint}" />
                        </StackPanel>
                        <TextBlock Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   Text="{Binding SaveStatus}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Grand " Foreground="{DynamicResource InkMutedBrush}" />
                            <TextBlock FontFamily="{DynamicResource MonoFontFamily}"
                                       FontSize="13"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="{Binding GrandTotal, StringFormat=₹{0:N0}, Mode=OneWay}" />
                        </StackPanel>
                        <Button x:Name="SaveButton"
                                Style="{StaticResource BtnPrimary}"
                                MinWidth="160"
                                Command="{Binding SaveDraftCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Save" VerticalAlignment="Center" />
                                <Border Style="{StaticResource KbdHintOnPrimary}" Margin="8,0,0,0">
                                    <TextBlock Text="Ctrl+S" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  Side picker (stub for next pass)  -->
        <Border Grid.Column="1"
                Background="{DynamicResource BgSunkenBrush}"
                BorderBrush="{DynamicResource BorderBrushTok}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="10,8">
                    <Grid>
                        <TextBlock Text="QUICK ADD" Style="{StaticResource TxtSectionTitle}" />
                        <Border Style="{StaticResource KbdHint}" HorizontalAlignment="Right">
                            <TextBlock Text="F3" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                        </Border>
                    </Grid>
                    <TextBox x:Name="QuickAddBox"
                             Margin="0,6,0,0"
                             Text="{Binding QuickAddQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnQuickAddBoxPreviewKeyDown" />
                </StackPanel>
                <ListBox x:Name="QuickAddList"
                         Grid.Row="1"
                         Margin="0,4,0,0"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource PickerListBoxItem}"
                         ItemsSource="{Binding QuickAddResults}"
                         SelectedItem="{Binding QuickAddSelection, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="OnQuickAddListPreviewKeyDown"
                         PreviewMouseLeftButtonUp="OnQuickAddListClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{DynamicResource FontSizeUi}"
                                           FontWeight="Medium" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2"
                        Padding="10,8"
                        Background="{DynamicResource BgPanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushTok}"
                        BorderThickness="0,1,0,0">
                    <TextBlock Foreground="{DynamicResource InkMutedBrush}" FontSize="10.5" Text="Click to add · F3 focus" />
                </Border>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</UserControl>
