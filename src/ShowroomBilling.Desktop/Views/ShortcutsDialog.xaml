<UserControl x:Class="ShowroomBilling.Desktop.Views.ShortcutsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="KbdRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="KbdGroupHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <!--  Scrim + dialog  -->
    <Grid Background="{StaticResource DialogScrimBrush}">
        <Border Style="{StaticResource DialogPanel}"
                Width="620"
                MaxHeight="520">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource TxtPageTitle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource BtnGhost}"
                                Width="28"
                                Height="24"
                                Padding="0"
                                ToolTip="Close (Esc)"
                                Command="{Binding CloseDialogCommand}"
                                Content="✕" />
                    </Grid>
                </Border>

                <!--  Body  -->
                <ScrollViewer Grid.Row="1"
                              Padding="16,12"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left column: Navigation  -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource KbdGroupHeader}">
                                <TextBlock Text="NAVIGATION" Style="{StaticResource TxtSectionTitle}" />
                            </Border>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Go to Invoice" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Ctrl+1" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Go to Bills" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Ctrl+2" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Go to Settings" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Ctrl+3" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Open Shortcuts" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="?" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Close dialog / cancel" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Esc" />
                            </Grid>
                        </StackPanel>

                        <!--  Right column: Invoice entry  -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource KbdGroupHeader}">
                                <TextBlock Text="INVOICE ENTRY" Style="{StaticResource TxtSectionTitle}" />
                            </Border>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edit rate" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="F2" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item picker" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="F3" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pick party" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="F4" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Print estimate" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="F9" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Save bill" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Ctrl+S" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="New row" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Ctrl+N" />
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Remove row" />
                                <ContentControl Grid.Column="1" Style="{StaticResource Kbd}" FontSize="10" Content="Ctrl+Del" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!--  Footer  -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding CloseDialogCommand}" Content="Close" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
