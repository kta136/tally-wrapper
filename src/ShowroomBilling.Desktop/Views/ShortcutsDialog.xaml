<UserControl x:Class="ShowroomBilling.Desktop.Views.ShortcutsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="KbdRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="KbdGroupHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <!--  Scrim + dialog  -->
    <Grid Background="#61152238">
        <Border Style="{StaticResource Panel}"
                Width="620"
                MaxHeight="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.22" ShadowDepth="6" Color="#0F172A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="Keyboard Shortcuts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource BtnGhost}"
                                Width="28"
                                Height="24"
                                Padding="0"
                                ToolTip="Close (Esc)"
                                Command="{Binding CloseDialogCommand}"
                                Content="✕" />
                    </Grid>
                </Border>

                <!--  Body  -->
                <ScrollViewer Grid.Row="1"
                              Padding="16,12"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left column: Navigation  -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource KbdGroupHeader}">
                                <TextBlock Text="NAVIGATION" Style="{StaticResource TxtSectionTitle}" />
                            </Border>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Go to Invoice" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Ctrl+1" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Go to Bills" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Ctrl+2" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Go to Settings" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Ctrl+3" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Open Shortcuts" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="?" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Close dialog / cancel" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Esc" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                        </StackPanel>

                        <!--  Right column: Invoice entry  -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource KbdGroupHeader}">
                                <TextBlock Text="INVOICE ENTRY" Style="{StaticResource TxtSectionTitle}" />
                            </Border>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Edit rate" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="F2" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Item picker" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="F3" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pick party" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="F4" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Print invoice" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="F9" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Save &amp; post" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Ctrl+S" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="New row" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Ctrl+N" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                            <Grid Style="{StaticResource KbdRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Remove row" />
                                <Border Grid.Column="1" Style="{StaticResource KbdHint}"><TextBlock Text="Ctrl+Del" FontFamily="{DynamicResource MonoFontFamily}" FontSize="10" /></Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!--  Footer  -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BgSunkenBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding CloseDialogCommand}" Content="Close" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
