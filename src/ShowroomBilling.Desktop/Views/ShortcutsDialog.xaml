<UserControl x:Class="ShowroomBilling.Desktop.Views.ShortcutsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <UserControl.Resources>
        <!--  One line: the action on the left, its keys on the right, a hairline under it.  -->
        <DataTemplate x:Key="ShortcutRowTemplate" DataType="{x:Type shell:ShortcutRow}">
            <Border Height="38"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock x:Name="lock"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="12"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Text="&#xE72E;"
                                   Visibility="Collapsed" />
                        <TextBlock Text="{Binding Action}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Keys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Margin="4,0,0,0"
                                                Content="{Binding}"
                                                Style="{StaticResource KbdLg}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding AdminOnly}" Value="True">
                    <Setter TargetName="lock" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  The heading of a column: indigo, with a stronger hairline under it.  -->
        <Style x:Key="ShortcutColumnTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <shell:DialogFrame CloseCommand="{Binding CloseDialogCommand}"
                       PanelWidth="880"
                       Title="Keyboard shortcuts">
        <shell:DialogFrame.Subtitle>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Press " />
                <ContentControl Margin="0,0,4,0" Content="?" Style="{StaticResource Kbd}" />
                <TextBlock Text="at any time to open this list." />
            </StackPanel>
        </shell:DialogFrame.Subtitle>
        <shell:DialogFrame.FooterNote>
            <TextBlock Text="The same keys are shown in the bar at the bottom of each screen." />
        </shell:DialogFrame.FooterNote>
        <shell:DialogFrame.Footer>
            <Button Command="{Binding CloseDialogCommand}"
                    Content="Close"
                    Style="{StaticResource BtnPrimary}" />
        </shell:DialogFrame.Footer>

        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Padding="0,0,0,8"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource ShortcutColumnTitle}" Text="Move around" />
                </Border>
                <ItemsControl ItemTemplate="{StaticResource ShortcutRowTemplate}" ItemsSource="{x:Static shell:ShortcutCatalog.MoveAround}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Padding="0,0,0,8"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource ShortcutColumnTitle}" Text="Invoice entry" />
                </Border>
                <ItemsControl ItemTemplate="{StaticResource ShortcutRowTemplate}" ItemsSource="{x:Static shell:ShortcutCatalog.InvoiceEntry}" />
            </StackPanel>

            <StackPanel Grid.Column="4">
                <Border Padding="0,0,0,8"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Style="{StaticResource ShortcutColumnTitle}" Text="Bills" />
                </Border>
                <ItemsControl ItemTemplate="{StaticResource ShortcutRowTemplate}" ItemsSource="{x:Static shell:ShortcutCatalog.Bills}" />
            </StackPanel>
        </Grid>
    </shell:DialogFrame>
</UserControl>
