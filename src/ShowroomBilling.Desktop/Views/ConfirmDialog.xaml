<UserControl x:Class="ShowroomBilling.Desktop.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource DialogScrimBrush}">
        <Border Style="{StaticResource DialogPanel}"
                Width="460"
                DataContext="{Binding ConfirmDialog}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16,12"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                </Border>

                <!--  A warning shows its message in the warn banner; a plain question shows it bare.  -->
                <Border Grid.Row="1" Margin="16,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="3" />
                                    <Setter Property="Padding" Value="10,8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding MessageText}"
                               FontSize="{DynamicResource FontSizeUi}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Style="{StaticResource BtnBase}"
                                Margin="0,0,8,0"
                                Command="{Binding CancelCommand}" />
                        <Button x:Name="ConfirmButton"
                                Content="{Binding ConfirmText}"
                                Style="{StaticResource BtnPrimary}"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
