<UserControl x:Class="ShowroomBilling.Desktop.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <!--  A yes/no question: a round icon, the question, one sentence of detail and, when the answer
          is hard to take back, a banner with the line to read twice. Cancel is the focused button
          for a warning, so a stray Enter does not go ahead.  -->
    <shell:DialogFrame BodyPadding="22,22,22,22"
                       DataContext="{Binding ConfirmDialog}"
                       PanelWidth="480"
                       ShowHeader="False">
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        shell:Kbd.Hint="Esc" />
                <Button x:Name="ConfirmButton"
                        Margin="10,0,0,0"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText}"
                        Style="{StaticResource BtnPrimary}"
                        Visibility="{Binding IsDestructive, Converter={StaticResource InverseBoolToVis}}" />
                <Button x:Name="DestroyButton"
                        Margin="10,0,0,0"
                        Command="{Binding ConfirmCommand}"
                        Content="{Binding ConfirmText}"
                        Style="{StaticResource BtnDangerFilled}"
                        Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </shell:DialogFrame.Footer>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="36"
                    Height="36"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    CornerRadius="18">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource IconFontFamily}"
                           FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Text" Value="&#xE897;" />
                            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                    <Setter Property="Text" Value="&#xE74D;" />
                                    <Setter Property="Foreground" Value="{StaticResource ErrTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource TxtDialogTitle}"
                           Text="{Binding TitleText}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource InkMutedBrush}"
                           Text="{Binding MessageText}"
                           TextWrapping="Wrap" />
                <Border Margin="0,14,0,0"
                        Padding="14,9"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource ErrBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding NoteText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource InfoInkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>
    </shell:DialogFrame>
</UserControl>
