<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.ReasonPromptDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="#61152238">
        <Border Style="{StaticResource Panel}"
                Width="420"
                MaxHeight="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                DataContext="{Binding ReasonPromptDialog}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.22" ShadowDepth="6" Color="#0F172A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="16,12"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding TitleText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                </Border>

                <Border Grid.Row="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding MessageText}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource InkBrush}" />
                        <TextBox x:Name="ReasonBox"
                                 Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,10,0,0"
                                 MinHeight="58"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="8,6" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   Text="{Binding HintText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource BtnBase}"
                                Margin="0,0,8,0"
                                Command="{Binding CancelCommand}" />
                        <Button Content="OK"
                                Style="{StaticResource BtnPrimary}"
                                IsDefault="True"
                                Command="{Binding OkCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
