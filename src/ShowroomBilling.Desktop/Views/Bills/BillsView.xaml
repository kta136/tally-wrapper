<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.BillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Bills"
             mc:Ignorable="d"
             Background="{DynamicResource BgPanelBrush}"
             d:DataContext="{d:DesignInstance Type=vm:BillsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PrevPageCommand}" />
        <KeyBinding Key="Enter"
                    Command="{Binding DataContext.OpenBillDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <!--
            Bare "P" used to push selected bills — routed up from TextBox focus
            and could fire mid-typing in a filter. Removed. Push is available
            via the toolbar button (or the row/context menu).
        -->
        <KeyBinding Key="P"
                    Modifiers="Ctrl"
                    Command="{Binding DataContext.OpenSelectedBillsPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RetrySelectedCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RepostSelectedCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding EditRowCommand}" CommandParameter="{Binding SelectedRow}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeleteSelectedCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTok}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        </Style>

        <Style x:Key="TileCount" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style x:Key="TileAmount" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="TableHeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTok}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}" />
        </Style>

        <Style x:Key="StateChipBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource NeutralChipBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="pending">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="draft">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="posting">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="posted">
                    <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed">
                    <Setter Property="Background" Value="{DynamicResource ErrSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StateChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="pending">
                    <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="draft">
                    <Setter Property="Foreground" Value="{DynamicResource InfoInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="posting">
                    <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="posted">
                    <Setter Property="Foreground" Value="{DynamicResource OkInkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="failed">
                    <Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BillRowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,10"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrushTok}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource PageTitle}" Text="Bills &amp; Sync History" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding DataContext.OpenBillDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open Details" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="Enter" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding RetrySelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Retry Sync" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="R" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding TallyPushSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Post to Tally" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="P" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding PushAllPendingCommand}"
                            Content="Push All Pending"
                            ToolTip="Push every pending/draft bill to Tally, oldest first. Stops on the first failure." />
                    <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding RepostSelectedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Repost" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="Shift+P" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}"
                            Margin="0,0,6,0"
                            Command="{Binding EditRowCommand}"
                            CommandParameter="{Binding SelectedRow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Edit" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="E" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnSm}"
                            Command="{Binding DataContext.OpenSelectedBillsPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Print" />
                            <Border Style="{StaticResource KbdHint}" Margin="6,0,0,0">
                                <TextBlock Text="Ctrl+P" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="14,10,14,0">
            <Border Style="{StaticResource TileBorder}" Margin="0,0,8,0">
                <Grid>
                    <Rectangle Width="3" Fill="{DynamicResource InfoBrush}" HorizontalAlignment="Left" Margin="-12,-8,0,-8" />
                    <Grid Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TileLabel}" Text="TOTAL BILLS" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TileCount}" Text="{Binding CountTotal}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileAmount}">
                            <Run Text="₹" /><Run Text="{Binding AmountTotal, StringFormat=N0}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource TileBorder}" Margin="0,0,8,0">
                <Grid>
                    <Rectangle Width="3" Fill="{DynamicResource OkBrush}" HorizontalAlignment="Left" Margin="-12,-8,0,-8" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TileLabel}" Text="POSTED TO TALLY" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TileCount}" Foreground="{DynamicResource OkBrush}" Text="{Binding CountPosted}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileAmount}">
                            <Run Text="₹" /><Run Text="{Binding AmountPosted, StringFormat=N0}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource TileBorder}" Margin="0,0,8,0">
                <Grid>
                    <Rectangle Width="3" Fill="{DynamicResource WarnBrush}" HorizontalAlignment="Left" Margin="-12,-8,0,-8" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TileLabel}" Text="PENDING SYNC" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TileCount}" Foreground="{DynamicResource WarnBrush}" Text="{Binding CountPending}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileAmount}">
                            <Run Text="₹" /><Run Text="{Binding AmountPending, StringFormat=N0}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource TileBorder}">
                <Grid>
                    <Rectangle Width="3" Fill="{DynamicResource ErrBrush}" HorizontalAlignment="Left" Margin="-12,-8,0,-8" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TileLabel}" Text="FAILED" />
                        <TextBlock Grid.Row="1" Style="{StaticResource TileCount}" Foreground="{DynamicResource ErrBrush}" Text="{Binding CountFailed}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TileAmount}">
                            <Run Text="₹" /><Run Text="{Binding AmountFailed, StringFormat=N0}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Padding="14,10"
                Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrushTok}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource InkMutedBrush}" Text="State" />
                    <ComboBox Width="150"
                              Height="26"
                              FontSize="11.5"
                              ItemsSource="{Binding StateFilterOptions}"
                              SelectedItem="{Binding StateFilter}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource InkMutedBrush}" Text="From" />
                    <DatePicker Width="124" Height="26" SelectedDate="{Binding FromDate}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource InkMutedBrush}" Text="→" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource InkMutedBrush}" Text="To" />
                    <DatePicker Width="124" Height="26" SelectedDate="{Binding ToDate}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding RefreshCommand}" Content="Apply" />
                    <Button Style="{StaticResource BtnSm}" Command="{Binding ClearFiltersCommand}" Content="Clear" />
                </StackPanel>
                <CheckBox Grid.Column="5"
                          Margin="14,0,0,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          IsChecked="{Binding HideFullyPostedDays, Mode=TwoWay}"
                          Foreground="{DynamicResource InkMutedBrush}"
                          ToolTip="Hide date groups in which every bill is already posted to Tally. Leaves only days that still have unposted work.">
                    <TextBlock Text="Hide fully posted days" Foreground="{DynamicResource InkMutedBrush}" />
                </CheckBox>
                <TextBlock Grid.Column="6"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource InkSoftBrush}">
                    <Run Text="Showing " />
                    <Run FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}" Text="{Binding Showing, Mode=OneWay}" />
                    <Run Text=" of " />
                    <Run FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}" Text="{Binding Total, Mode=OneWay}" />
                    <Run Text=" bills" />
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="14,6"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource BorderBrushTok}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsSelectionBarVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}">
                    <TextBlock Text="{Binding SelectionSummaryText}"
                               FontFamily="{DynamicResource MonoFontFamily}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <Button Style="{StaticResource BtnSm}" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" Content="Clear" />
                <Rectangle Width="1" Height="18" Margin="10,0" Fill="{DynamicResource DividerBrush}" />
                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding RetrySelectedCommand}" Content="Retry All" />
                <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding TallyPushSelectedCommand}" Content="{Binding TallyPushButtonLabel}" />
                <Button Style="{StaticResource BtnSm}"
                        Margin="0,0,6,0"
                        Command="{Binding DataContext.OpenSelectedBillsPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Content="Print" />
                <!--  Delete is server-side admin-gated; hide it when locked so the operator sees only actions they can actually run.  -->
                <Button Style="{StaticResource BtnDanger}"
                        Command="{Binding DeleteSelectedCommand}"
                        Visibility="{Binding IsAdminUnlocked, Converter={StaticResource BoolToVis}}"
                        Content="Delete Selected" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource BgPanelBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="{DynamicResource BgSunkenBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="142" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource TableHeaderBorder}">
                        <CheckBox HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AreAllVisibleSelected, Mode=TwoWay}" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="INVOICE #" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="STATUS" />
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="PARTY" />
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="AMOUNT" TextAlignment="Right" />
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="BILL DATE" />
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="UPDATED" />
                    </Border>
                    <Border Grid.Column="7" Style="{StaticResource TableHeaderBorder}">
                        <TextBlock Style="{StaticResource TableHeaderText}" Text="LAST ERROR / NOTE" />
                    </Border>
                </Grid>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding GroupedItems}"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource BillRowContainer}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSunkenBrush}"
                                            BorderBrush="{DynamicResource BorderBrushTok}"
                                            BorderThickness="0,0,0,1"
                                            Padding="14,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="{DynamicResource FontSizeLabel}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource InkSoftBrush}"
                                                           Text="{Binding Name, Converter={StaticResource BillDateGroupHeader}}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource FontSizeXs}"
                                                           Foreground="{DynamicResource InkMutedBrush}">
                                                    <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       FontFamily="{DynamicResource MonoFontFamily}"
                                                       FontSize="{DynamicResource FontSizeLabel}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       Text="{Binding Items, Converter={StaticResource GroupAmountSum}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    MinHeight="{DynamicResource RowHeight}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    MouseLeftButtonUp="OnBillRowClick"
                                    MouseLeftButtonDown="OnBillRowMouseLeftButtonDown"
                                    PreviewMouseRightButtonDown="OnBillRowRightClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BgSelectedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open Details" InputGestureText="Enter" Click="OnOpenDetailsMenuItemClick" />
                                        <MenuItem Header="Edit" InputGestureText="E"
                                                  Visibility="{Binding CanBeEdited, Converter={StaticResource BoolToVis}}"
                                                  Click="OnEditRowMenuItemClick" />
                                        <Separator />
                                        <MenuItem Header="Retry Sync" InputGestureText="R"
                                                  Visibility="{Binding CanBeRetried, Converter={StaticResource BoolToVis}}"
                                                  Click="OnRetryRowMenuItemClick" />
                                        <MenuItem Header="Post to Tally" InputGestureText="P"
                                                  Visibility="{Binding CanBePushed, Converter={StaticResource BoolToVis}}"
                                                  Click="OnPushRowMenuItemClick" />
                                        <MenuItem Header="Repost to Tally" InputGestureText="Shift+P"
                                                  Visibility="{Binding CanBeReposted, Converter={StaticResource BoolToVis}}"
                                                  Click="OnRepostRowMenuItemClick" />
                                        <Separator />
                                        <MenuItem Header="Print" InputGestureText="Ctrl+P" Click="OnPrintRowMenuItemClick" />
                                        <!--
                                            Admin-only (server-side [Authorize(Policy="Admin")]). ContextMenu
                                            lives in a separate visual tree, so we can't walk to the UserControl
                                            directly — the row Border already exposes BillsViewModel via its Tag,
                                            so reach through PlacementTarget.Tag.
                                        -->
                                        <MenuItem Header="Change Bill Number…"
                                                  IsEnabled="{Binding CanChangeNumber}"
                                                  Click="OnChangeNumberRowMenuItemClick"
                                                  Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Mark as Pushed…"
                                                  IsEnabled="{Binding CanMarkPosted}"
                                                  Click="OnMarkPostedRowMenuItemClick"
                                                  ToolTip="Flip the bill to 'posted' without calling Tally. Use when the voucher is already in Tally (manual reconciliation)."
                                                  Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Mark as Pending…"
                                                  IsEnabled="{Binding CanMarkPending}"
                                                  Click="OnMarkPendingRowMenuItemClick"
                                                  ToolTip="Revert a posted/failed bill to 'pending'. Doesn't touch Tally."
                                                  Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                        <Separator />
                                        <MenuItem Header="Delete Local…"
                                                  IsEnabled="{Binding CanBeDeleted}"
                                                  Click="OnDeleteRowMenuItemClick"
                                                  Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="142" />
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Selection accent stripe (3 px, left edge of row, indigo).
                                          Mirrors the design's `.selected` row treatment.  -->
                                    <Rectangle Grid.Column="0"
                                               Width="3"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Stretch"
                                               Fill="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                    <CheckBox Grid.Column="0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                    <TextBlock Grid.Column="1"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource MonoFontFamily}"
                                               FontWeight="SemiBold"
                                               Text="{Binding InvoiceNumberDisplay}" />

                                    <Border Grid.Column="2" Style="{StaticResource StateChipBorder}">
                                        <TextBlock Style="{StaticResource StateChipText}" Text="{Binding StateChipLabel}" />
                                    </Border>

                                    <TextBlock Grid.Column="3"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding PartyName}" />

                                    <TextBlock Grid.Column="4"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               FontFamily="{DynamicResource MonoFontFamily}"
                                               FontWeight="SemiBold">
                                        <Run Text="₹" />
                                        <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Grid.Column="5"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource MonoFontFamily}"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Text="{Binding BillDate, StringFormat='yyyy-MM-dd', TargetNullValue='—'}" />

                                    <TextBlock Grid.Column="6"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource MonoFontFamily}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Text="{Binding UpdatedAtUtc, StringFormat='yyyy-MM-dd HH:mm'}" />

                                    <TextBlock Grid.Column="7"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               Text="{Binding RowNote}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Padding="14,6"
                Background="{DynamicResource BgSunkenBrush}"
                BorderBrush="{DynamicResource BorderBrushTok}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource InkSoftBrush}">
                    <Run Text="Showing " />
                    <Run FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}" Text="{Binding Showing, Mode=OneWay}" />
                    <Run Text=" of " />
                    <Run FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource InkBrush}" Text="{Binding Total, Mode=OneWay}" />
                    <Run Text=" bills · Right-click row for actions" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!--  Change Bill Number is admin-only server-side; hide when locked.  -->
                    <Button Style="{StaticResource BtnGhost}"
                            Margin="0,0,12,0"
                            Command="{Binding ChangeNumberRowCommand}"
                            CommandParameter="{Binding SelectedRow}"
                            Visibility="{Binding IsAdminUnlocked, Converter={StaticResource BoolToVis}}"
                            Content="Change Bill Number" />
                    <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding PrevPageCommand}" Content="‹ Prev" />
                    <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Command="{Binding NextPageCommand}" Content="Next ›" />
                    <Button Style="{StaticResource BtnSm}" Command="{Binding RefreshCommand}" Content="Refresh" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
