<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.BillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Bills"
             mc:Ignorable="d"
             Background="{StaticResource BgPanelBrush}"
             d:DataContext="{d:DesignInstance Type=vm:BillsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PrevPageCommand}" />
        <KeyBinding Key="Enter"
                    Command="{Binding DataContext.OpenBillDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="P"
                    Modifiers="Ctrl"
                    Command="{Binding DataContext.OpenSelectedBillsPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RetrySelectedCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RepostSelectedCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding EditRowCommand}" CommandParameter="{Binding SelectedRow}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeleteSelectedCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!--  The eight columns of the list. Party and the note share what is left, the note a little more.  -->
        <GridLength x:Key="ColCheck">48</GridLength>
        <GridLength x:Key="ColInvoice">172</GridLength>
        <GridLength x:Key="ColState">138</GridLength>
        <GridLength x:Key="ColAmount">130</GridLength>
        <GridLength x:Key="ColBillDate">130</GridLength>
        <GridLength x:Key="ColUpdated">150</GridLength>

        <Style x:Key="HeadCell" BasedOn="{StaticResource TableHeaderText}" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  A count of bills that wait on the operator, in the colour of what it counts.  -->
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="BillRowContainer" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The small grey label that heads the admin-only group of the row menu.  -->
        <Style x:Key="MenuGroupLabel" TargetType="MenuItem">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Row 0: title, and a count of what needs doing  -->
        <Grid Grid.Row="0" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Bills &amp; sync history" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{StaticResource InkMutedBrush}"
                           Style="{StaticResource TxtHint}"
                           Text="Bills are saved here first and go to Tally only when you push them." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{StaticResource WarnSoftBrush}"
                        BorderBrush="{StaticResource WarnBorderBrush}"
                        Style="{StaticResource SummaryPill}"
                        Visibility="{Binding HasWaitingForTally, Converter={StaticResource BoolToVis}}">
                    <shell:StateChip Padding="0"
                                     Background="Transparent"
                                     Kind="half"
                                     Label="{Binding WaitingForTallyText}"
                                     Tone="warn" />
                </Border>
                <Border Background="{StaticResource WarnSoftBrush}"
                        BorderBrush="{StaticResource WarnBorderBrush}"
                        Style="{StaticResource SummaryPill}"
                        Visibility="{Binding HasPosting, Converter={StaticResource BoolToVis}}">
                    <shell:StateChip Padding="0"
                                     Background="Transparent"
                                     Kind="half"
                                     Label="{Binding PostingText}"
                                     Tone="warn" />
                </Border>
                <Border Background="{StaticResource ErrSoftBrush}"
                        BorderBrush="{StaticResource ErrBorderBrush}"
                        Style="{StaticResource SummaryPill}"
                        Visibility="{Binding HasNeedAttention, Converter={StaticResource BoolToVis}}">
                    <shell:StateChip Padding="0"
                                     Background="Transparent"
                                     Kind="bang"
                                     Label="{Binding NeedAttentionText}"
                                     Tone="err" />
                </Border>
            </StackPanel>
        </Grid>

        <!--  Row 1: filters  -->
        <Grid Grid.Row="1" Margin="16,0,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="State" />
                <ComboBox ItemsSource="{Binding StateFilterOptions}" SelectedItem="{Binding StateFilter}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Width="184" Margin="14,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="From" />
                <DatePicker shell:FieldAdorn.Placeholder="Any date" SelectedDate="{Binding FromDate}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Margin="12,0,12,6"
                       VerticalAlignment="Bottom"
                       Foreground="{StaticResource InkSoftBrush}"
                       Text="→" />
            <StackPanel Grid.Column="3" Width="158">
                <TextBlock Style="{StaticResource FieldLabel}" Text="To" />
                <DatePicker shell:FieldAdorn.Placeholder="Any date" SelectedDate="{Binding ToDate}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Margin="14,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Search" />
                <TextBox Padding="32,0,10,0"
                         shell:FieldAdorn.Placeholder="Invoice number or party"
                         ToolTip="Search invoice number or party name. Press Enter or click Apply to reload."
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                    <shell:FieldAdorn.Prefix>
                        <TextBlock FontFamily="{StaticResource IconFontFamily}" FontSize="13" Text="&#xE721;" />
                    </shell:FieldAdorn.Prefix>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </StackPanel>
            <StackPanel Grid.Column="5"
                        Margin="12,0,0,0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                <Button Command="{Binding ApplyFiltersCommand}" Content="Apply" MinWidth="66" Style="{StaticResource BtnPrimary}" />
                <Button Margin="10,0,0,0" Command="{Binding ClearFiltersCommand}" Content="Clear" MinWidth="62" />
            </StackPanel>
            <CheckBox Grid.Column="6"
                      Margin="0,0,0,6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Foreground="{StaticResource InkMutedBrush}"
                      IsChecked="{Binding HideFullyPostedDays, Mode=TwoWay}"
                      ToolTip="Hide date groups in which every bill is already posted to Tally. Leaves only days that still have unposted work.">
                <TextBlock Foreground="{StaticResource InkMutedBrush}" Text="Hide fully posted days" />
            </CheckBox>
        </Grid>

        <!--  Row 2: what to do with the selected bills, and the one action for all pending ones  -->
        <Border Grid.Row="2"
                Padding="16,10"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Height="24"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSoftPressedBrush}"
                            CornerRadius="12"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentInkBrush}"
                                   Text="{Binding SelectionSummaryText}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               Text="Select bills to act on them">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource TxtHint}" TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Margin="8,0,0,0"
                            Command="{Binding ClearSelectionCommand}"
                            Content="Clear"
                            Style="{StaticResource BtnGhost}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Width="1" Height="22" Margin="10,0" Fill="{StaticResource BorderBrushTok}" />
                    <Button Command="{Binding DataContext.OpenBillDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Open details"
                            shell:Kbd.Hint="Enter" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding EditRowCommand}"
                            CommandParameter="{Binding SelectedRow}"
                            Content="Edit"
                            shell:Kbd.Hint="Ctrl+Shift+E" />
                    <Button Margin="8,0,0,0" Command="{Binding PushSelectedCommand}" Content="Push to Tally" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding RetrySelectedCommand}"
                            Content="Retry push"
                            shell:Kbd.Hint="Ctrl+R" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding RepostSelectedCommand}"
                            Content="Repost"
                            shell:Kbd.Hint="Ctrl+Shift+R" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding DataContext.OpenSelectedBillsPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="Print"
                            shell:Kbd.Hint="Ctrl+P" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding PushAllPendingCommand}"
                        Style="{StaticResource BtnPrimary}"
                        ToolTip="Push every pending and draft bill to Tally, oldest first. Stops on the first failure.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Push all pending" />
                        <Border Height="18"
                                MinWidth="18"
                                Margin="8,0,0,0"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource OnFilledChipBrush}"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSizeXs}"
                                       FontWeight="SemiBold"
                                       Text="{Binding WaitingForTallyCount}" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  Row 3: admin-only actions, there only while the session is unlocked  -->
        <Border Grid.Row="3"
                Padding="16,10"
                Background="{StaticResource EditBannerSoftBrush}"
                BorderBrush="{StaticResource EditBannerBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsAdminUnlocked, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource EditBannerInkBrush}"
                               Text="&#xE785;" />
                    <TextBlock Margin="8,0,16,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource EditBannerInkBrush}"
                               Text="Admin only" />
                    <Button Command="{Binding ChangeNumberRowCommand}" CommandParameter="{Binding SelectedRow}" Content="Change bill number…" />
                    <Button Margin="8,0,0,0" Command="{Binding MarkPostedSelectedCommand}" Content="Mark as pushed…" />
                    <Button Margin="8,0,0,0" Command="{Binding MarkPendingSelectedCommand}" Content="Mark as pending…" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding DeleteSelectedCommand}"
                        Content="Delete selected"
                        Style="{StaticResource BtnDanger}"
                        shell:Kbd.Hint="Shift+Del" />
            </Grid>
        </Border>

        <!--  Row 4: the list  -->
        <Grid Grid.Row="4" Background="{StaticResource BgPanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="34"
                    Background="{StaticResource BgSunkenBrush}"
                    BorderBrush="{StaticResource BorderBrushTok}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                        <ColumnDefinition Width="{StaticResource ColInvoice}" />
                        <ColumnDefinition Width="{StaticResource ColState}" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="{StaticResource ColAmount}" />
                        <ColumnDefinition Width="{StaticResource ColBillDate}" />
                        <ColumnDefinition Width="{StaticResource ColUpdated}" />
                        <ColumnDefinition Width="1.25*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AreAllVisibleSelected, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="Invoice no." />
                    <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="Status" />
                    <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="Party" />
                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource HeadCell}" Text="Amount" />
                    <TextBlock Grid.Column="5" Style="{StaticResource HeadCell}" Text="Bill date" />
                    <TextBlock Grid.Column="6" Style="{StaticResource HeadCell}" Text="Updated" />
                    <TextBlock Grid.Column="7" Style="{StaticResource HeadCell}" Text="Last error or note" />
                </Grid>
            </Border>

            <!--  A failed load: without this the list is just empty.  -->
            <Border Grid.Row="1"
                    Padding="16,9"
                    Background="{StaticResource ErrSoftBrush}"
                    BorderBrush="{StaticResource ErrBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource ErrInkBrush}"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Bills could not be loaded. " /><Run Text="{Binding LoadError, Mode=OneWay}" />
                    </TextBlock>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}"
                            Content="Try again"
                            Style="{StaticResource BtnSm}" />
                </Grid>
            </Border>

            <ListBox Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource BillRowContainer}"
                     ItemsSource="{Binding GroupedItems}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionMode="Extended"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Height="36"
                                        Padding="16,0"
                                        Background="{StaticResource BgSunkenBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="0,1,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name, Converter={StaticResource BillDateGroupHeader}}" />
                                            <Border Height="20"
                                                    Margin="10,0,0,0"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource NeutralChipBrush}"
                                                    CornerRadius="10">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkMutedBrush}">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text="{Binding ItemCount, Mode=OneWay, Converter={StaticResource CountWord}, ConverterParameter=' bill| bills'}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Items, Converter={StaticResource GroupAmountSum}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                MinHeight="{DynamicResource ListRowHeight}"
                                MouseLeftButtonDown="OnBillRowMouseLeftButtonDown"
                                PreviewMouseRightButtonDown="OnBillRowRightClick"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding PlacementTarget.Tag.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Header="Open details"
                                              InputGestureText="Enter" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.EditRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Edit"
                                              InputGestureText="Ctrl+Shift+E" />
                                    <Separator />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.RetryRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Retry push"
                                              InputGestureText="Ctrl+R"
                                              Visibility="{Binding CanBeRetried, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.PushRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Push to Tally" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.RepostRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Repost to Tally"
                                              InputGestureText="Ctrl+Shift+R"
                                              Visibility="{Binding CanBeReposted, Converter={StaticResource BoolToVis}}" />
                                    <Separator />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.PrintSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Header="Print"
                                              InputGestureText="Ctrl+P" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.CopyInvoiceNumberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Copy invoice number" />
                                    <!--
                                        Admin-only (server-side [Authorize(Policy="Admin")]). A context menu is
                                        a separate visual tree, so the row Border hands BillsViewModel down in
                                        its Tag and these items reach it through PlacementTarget.Tag.
                                    -->
                                    <Separator Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Header="Admin only"
                                              IsEnabled="False"
                                              Style="{StaticResource MenuGroupLabel}"
                                              Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.ChangeNumberRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Change bill number…"
                                              Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.MarkPostedRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Mark as pushed…"
                                              ToolTip="Flip the bill to 'posted' without calling Tally. Use when the voucher is already in Tally (manual reconciliation)."
                                              Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.MarkPendingRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Header="Mark as pending…"
                                              ToolTip="Revert a posted or failed bill to 'pending'. Does not touch Tally."
                                              Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    <Separator Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                    <MenuItem Command="{Binding PlacementTarget.Tag.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              Foreground="{StaticResource ErrTextBrush}"
                                              Header="Delete local…"
                                              Visibility="{Binding PlacementTarget.Tag.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColCheck}" />
                                    <ColumnDefinition Width="{StaticResource ColInvoice}" />
                                    <ColumnDefinition Width="{StaticResource ColState}" />
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="{StaticResource ColAmount}" />
                                    <ColumnDefinition Width="{StaticResource ColBillDate}" />
                                    <ColumnDefinition Width="{StaticResource ColUpdated}" />
                                    <ColumnDefinition Width="1.25*" MinWidth="200" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <TextBlock Grid.Column="1"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding InvoiceNumberDisplay}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <shell:StateChip Grid.Column="2"
                                                 Margin="10,0"
                                                 HorizontalAlignment="Left"
                                                 Kind="{Binding StateKind}"
                                                 Label="{Binding StateChipLabel}"
                                                 Tone="{Binding StateTone}" />

                                <shell:FillCell Grid.Column="3">
                                    <TextBlock Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding PartyName}"
                                               TextTrimming="CharacterEllipsis" />
                                </shell:FillCell>

                                <TextBlock Grid.Column="4"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding GrandTotal, StringFormat=₹{0:N0}, Mode=OneWay}"
                                           TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!--  A voided bill's amount is struck through: it is no longer owed.  -->
                                                <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Column="5"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Text="{Binding BillDate, StringFormat='dd MMM yyyy', TargetNullValue='—'}" />

                                <TextBlock Grid.Column="6"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource InkMutedBrush}"
                                           Text="{Binding UpdatedAtUtc, Converter={StaticResource UtcToLocal}, StringFormat='dd MMM · HH:mm'}" />

                                <TextBlock Grid.Column="7"
                                           Margin="10,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding RowNote}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoteTone}" Value="err">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Margin="28"
                    Padding="18,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource InfoSoftBrush}"
                    BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{StaticResource InfoInkBrush}"
                               Text="Only posted days are hidden" />
                    <TextBlock Margin="0,6,0,12"
                               Foreground="{StaticResource InfoInkBrush}"
                               Text="Turn off Hide fully posted days to show the rows on this page." />
                    <Button HorizontalAlignment="Left"
                            Command="{Binding ShowPostedDaysCommand}"
                            Content="Show posted days" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Row 5: how many are shown, and the pager  -->
        <Border Grid.Row="5"
                Padding="16,10"
                Background="{StaticResource BgSunkenBrush}"
                BorderBrush="{StaticResource BorderBrushTok}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="Showing " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding Showing, Mode=OneWay}" />
                    <Run Text=" of " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding TotalDisplay, Mode=OneWay}" />
                    <Run Text=" bills · " /><Run FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Text="{Binding HiddenByPostedDaysCount, Mode=OneWay}" />
                    <Run Text=" hidden by the posted-day filter · Right-click a row for more actions" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding PrevPageCommand}" Content="‹ Prev" />
                    <Button Margin="8,0,0,0" Command="{Binding NextPageCommand}" Content="Next ›" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            shell:Kbd.Hint="F5" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
