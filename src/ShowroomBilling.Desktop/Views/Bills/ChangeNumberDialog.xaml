<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.ChangeNumberDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <!--  Admin only. The new number is typed as digits; the banner shows the number the bill would
          get, and Change number stays off until the digits are ones the server would accept.  -->
    <shell:DialogFrame CloseCommand="{Binding CancelCommand}"
                       DataContext="{Binding ChangeNumberDialog}"
                       HeaderChips="{StaticResource AdminOnlyChip}"
                       PanelWidth="520"
                       Subtitle="{Binding ContextText}"
                       Title="Change invoice number">
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding CancelCommand}"
                        Content="Cancel"
                        shell:Kbd.Hint="Esc" />
                <Button Margin="10,0,0,0"
                        Command="{Binding OkCommand}"
                        Content="Change number"
                        IsDefault="True"
                        shell:Kbd.Hint="Enter"
                        Style="{StaticResource BtnPrimary}" />
            </StackPanel>
        </shell:DialogFrame.Footer>

        <StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Current number" />
            <TextBox Margin="0,0,0,16"
                     FontWeight="SemiBold"
                     IsReadOnly="True"
                     Text="{Binding CurrentNumberDisplay, Mode=OneWay}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="New number, digits only" />
            <TextBox shell:FocusOnShown.IsEnabled="True"
                     Text="{Binding NewNumberRaw, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource TxtHint}"
                       Text="{Binding HelpText, Mode=OneWay}" />

            <!--  Valid digits: the number the bill would get. Anything else typed: why it will not do.  -->
            <Border Margin="0,12,0,0"
                    Style="{StaticResource AdminBannerOk}"
                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource OkInkBrush}"
                               Text="&#xE73E;" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource OkInkBrush}"
                               shell:RichText.Markup="{Binding PreviewMarkup}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0"
                    Style="{StaticResource AdminBannerWarn}"
                    Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFontFamily}"
                               FontSize="14"
                               Foreground="{StaticResource WarnInkBrush}"
                               Text="&#xE7BA;" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource WarnInkBrush}"
                               Text="{Binding InvalidText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,16,0,5"
                       Style="{StaticResource FieldLabel}"
                       Text="Reason, optional" />
            <TextBox Height="Auto"
                     MinHeight="64"
                     Padding="12,9"
                     VerticalContentAlignment="Stretch"
                     shell:FieldAdorn.Placeholder="Why is the number changing? This goes in the audit log."
                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>
    </shell:DialogFrame>
</UserControl>
