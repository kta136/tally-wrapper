<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.ChangeNumberDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="{StaticResource DialogScrimBrush}">
        <Border Style="{StaticResource DialogPanel}"
                Width="460"
                MaxHeight="520"
                DataContext="{Binding ChangeNumberDialog}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  dialog-head  -->
                <Border Grid.Row="0"
                        Padding="16,12"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="Change Invoice Number"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                </Border>

                <!--  dialog-body  -->
                <Border Grid.Row="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="CURRENT NUMBER" />
                        <TextBox Text="{Binding CurrentNumberDisplay, Mode=OneWay}"
                                 Margin="0,0,0,12"
                                 IsReadOnly="True"
                                 FontFamily="{StaticResource MonoFontFamily}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="NEW NUMBER" />
                        <TextBox shell:FocusOnShown.IsEnabled="True"
                                 Text="{Binding NewNumberRaw, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"
                                 FontFamily="{StaticResource MonoFontFamily}" />
                        <TextBlock Margin="0,0,0,12"
                                   FontSize="{DynamicResource FontSizeSm}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding PreviewText}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="REASON (OPTIONAL)" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="52"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="8,6" />
                    </StackPanel>
                </Border>

                <!--  dialog-foot  -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource BtnBase}"
                                Margin="0,0,8,0"
                                Command="{Binding CancelCommand}" />
                        <Button Content="Change"
                                Style="{StaticResource BtnPrimary}"
                                IsDefault="True"
                                Command="{Binding OkCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
