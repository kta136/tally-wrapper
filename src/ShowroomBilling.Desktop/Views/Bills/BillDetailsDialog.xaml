<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.BillDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Bills"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BillDetailsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.InputBindings>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding DataContext.OpenFinalPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding BillDetails.PushCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding BillDetails.RetryCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding BillDetails.RepostCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="CardTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SummaryLabel" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>
        <Style x:Key="SummaryValue" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TableHead" BasedOn="{StaticResource TableHeaderText}" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="TotalLabel" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
        </Style>
        <Style x:Key="TotalValue" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!--  A timeline entry: a bullet joined to the next one by a line, the title, what happened, and the time.
              The step the bill is waiting for is a ring instead of a dot.  -->
        <DataTemplate x:Key="TimelineEntryTemplate" DataType="{x:Type vm:TimelineEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle x:Name="joint"
                           Width="2"
                           Margin="0,18,13,-4"
                           HorizontalAlignment="Right"
                           Fill="{StaticResource BorderStrongBrush}" />
                <Ellipse x:Name="bullet"
                         Width="12"
                         Height="12"
                         Margin="0,4,8,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{StaticResource TimelineBulletBrush}" />
                <StackPanel Grid.Column="1" Margin="0,0,0,18">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding Detail}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Margin="12,2,0,0"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource InkMutedBrush}"
                           Text="{Binding Time}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter TargetName="joint" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter TargetName="bullet" Property="Fill" Value="{StaticResource BgPanelBrush}" />
                    <Setter TargetName="bullet" Property="Stroke" Value="{StaticResource TimelineBulletBrush}" />
                    <Setter TargetName="bullet" Property="StrokeThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="ok">
                    <Setter TargetName="bullet" Property="Fill" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warn">
                    <Setter TargetName="bullet" Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="err">
                    <Setter TargetName="bullet" Property="Fill" Value="{StaticResource ErrBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <shell:DialogFrame BodyBackground="{StaticResource BgBrush}"
                       BodyPadding="20,18,20,20"
                       CloseCommand="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       DataContext="{Binding BillDetails}"
                       PanelWidth="1000"
                       Title="Bill details">
        <shell:DialogFrame.HeaderChips>
            <shell:StateChip Kind="{Binding StateKind}" Label="{Binding StateChipLabel}" Tone="{Binding StateTone}" />
        </shell:DialogFrame.HeaderChips>
        <shell:DialogFrame.Subtitle>
            <TextBlock FontSize="{DynamicResource FontSizeUi}"
                       Foreground="{StaticResource InkBrush}"
                       Text="{Binding InvoiceNumberDisplay}" />
        </shell:DialogFrame.Subtitle>
        <shell:DialogFrame.FooterNote>
            <TextBlock Text="{Binding FooterText}" TextTrimming="CharacterEllipsis" />
        </shell:DialogFrame.FooterNote>
        <shell:DialogFrame.Footer>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding RetryCommand}"
                        Content="Retry"
                        shell:Kbd.Hint="Ctrl+R"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                <Button Margin="10,0,0,0"
                        Command="{Binding RepostCommand}"
                        Content="Repost"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                <Button Margin="10,0,0,0"
                        Command="{Binding ReviseCommand}"
                        Content="Revise…"
                        Visibility="{Binding CanReviseNow, Converter={StaticResource BoolToVis}}" />
                <Button Margin="10,0,0,0"
                        Command="{Binding VoidCommand}"
                        Content="Void…"
                        Visibility="{Binding CanVoidNow, Converter={StaticResource BoolToVis}}" />
                <Button Margin="10,0,0,0"
                        Command="{Binding DataContext.OpenFinalPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="Print…"
                        shell:Kbd.Hint="Ctrl+P" />
                <Button Margin="10,0,0,0"
                        Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="Close"
                        shell:Kbd.Hint="Esc" />
                <Button Margin="10,0,0,0"
                        Command="{Binding PushCommand}"
                        Content="Post to Tally"
                        shell:Kbd.Hint="Ctrl+S"
                        Style="{StaticResource BtnPrimary}"
                        Visibility="{Binding IsPendingLike, Converter={StaticResource BoolToVis}}" />
                <!--  A posted bill already has its voucher in Tally: a repost can duplicate it, so the button is the red one.  -->
                <Button Margin="10,0,0,0"
                        Command="{Binding RepostCommand}"
                        Content="Repost to Tally"
                        shell:Kbd.Hint="Ctrl+Shift+R"
                        Style="{StaticResource BtnDanger}"
                        ToolTip="Push the current revision to Tally again. The bill is already posted; this will create a duplicate voucher unless the prior voucher was cleared in Tally."
                        Visibility="{Binding IsPosted, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </shell:DialogFrame.Footer>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!--  Summary  -->
                <Border Margin="0,0,0,14" Padding="20,16,20,18" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Summary" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Style="{StaticResource SummaryLabel}" Text="Party" />
                                <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding PartyDisplay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                                <TextBlock Style="{StaticResource SummaryLabel}" Text="Bill date" />
                                <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding Payload.BillDate, StringFormat='dd MMM yyyy', TargetNullValue='—', FallbackValue='—'}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource SummaryLabel}" Text="Fiscal year" />
                                <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding Bill.FiscalYear, TargetNullValue='Assigned on push', FallbackValue='—'}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SummaryLabel}" Text="Created" />
                                <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding Bill.CreatedAtUtc, Converter={StaticResource UtcToLocal}, StringFormat='dd MMM yyyy, HH:mm', TargetNullValue='—', FallbackValue='—'}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource SummaryLabel}" Text="Payment" />
                                <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding PaymentDisplay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Style="{StaticResource SummaryLabel}" Text="24K rate" />
                                <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding Rate24KtDisplay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Line items  -->
                <Border Margin="0,0,0,14" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Margin="20,16,20,12" Style="{StaticResource CardTitle}" Text="Line items" />
                        <Border Background="{StaticResource BgSunkenBrush}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,1">
                            <Grid Height="32" Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TableHead}" Text="Item" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TableHead}" HorizontalAlignment="Right" Text="Net" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TableHead}" Text="Karat" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TableHead}" HorizontalAlignment="Right" Text="Rate" />
                                <TextBlock Grid.Column="4" Style="{StaticResource TableHead}" HorizontalAlignment="Right" Text="Line total" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding LineRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BillDetailsLine}">
                                    <Border Height="38"
                                            Padding="12,0"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <shell:FillCell>
                                                <TextBlock Margin="8,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ItemName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </shell:FillCell>
                                            <TextBlock Grid.Column="1" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Net}" />
                                            <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}" Text="{Binding Karat}" />
                                            <TextBlock Grid.Column="3" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource InkMutedBrush}" Text="{Binding Rate}" />
                                            <TextBlock Grid.Column="4" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding LineTotal}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  Notes and totals  -->
                <Border Padding="20,16,20,18" Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Notes" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       Text="{Binding Payload.Notes, TargetNullValue='No operator notes.', FallbackValue='No operator notes.'}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource TotalLabel}" Text="Subtotal, before GST" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TotalValue}" Text="{Binding SubtotalDisplay}" />
                            <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource TotalLabel}" Text="Tax, CGST + SGST" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource TotalValue}" Text="{Binding TaxDisplay}" />
                            <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource TotalLabel}" Text="Discount" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding DiscountDisplay}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TotalValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="3" Margin="0,6,0,0" Style="{StaticResource TotalLabel}" Text="Round off" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource TotalValue}" Text="{Binding RoundOffDisplay}" />
                            <Rectangle Grid.Row="4" Grid.ColumnSpan="2" Height="1" Margin="0,12,0,12" Fill="{StaticResource BorderStrongBrush}" />
                            <TextBlock Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Grand total" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Style="{StaticResource TotalValue}"
                                       Text="{Binding GrandTotalDisplay}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  Timeline  -->
            <Border Grid.Column="2"
                    Padding="20,16,18,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Timeline" />
                    <ItemsControl Margin="-6,14,0,0"
                                  ItemTemplate="{StaticResource TimelineEntryTemplate}"
                                  ItemsSource="{Binding Timeline}" />
                    <TextBlock Margin="0,0,0,18"
                               Foreground="{StaticResource InkMutedBrush}"
                               Text="{Binding AuditEmptyMessage}"
                               Visibility="{Binding HasAuditTrail, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>
    </shell:DialogFrame>
</UserControl>
