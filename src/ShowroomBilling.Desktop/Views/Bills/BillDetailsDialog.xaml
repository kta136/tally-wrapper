<UserControl x:Class="ShowroomBilling.Desktop.Views.Bills.BillDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ShowroomBilling.Desktop.ViewModels.Bills"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BillDetailsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.InputBindings>
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding DataContext.OpenFinalPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding BillDetails.PushCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding BillDetails.RetryCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding BillDetails.RepostCommand}" />
    </UserControl.InputBindings>

    <Grid Background="#61152238">
        <Border Style="{StaticResource Panel}"
                Width="860"
                MaxHeight="700"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.22" ShadowDepth="6" Color="#0F172A" />
            </Border.Effect>

            <Grid DataContext="{Binding BillDetails}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,14,12,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Bill Details" />
                            <Border Margin="10,0,0,0"
                                    Padding="7,0"
                                    Height="18"
                                    CornerRadius="2"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource NeutralChipBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="pending">
                                                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="draft">
                                                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="posting">
                                                <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="posted">
                                                <Setter Property="Background" Value="{StaticResource OkSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="failed">
                                                <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="reconciliation_required">
                                                <Setter Property="Background" Value="{StaticResource ErrSoftBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Bill.State}" Value="voided">
                                                <Setter Property="Background" Value="{StaticResource NeutralChipBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Text="{Binding Bill.State, TargetNullValue='—'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bill.State}" Value="pending">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Bill.State}" Value="posting">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Bill.State}" Value="posted">
                                                    <Setter Property="Foreground" Value="{StaticResource OkInkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Bill.State}" Value="failed">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Bill.State}" Value="reconciliation_required">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrInkBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Bill.State}" Value="draft">
                                                    <Setter Property="Foreground" Value="{StaticResource InfoInkBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="13"
                                   Text="{Binding InvoiceNumberDisplay}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="28"
                            Height="24"
                            Padding="0"
                            Style="{StaticResource BtnGhost}"
                            ToolTip="Close (Esc)"
                            Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Content="✕" />
                </Grid>

                <Rectangle Grid.Row="0"
                           VerticalAlignment="Bottom"
                           Height="1"
                           Fill="{StaticResource DividerBrush}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TxtSectionTitle}" Text="SUMMARY" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Text="Party" />
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding Payload.PartyName, TargetNullValue='Walk-in Customer'}" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Text="Bill Date" />
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                               Text="{Binding Payload.BillDate, StringFormat='yyyy-MM-dd', TargetNullValue='—'}" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Text="Created" />
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                               Text="{Binding Bill.CreatedAtUtc, StringFormat='yyyy-MM-dd HH:mm', TargetNullValue='—'}" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Text="Fiscal Year" />
                                    <TextBlock FontFamily="{StaticResource MonoFontFamily}"
                                               Text="{Binding Bill.FiscalYear, TargetNullValue='Assigned on push'}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TxtSectionTitle}" Text="LINE ITEMS" />
                                    <Border Margin="0,10,0,0"
                                            BorderBrush="{StaticResource BorderBrushTok}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Background="{StaticResource BgSunkenBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="180" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Margin="10,7" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Text="Item" />
                                                <TextBlock Grid.Column="1" Margin="10,7" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Text="Qty" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Margin="10,7" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Text="Karat" />
                                                <TextBlock Grid.Column="3" Margin="10,7" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Text="Rate" TextAlignment="Right" />
                                                <TextBlock Grid.Column="4" Margin="10,7" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Text="Line Total" TextAlignment="Right" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                                <ColumnDefinition Width="68" />
                                                                <ColumnDefinition Width="78" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="110" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.ColumnSpan="5" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" />
                                                            <TextBlock Grid.Column="0" Margin="10,8" Text="{Binding ItemName}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="10,8"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       Text="{Binding Quantity, StringFormat=N3}"
                                                                       TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Margin="10,8" Text="{Binding Karat, TargetNullValue='—'}" />
                                                            <TextBlock Grid.Column="3"
                                                                       Margin="10,8"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       Text="{Binding Rate, StringFormat=N0}"
                                                                       TextAlignment="Right" />
                                                            <TextBlock Grid.Column="4"
                                                                       Margin="10,8"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding LineTotal, StringFormat=N2}"
                                                                       TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Panel}" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TxtSectionTitle}" Text="NOTES" />
                                        <TextBlock Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   Text="{Binding Payload.Notes, TargetNullValue='No operator notes.'}" />
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Text="Subtotal" Foreground="{StaticResource InkMutedBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource MonoFontFamily}">
                                            <Run Text="₹" />
                                            <Run Text="{Binding Totals.Subtotal, StringFormat=N2, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Text="Tax" Foreground="{StaticResource InkMutedBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" FontFamily="{StaticResource MonoFontFamily}">
                                            <Run Text="₹" />
                                            <Run Text="{Binding Totals.TaxTotal, StringFormat=N2, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Text="Discount" Foreground="{StaticResource InkMutedBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource ErrBrush}">
                                            <Run Text="− ₹" />
                                            <Run Text="{Binding Totals.DiscountTotal, StringFormat=N2, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="3" Margin="0,6,0,0" Text="Round Off" Foreground="{StaticResource InkMutedBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" FontFamily="{StaticResource MonoFontFamily}">
                                            <Run Text="{Binding Totals.RoundOff, StringFormat=N2, Mode=OneWay}" />
                                        </TextBlock>
                                        <Rectangle Grid.Row="4" Grid.ColumnSpan="2" Height="1" Margin="0,10,0,10" Fill="{StaticResource DividerBrush}" />
                                        <TextBlock Grid.Row="5" Text="Grand Total" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="1"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="15"
                                                   FontWeight="Bold">
                                            <Run Text="₹" />
                                            <Run Text="{Binding Totals.GrandTotal, StringFormat=N0, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Panel}" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TxtSectionTitle}" Text="TIMELINE" />
                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding AuditTrail}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#6B7A8C" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="ok">
                                                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="warn">
                                                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="err">
                                                                        <Setter Property="Fill" Value="{StaticResource ErrBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource InkMutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Detail}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Margin="10,0,0,0"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource InkMutedBrush}"
                                                               Text="{Binding TimeText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               Text="{Binding AuditEmptyMessage}"
                                               Visibility="{Binding HasAuditTrail, Converter={StaticResource InverseBoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Padding="14,10"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource InkMutedBrush}"
                                   Text="{Binding StatusMessage}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding RetryCommand}"
                                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                                    Content="Retry" />
                            <!-- Gray Repost is the failed-state secondary action; the red "Repost to Tally" below covers the posted-state path with a duplicate-voucher warning. -->
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding RepostCommand}"
                                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                                    Content="Repost" />
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding ReviseCommand}"
                                    Visibility="{Binding CanReviseNow, Converter={StaticResource BoolToVis}}"
                                    Content="Revise…" />
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding VoidCommand}"
                                    Visibility="{Binding CanVoidNow, Converter={StaticResource BoolToVis}}"
                                    Content="Void…" />
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding DataContext.OpenFinalPrintPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Print…" />
                            <Button Style="{StaticResource BtnBase}"
                                    Margin="0,0,6,0"
                                    Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Close" />
                            <Button Style="{StaticResource BtnPrimary}"
                                    Command="{Binding PushCommand}"
                                    Visibility="{Binding IsPendingLike, Converter={StaticResource BoolToVis}}"
                                    Content="Post to Tally" />
                            <Button Style="{StaticResource BtnDanger}"
                                    Command="{Binding RepostCommand}"
                                    Visibility="{Binding IsPosted, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Push the current revision to Tally again. The bill is already posted; this will create a duplicate voucher unless the prior voucher was cleared in Tally."
                                    Content="Repost to Tally" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
