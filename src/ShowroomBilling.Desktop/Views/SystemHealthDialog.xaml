<UserControl x:Class="ShowroomBilling.Desktop.Views.SystemHealthDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:ShowroomBilling.Desktop.Shell">
    <UserControl.Resources>
        <!--  A card of the dialog: white, a hairline edge, radius 8.  -->
        <Style x:Key="HealthCard" BasedOn="{StaticResource Panel}" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="HealthCardTitle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HealthCardText" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <shell:DialogFrame BodyBackground="{StaticResource BgBrush}"
                       BodyPadding="20,18,20,8"
                       CloseCommand="{Binding CloseDialogCommand}"
                       PanelWidth="720"
                       Title="System health">
        <shell:DialogFrame.Subtitle>
            <TextBlock>
                <Run Text="Checked " /><Run Text="{Binding LastHealthCheckedDisplay, Mode=OneWay}" />
            </TextBlock>
        </shell:DialogFrame.Subtitle>
        <shell:DialogFrame.FooterNote>
            <Button Command="{Binding RefreshHealthCommand}" Content="Check again" />
        </shell:DialogFrame.FooterNote>
        <shell:DialogFrame.Footer>
            <Button Command="{Binding CloseDialogCommand}"
                    Content="Close"
                    shell:Kbd.Hint="Esc"
                    Style="{StaticResource BtnPrimary}" />
        </shell:DialogFrame.Footer>

        <StackPanel>
            <!--  Cloud  -->
            <Border Style="{StaticResource HealthCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12"
                             Height="12"
                             Margin="0,3,12,0"
                             VerticalAlignment="Top"
                             Fill="{Binding Health.CloudDot, Converter={StaticResource DotToBrushConverter}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource HealthCardTitle}" Text="Cloud" />
                        <TextBlock Style="{StaticResource HealthCardText}" Text="{Binding Health.CloudTooltip}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource ToneChip}"
                            Tag="{Binding Health.CloudDot}">
                        <TextBlock Style="{StaticResource ToneChipText}"
                                   Tag="{Binding Health.CloudDot}"
                                   Text="{Binding Health.CloudDot, Converter={StaticResource DotToStatusWord}}" />
                    </Border>
                </Grid>
            </Border>

            <!--  Database  -->
            <Border Style="{StaticResource HealthCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12"
                             Height="12"
                             Margin="0,3,12,0"
                             VerticalAlignment="Top"
                             Fill="{Binding Health.DatabaseDot, Converter={StaticResource DotToBrushConverter}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource HealthCardTitle}" Text="Database" />
                        <TextBlock Style="{StaticResource HealthCardText}" Text="{Binding Health.DatabaseTooltip}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource ToneChip}"
                            Tag="{Binding Health.DatabaseDot}">
                        <TextBlock Style="{StaticResource ToneChipText}"
                                   Tag="{Binding Health.DatabaseDot}"
                                   Text="{Binding Health.DatabaseDot, Converter={StaticResource DotToStatusWord}}" />
                    </Border>
                </Grid>
            </Border>

            <!--  Tally  -->
            <Border Style="{StaticResource HealthCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="12"
                             Height="12"
                             Margin="0,3,12,0"
                             VerticalAlignment="Top"
                             Fill="{Binding Health.TallyDot, Converter={StaticResource DotToBrushConverter}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource HealthCardTitle}" Text="Tally" />
                        <TextBlock Style="{StaticResource HealthCardText}" Text="{Binding Health.TallyTooltip}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            VerticalAlignment="Top"
                            Style="{StaticResource ToneChip}"
                            Tag="{Binding Health.TallyDot}">
                        <TextBlock Style="{StaticResource ToneChipText}"
                                   Tag="{Binding Health.TallyDot}"
                                   Text="{Binding Health.TallyDot, Converter={StaticResource DotToStatusWord}}" />
                    </Border>
                </Grid>
            </Border>

            <!--  Master data: the four cached Tally lists  -->
            <Border Margin="0,0,0,12" Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid Margin="18,14,18,14">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource HealthCardTitle}" Text="Master data" />
                            <Border Margin="10,0,0,0"
                                    Style="{StaticResource ToneChip}"
                                    Tag="{Binding LastHealthSnapshot.Masters.OverallStatus, Converter={StaticResource FreshnessTone}}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="{x:Type Ellipse}">
                                                <Setter Property="Fill" Value="{StaticResource InkDisabledBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="ok">
                                                        <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="warn">
                                                        <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="err">
                                                        <Setter Property="Fill" Value="{StaticResource ErrBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource ToneChipText}"
                                               Tag="{Binding LastHealthSnapshot.Masters.OverallStatus, Converter={StaticResource FreshnessTone}}"
                                               Text="{Binding LastHealthSnapshot.Masters.OverallStatus, Converter={StaticResource MastersOverallLabel}, FallbackValue='Not checked'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding RefreshAllMastersCommand}"
                                Content="Refresh all from Tally"
                                Style="{StaticResource BtnSm}" />
                    </Grid>
                    <TextBlock Margin="18,-4,18,14" Text="{Binding MastersRefreshMessage}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource TxtHint}" TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="18,-4,18,14" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MastersRefreshMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MastersRefreshMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>


                    <!--  The table: a grey heading band, then one row per list  -->
                    <Border Padding="18,0"
                            Background="{StaticResource BgSunkenBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,1">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource TableHeaderText}" Text="Master" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TableHeaderText}" Text="Status" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TableHeaderText}" Text="Items" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource TableHeaderText}" Text="Fetched" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LastHealthSnapshot.Masters.Masters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="36"
                                        Padding="18,0"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding MasterType, Converter={StaticResource MasterTypeLabel}}" />
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource ToneChipText}"
                                                   Tag="{Binding Freshness, Converter={StaticResource FreshnessTone}}"
                                                   Text="{Binding Freshness, Converter={StaticResource FreshnessLabel}}" />
                                        <TextBlock Grid.Column="2"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ItemCount}" />
                                        <TextBlock Grid.Column="3"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   Text="{Binding FetchedAtUtc, Converter={StaticResource UtcToLocal}, StringFormat='{}{0:HH:mm:ss}', FallbackValue='never', TargetNullValue='never'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </shell:DialogFrame>
</UserControl>
