<UserControl x:Class="ShowroomBilling.Desktop.Views.SystemHealthDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="HealthSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="HealthCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushTok}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="RowMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#61152238">
        <Border Style="{StaticResource Panel}"
                Width="560"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Opacity="0.22" ShadowDepth="6" Color="#0F172A" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Border Grid.Row="0"
                        Padding="14,10"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="System Health" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InkMutedBrush}"
                                       FontSize="11">
                                <Run Text="Checked " /><Run Text="{Binding LastHealthCheckedDisplay, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Style="{StaticResource BtnGhost}"
                                Width="28"
                                Height="24"
                                Padding="0"
                                ToolTip="Close (Esc)"
                                Command="{Binding CloseDialogCommand}"
                                Content="✕" />
                    </Grid>
                </Border>

                <!--  Body  -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!--  Cloud API  -->
                        <Border Style="{StaticResource HealthCard}">
                            <StackPanel>
                                <TextBlock Text="CLOUD API" Style="{StaticResource HealthSectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding Health.CloudDot, Converter={StaticResource DotToBrushConverter}}" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding Health.CloudTooltip}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Tally  -->
                        <Border Style="{StaticResource HealthCard}">
                            <StackPanel>
                                <TextBlock Text="TALLY" Style="{StaticResource HealthSectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding Health.TallyDot, Converter={StaticResource DotToBrushConverter}}" />
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding Health.TallyTooltip}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Master Data  -->
                        <Border Style="{StaticResource HealthCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="MASTER DATA" Style="{StaticResource HealthSectionHeader}" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource BtnGhost}"
                                            Command="{Binding RefreshAllMastersCommand}"
                                            Content="Refresh all from Tally" />
                                </Grid>
                                <TextBlock Margin="0,0,0,6" Style="{StaticResource RowMuted}">
                                    <Run Text="Overall: " /><Run Text="{Binding LastHealthSnapshot.Masters.OverallStatus, Mode=OneWay, FallbackValue=unknown}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Margin="0,0,0,6"
                                           Style="{StaticResource RowMuted}"
                                           Text="{Binding MastersRefreshMessage}" />
                                <ItemsControl ItemsSource="{Binding LastHealthSnapshot.Masters.Masters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="12" Text="{Binding MasterType}" />
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold"
                                                           Text="{Binding Freshness}" />
                                                <TextBlock Grid.Column="2" Margin="10,0,0,0"
                                                           Style="{StaticResource RowMuted}">
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=" items" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="3"
                                                           Style="{StaticResource RowMuted}"
                                                           Text="{Binding FetchedAtUtc, StringFormat='fetched {0:HH:mm:ss}', FallbackValue='never fetched', TargetNullValue='never fetched'}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!--  Footer  -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgSunkenBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Button Style="{StaticResource BtnBase}"
                                Command="{Binding RefreshHealthCommand}"
                                HorizontalAlignment="Left"
                                Content="Refresh" />
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding CloseDialogCommand}" Content="Close" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
