{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=tally_wrapper;Username=postgres;Password=postgres"
  },
  "Database": {
    "AutoMigrateOnStartup": false
  },
  "DeviceAuth": {
    "Mode": "LocalFile",
    "TrustedNetworks": []
  },
  "Logging": {
    "File": {
      "Enabled": true,
      "RetentionDays": 30,
      "FileSizeLimitMB": 20,
      "MinLevel": "Information"
    }
  },
  "AllowedHosts": "*"
}
