<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0</Version>
    <UserSecretsId>ShowroomBilling-Api-Foundation</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShowroomBilling.Application\ShowroomBilling.Application.csproj" />
    <ProjectReference Include="..\ShowroomBilling.Contracts\ShowroomBilling.Contracts.csproj" />
    <ProjectReference Include="..\ShowroomBilling.Infrastructure\ShowroomBilling.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup Condition="'$(ShowroomBillingExcludeAppSettings)' == 'true'">
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real environment files are local/private and may contain DB credentials.
         dotnet run loads them from the project content root; do not copy them
         into bin/test output folders where they are easy to zip accidentally. -->
    <Content Update="appsettings.Development.json;appsettings.Production.json"
             CopyToOutputDirectory="Never"
             CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
