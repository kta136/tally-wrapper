{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ShowroomBilling.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/ShowroomBilling.Api/ShowroomBilling.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-desktop",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/ShowroomBilling.Desktop/ShowroomBilling.Desktop.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
